@inherits ComponentBase
@layout _EmptyLayout

<div client-theme="true" class="giz-state-screen giz-state-screen--page">
    <div class="giz-state-screen__body">
        <i class="ph-bold ph-compass giz-state-screen__icon"></i>
        <h1 class="giz-state-screen__title">@Title</h1>
        <p class="giz-state-screen__text">@Text</p>
        <div class="giz-state-screen__actions">
            <button type="button" class="giz-state-screen__action" @onclick="GoHome">
                <i class="ph-bold ph-house-simple"></i>
                <span>@Action</span>
            </button>
        </div>
    </div>
</div>
