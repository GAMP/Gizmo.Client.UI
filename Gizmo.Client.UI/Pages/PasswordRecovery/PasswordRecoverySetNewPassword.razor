@namespace Gizmo.Client.UI.Pages
@inherits CustomDOMComponentBase

<LoginCard Modifier="giz-login-card--steps">
    <CardBody>
        <EditForm EditContext="@PasswordRecoverySetNewPasswordViewService.EditContext" class="giz-signin giz-signin--recovery">
            <div class="giz-signin__intro">
                <h1 class="giz-signin__title">@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_PASSWORD_RECOVERY_NEW_PASSWORD))</h1>
                <p class="giz-signin__lead">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_RECOVERY_NEW_LEAD)</p>
            </div>

            @if (ViewState.HasError)
            {
                <ErrorBlock Message="@ViewState.ErrorMessage" ShowIcon="true" Class="giz-login-error-block giz-signin__error" />
            }

            @if (ViewState.PasswordTooltip.TotalRules > 0)
            {
                <ClientTooltip OpenDirection="TooltipOpenDirections.Left" Class="giz-password-tooltip-root">
                    <ChildContent>
                        <div class="giz-signin__pill">
                            <i class="ph-bold ph-lock-simple giz-signin__glyph"></i>
                            <PasswordInput ShowRevealButton="true"
                                   UpdateOnInput="true"
                                   Value="@ViewState.NewPassword"
                                   ValueChanged="@((string value) => PasswordRecoverySetNewPasswordViewService.SetNewPassword(value))"
                                   ValueExpression="@(() => ViewState.NewPassword)"
                                   IsDisabled="@ViewState.IsLoading"
                                   Size="InputSizes.Medium"
                                   IsFullWidth="true"
                                   Placeholder="@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_ENTER_NEW_PASSWORD))" />
                        </div>
                    </ChildContent>
                    <TooltipContent>
                        <PasswordTooltip PasswordTooltipViewState="@ViewState.PasswordTooltip" />
                    </TooltipContent>
                </ClientTooltip>
            }
            else
            {
                <div class="giz-signin__pill">
                            <i class="ph-bold ph-lock-simple giz-signin__glyph"></i>
                            <PasswordInput ShowRevealButton="true"
                                   UpdateOnInput="true"
                                   Value="@ViewState.NewPassword"
                                   ValueChanged="@((string value) => PasswordRecoverySetNewPasswordViewService.SetNewPassword(value))"
                                   ValueExpression="@(() => ViewState.NewPassword)"
                                   IsDisabled="@ViewState.IsLoading"
                                   Size="InputSizes.Medium"
                                   IsFullWidth="true"
                                   Placeholder="@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_ENTER_NEW_PASSWORD))" />
                        </div>
            }

            <div class="giz-signin__pill">
                <i class="ph-bold ph-lock-simple giz-signin__glyph"></i>
                <PasswordInput ShowRevealButton="false"
                                   UpdateOnInput="true"
                                   Value="@ViewState.RepeatPassword"
                                   ValueChanged="@((string value) => PasswordRecoverySetNewPasswordViewService.SetRepeatPassword(value))"
                                   ValueExpression="@(() => ViewState.RepeatPassword)"
                                   IsDisabled="@ViewState.IsLoading"
                                   Size="InputSizes.Medium"
                                   IsFullWidth="true"
                                   Placeholder="@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_PASSWORD_RECOVERY_REENTER_CONFIRM))" />
                <button type="button" class="giz-signin__go" disabled="@IsSubmitDisabled" aria-label="@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_CONTINUE))" @onclick="@PasswordRecoverySetNewPasswordViewService.SubmitAsync">
                    @if (ViewState.IsLoading)
                    {
                        <span class="giz-loader giz-loader--small"></span>
                    }
                    else
                    {
                        <i class="ph-bold ph-arrow-right"></i>
                    }
                </button>
            </div>
            @if (UserRegisterConfigurationViewState.IsEnabled)
            {
                <div class="giz-signin__links">
                    <div class="giz-signin__new">
                        <span>@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_LOGIN_NOT_A_MEMBER))</span>
                        <a @onclick="OpenRegistration">@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_LOGIN_SIGN_UP_NOW))</a>
                    </div>
                </div>
            }
        </EditForm>
    </CardBody>
    <CardFooter>
        <InputLanguageMenu />
    </CardFooter>
</LoginCard>
