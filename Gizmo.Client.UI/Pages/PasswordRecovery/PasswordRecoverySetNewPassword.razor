@namespace Gizmo.Client.UI.Pages
@inherits CustomDOMComponentBase

<LoginCard>
    <CardHeader>
        <div class="giz-login-links">
            @if (UserRegisterConfigurationViewState.IsEnabled)
            {
                <div class="giz-login-new-user">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_LOGIN_NOT_A_MEMBER)) <a @onclick="UserLoginService.OpenRegistrationAsync">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_LOGIN_SIGN_UP_NOW))</a></div>
            }
        </div>
        <div class="giz-login-alerts"></div>
    </CardHeader>
    <CardBody>
        @if (ViewState.HasError)
        {
            <ErrorBlock Message="@ViewState.ErrorMessage" ShowIcon="true" Class="giz-login-error-block" />
        }
        <EditForm EditContext="@PasswordRecoverySetNewPasswordViewService.EditContext">
            <div class="giz-login-title">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_PASSWORD_RECOVERY_NEW_PASSWORD))</div>
            <div class="giz-login-subtitle">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_PASSWORD_RECOVERY_SET_PASSWORD_MESSAGE))</div>
            <div class="giz-form-input">
                @if (ViewState.PasswordTooltip.TotalRules > 0)
                {
                    <ClientTooltip OpenDirection="TooltipOpenDirections.Left" Class="giz-password-tooltip-root">
                        <ChildContent>
                            <PasswordInput ShowRevealButton="true"
                                           UpdateOnInput="true"
                                           Value="@ViewState.NewPassword"
                                           ValueChanged="@((string value) => PasswordRecoverySetNewPasswordViewService.SetNewPassword(value))"
                                           ValueExpression="@(() => ViewState.NewPassword)"
                                           IsDisabled="@ViewState.IsLoading"
                                           Size="InputSizes.Medium"
                                           IsFullWidth="true"
                                           Label="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_ENTER_NEW_PASSWORD))" />
                        </ChildContent>
                        <TooltipContent>
                            <PasswordTooltip PasswordTooltipViewState="@ViewState.PasswordTooltip" />
                        </TooltipContent>
                    </ClientTooltip>
                }
                else
                {
                    <PasswordInput ShowRevealButton="true"
                                   UpdateOnInput="true"
                                   Value="@ViewState.NewPassword"
                                   ValueChanged="@((string value) => PasswordRecoverySetNewPasswordViewService.SetNewPassword(value))"
                                   ValueExpression="@(() => ViewState.NewPassword)"
                                   IsDisabled="@ViewState.IsLoading"
                                   Size="InputSizes.Medium"
                                   IsFullWidth="true"
                                   Label="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_ENTER_NEW_PASSWORD))" />
                }
            </div>
            <div class="giz-form-input">
                <PasswordInput UpdateOnInput="true"
                               Value="@ViewState.RepeatPassword"
                               ValueChanged="@((string value) => PasswordRecoverySetNewPasswordViewService.SetRepeatPassword(value))"
                               ValueExpression="@(() => ViewState.RepeatPassword)"
                               IsDisabled="@ViewState.IsLoading"
                               Size="InputSizes.Medium"
                               IsFullWidth="true"
                               Label="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_PASSWORD_RECOVERY_REENTER_CONFIRM))" />
            </div>
            <div>
                <Button IsDisabled="@(ViewState.IsValid == false || ViewState.IsLoading)"
                        Color="ButtonColors.Accent"
                        Size="ButtonSizes.ExtraLarge"
                        IsFullWidth="true"
                        @onclick="@PasswordRecoverySetNewPasswordViewService.SubmitAsync">
                    <ChildContent>
                        @if (ViewState.IsLoading)
                        {
                            <Spinner />
                        }
                        else
                        {
                            <div>@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_CONTINUE))</div>
                        }
                    </ChildContent>
                </Button>
            </div>
        </EditForm>
    </CardBody>
    <CardFooter>
        <InputLanguageMenu />
    </CardFooter>
</LoginCard>
