@namespace Gizmo.Client.UI.Pages
@inherits CustomDOMComponentBase

<LoginCard Modifier="giz-login-card--steps">
    <CardBody>
        <div class="giz-signin giz-signin--recovery">
            <button type="button" class="giz-signin__link giz-signin__back" @onclick="BackToDestination">
                <i class="ph-bold ph-arrow-left"></i>
                <span>@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_BACK))</span>
            </button>
            <div class="giz-signin__intro">
                <h1 class="giz-signin__title">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_RECOVERY_HOW_TITLE)</h1>
                <p class="giz-signin__lead">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_RECOVERY_HOW_LEAD)</p>
            </div>
            @if (ViewState.IsLoading)
            {
                <Spinner />
            }
            else
            {
                <VerificationProviderSelector PriorityProviders="@PriorityOptions"
                                               AltProviders="@AltOptions"
                                               HasError="@ViewState.HasError"
                                               ErrorMessage="@ViewState.ErrorMessage"
                                               ShowAll="@ViewState.ShowAllProviders"
                                               ShowHeading="false"
                                               OnSelect="SelectProvider" />
            }
            @if (UserRegisterConfigurationViewState.IsEnabled)
            {
                <div class="giz-signin__links">
                    <div class="giz-signin__new">
                        <span>@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_LOGIN_NOT_A_MEMBER))</span>
                        <a @onclick="OpenRegistration">@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_LOGIN_SIGN_UP_NOW))</a>
                    </div>
                </div>
            }
        </div>
    </CardBody>
    <CardFooter>
        <InputLanguageMenu />
    </CardFooter>
</LoginCard>
