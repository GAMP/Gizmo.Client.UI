@namespace Gizmo.Client.UI.Pages
@inherits CustomDOMComponentBase

<LoginCard>
    <CardHeader>
        <div class="giz-login-links">
            <div class="giz-back-button" @onclick="@(() => NavigationService.NavigateTo(ClientRoutes.LoginRoute))">
                <Icon SVGIcon="Icons.ArrowLeft_Client" Size="IconSizes.ExtraSmall" />
            </div>
            @if (UserRegisterConfigurationViewState.IsEnabled)
            {
                <div class="giz-login-new-user">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_LOGIN_NOT_A_MEMBER)) <a @onclick="UserLoginService.OpenRegistrationAsync">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_LOGIN_SIGN_UP_NOW))</a></div>
            }
        </div>
        <div class="giz-login-alerts">
            @if (ViewState.HasError)
            {
                <Toast CanClose="true" OnCloseButtonClick="OnCloseButtonClickHandler" AlertType="AlertTypes.Danger" Text="@ViewState.ErrorMessage" />
            }
        </div>
    </CardHeader>
    <CardBody>
        <EditForm EditContext="@PasswordRecoveryViewService.EditContext">
            <div class="giz-login-title">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_PASSWORD_RECOVERY_FORGOT_PASSWORD))</div>

            @if (ViewState.AvailableProviders.Count > 1)
            {
                <div>
                    <ButtonGroup Class="giz-login-method" IsMandatory="true" SelectedItemsChanged="@SelectRecoveryProvider" IsDisabled="@ViewState.IsLoading">
                        @foreach (var provider in ViewState.AvailableProviders)
                        {
                            <Button Name="@provider.PublicId.ToString()"
                                    IsSelected="@(ViewState.ActiveProviderPublicId == provider.PublicId)">
                                @GetProviderDisplayName(provider)
                            </Button>
                        }
                    </ButtonGroup>
                </div>
            }

            @if (ViewState.Channel == PasswordRecoveryChannel.Sms)
            {
                <div class="giz-login-subtitle">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_PASSWORD_RECOVERY_ENTER_PHONE_NUMBER))</div>
                <PhoneNumberField SelectedCountryName="@ViewState.Country"
                                  PhoneValue="@ViewState.MobilePhone"
                                  PhoneValueExpression="@(() => ViewState.MobilePhone)"
                                  CountryFieldIdentifier="@GetCountryFieldIdentifier()"
                                  IsDisabled="@ViewState.IsLoading"
                                  Size="InputSizes.Medium"
                                  IsFullWidth="true"
                                  CountryLabel="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_USER_COUNTRY))"
                                  PhoneLabel="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_PHONE_NUMBER))"
                                  SearchPlaceholder="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_SEARCH))"
                                  CountryChanged="@OnCountryChangedAsync"
                                  PhoneValueChanged="@OnPhoneValueChangedAsync" />
            }
            else
            {
                <div class="giz-login-subtitle">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_PASSWORD_RECOVERY_ENTER_EMAIL))</div>
                <div class="giz-form-input">
                    <TextInput UpdateOnInput="true"
                               Value="@ViewState.MatchValue"
                               ValueChanged="@((string value) => PasswordRecoveryViewService.SetMatchValue(value))"
                               ValueExpression="@(() => ViewState.MatchValue)"
                               IsDisabled="@ViewState.IsLoading"
                               Size="InputSizes.Medium"
                               IsFullWidth="true"
                               Label="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_EMAIL_ADDRESS))" />
                </div>
            }

            <div class="giz-resend-button">
                <Button IsDisabled="@(ViewState.IsValid != true || ViewState.IsLoading)"
                        Color="ButtonColors.Accent"
                        Size="ButtonSizes.ExtraLarge"
                        IsFullWidth="true"
                        @onclick="@PasswordRecoveryViewService.SubmitAsync">
                    <ChildContent>
                        @if (ViewState.IsLoading)
                        {
                            <Spinner />
                        }
                        else
                        {
                            <div class="giz-resend-button__label">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_CONTINUE))</div>
                        }
                    </ChildContent>
                </Button>
            </div>
        </EditForm>
    </CardBody>
    <CardFooter>
        <InputLanguageMenu />
    </CardFooter>
</LoginCard>
