@namespace Gizmo.Client.UI.Pages
@inherits CustomDOMComponentBase

<LoginCard>
    <CardHeader>
        <div class="giz-login-links">
            <div class="giz-back-button" @onclick="@(() => NavigationService.NavigateTo(ClientRoutes.PasswordRecoveryDestinationRoute))">
                <Icon SVGIcon="Icons.ArrowLeft_Client" Size="IconSizes.ExtraSmall" />
            </div>
            @if (UserRegisterConfigurationViewState.IsEnabled)
            {
                <div class="giz-login-new-user">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_LOGIN_NOT_A_MEMBER)) <a @onclick="UserLoginService.OpenRegistrationAsync">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_LOGIN_SIGN_UP_NOW))</a></div>
            }
        </div>
        <div class="giz-login-alerts"></div>
    </CardHeader>
    <CardBody>
        @if (ViewState.IsLoading)
        {
            <Spinner />
        }
        else
        {
            <VerificationProviderSelector PriorityProviders="@PriorityOptions"
                                           AltProviders="@AltOptions"
                                           HasError="@ViewState.HasError"
                                           ErrorMessage="@ViewState.ErrorMessage"
                                           ShowAll="@ViewState.ShowAllProviders"
                                           Title="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_PASSWORD_RECOVERY_FORGOT_PASSWORD))"
                                           Subtitle="@(ViewState.HasError ? LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_PASSWORD_RECOVERY_SELECT_OTHER_METHOD)) : LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_PASSWORD_RECOVERY_SELECT_METHOD)))"
                                           OnSelect="SelectProvider" />
        }
    </CardBody>
    <CardFooter>
        <InputLanguageMenu />
    </CardFooter>
</LoginCard>
