@namespace Gizmo.Client.UI.Pages
@inherits CustomDOMComponentBase

<LoginCard>
    <CardHeader>
        <div class="giz-login-links">
            <div class="giz-back-button" @onclick="@(() => NavigationService.NavigateTo(ClientRoutes.PasswordRecoveryRoute))">
                <Icon SVGIcon="Icons.ArrowLeft_Client" Size="IconSizes.ExtraSmall" />
            </div>
        </div>
        <div class="giz-login-alerts">
            @if (ViewState.HasError)
            {
                <Toast CanClose="true" OnCloseButtonClick="OnCloseButtonClickHandler" AlertType="AlertTypes.Danger" Text="@ViewState.ErrorMessage" />
            }
        </div>
    </CardHeader>
    <CardBody>
        <EditForm EditContext="@PasswordRecoveryDestinationViewService.EditContext">
            <div class="giz-login-title">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_PASSWORD_RECOVERY_FORGOT_PASSWORD))</div>

            @if (ViewState.CanUseEmail || ViewState.CanUseMobilePhone)
            {
                <ButtonGroup Class="giz-login-method" IsMandatory="true" SelectedItemsChanged="@SelectIdentifierKind" IsDisabled="@ViewState.IsLoading">
                    <Button Name="@nameof(PasswordRecoveryIdentifierKind.Username)" IsSelected="@(ViewState.IdentifierKind == PasswordRecoveryIdentifierKind.Username)">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_USERNAME))</Button>
                    @if (ViewState.CanUseEmail)
                    {
                        <Button Name="@nameof(PasswordRecoveryIdentifierKind.Email)" IsSelected="@(ViewState.IdentifierKind == PasswordRecoveryIdentifierKind.Email)">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_EMAIL_ADDRESS))</Button>
                    }
                    @if (ViewState.CanUseMobilePhone)
                    {
                        <Button Name="@nameof(PasswordRecoveryIdentifierKind.MobilePhone)" IsSelected="@(ViewState.IdentifierKind == PasswordRecoveryIdentifierKind.MobilePhone)">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_PHONE_NUMBER))</Button>
                    }
                </ButtonGroup>
            }

            @if (ViewState.IdentifierKind == PasswordRecoveryIdentifierKind.MobilePhone)
            {
                <div class="giz-login-subtitle">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_PASSWORD_RECOVERY_ENTER_PHONE_NUMBER))</div>
                <PhoneNumberField SelectedCountryName="@ViewState.Country"
                                  PhoneValue="@ViewState.MobilePhone"
                                  PhoneValueExpression="@(() => ViewState.MobilePhone)"
                                  CountryFieldIdentifier="@GetCountryFieldIdentifier()"
                                  IsDisabled="@ViewState.IsLoading"
                                  Size="InputSizes.Medium"
                                  IsFullWidth="true"
                                  CountryLabel="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_USER_COUNTRY))"
                                  PhoneLabel="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_PHONE_NUMBER))"
                                  SearchPlaceholder="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_SEARCH))"
                                  CountryChanged="@OnCountryChangedAsync"
                                  PhoneValueChanged="@OnPhoneValueChangedAsync" />
            }
            else
            {
                <div class="giz-login-subtitle">@(ViewState.IdentifierKind == PasswordRecoveryIdentifierKind.Email
                    ? LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_PASSWORD_RECOVERY_ENTER_EMAIL))
                    : LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_PASSWORD_RECOVERY_ENTER_USERNAME)))</div>
                <div class="giz-form-input">
                    <TextInput UpdateOnInput="true"
                               Value="@ViewState.MatchValue"
                               ValueChanged="@((string value) => PasswordRecoveryDestinationViewService.SetMatchValue(value))"
                               ValueExpression="@(() => ViewState.MatchValue)"
                               IsDisabled="@ViewState.IsLoading"
                               Size="InputSizes.Medium"
                               IsFullWidth="true"
                               Label="@(ViewState.IdentifierKind == PasswordRecoveryIdentifierKind.Email
                                   ? LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_EMAIL_ADDRESS))
                                   : LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_USERNAME)))" />
                </div>
            }

            <div class="giz-resend-button">
                <Button IsDisabled="@(ViewState.IsValid != true || ViewState.IsLoading)"
                        Color="ButtonColors.Accent"
                        Size="ButtonSizes.ExtraLarge"
                        IsFullWidth="true"
                        @onclick="@PasswordRecoveryDestinationViewService.SubmitAsync">
                    <ChildContent>
                        @if (ViewState.IsLoading)
                        {
                            <Spinner />
                        }
                        else
                        {
                            <div class="giz-resend-button__label">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_CONTINUE))</div>
                        }
                    </ChildContent>
                </Button>
            </div>
        </EditForm>
    </CardBody>
    <CardFooter>
        <InputLanguageMenu />
    </CardFooter>
</LoginCard>
