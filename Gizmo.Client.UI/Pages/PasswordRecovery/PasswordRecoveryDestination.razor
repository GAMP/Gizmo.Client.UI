@namespace Gizmo.Client.UI.Pages
@inherits ShellComponentBase

<LoginCard Modifier="giz-login-card--steps">
    <CardBody>
        <EditForm EditContext="@PasswordRecoveryDestinationViewService.EditContext" class="giz-signin giz-signin--recovery">
            <button type="button" class="giz-signin__link giz-signin__back" @onclick="BackToKind">
                <i class="ph-bold ph-arrow-left"></i>
                <span>@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_BACK))</span>
            </button>
            <div class="giz-signin__intro">
                <h1 class="giz-signin__title">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_RECOVERY_TITLE)</h1>
                <p class="giz-signin__lead">@Lead</p>
            </div>

            @if (ViewState.HasError)
            {
                <ErrorBlock Message="@ErrorText" ShowIcon="true" Class="giz-login-error-block giz-signin__error" />
            }

            @if (IsPhone)
            {
                <div class="giz-signin__pill giz-signin__pill--phone">
                    <PhoneNumberField SelectedCountryName="@ViewState.Country"
                                      PhoneValue="@ViewState.MobilePhone"
                                      PhoneValueExpression="@(() => ViewState.MobilePhone)"
                                      CountryFieldIdentifier="@GetCountryFieldIdentifier()"
                                      IsDisabled="@ViewState.IsLoading"
                                      Size="InputSizes.Medium"
                                      IsFullWidth="true"
                                      RenderWrappers="false"
                                      CanClearCountry="false"
                                      CountryLabel="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_USER_COUNTRY))"
                                      PhoneLabel="@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_RECOVERY_BY_PHONE)"
                                      SearchPlaceholder="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_SEARCH))"
                                      CountryChanged="@OnCountryChangedAsync"
                                      PhoneValueChanged="@OnPhoneValueChangedAsync" />
                <button type="button" class="giz-signin__go" disabled="@IsSubmitDisabled" aria-label="@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_CONTINUE))" @onclick="@PasswordRecoveryDestinationViewService.SubmitAsync">
                    @if (ViewState.IsLoading)
                    {
                        <span class="giz-loader giz-loader--small"></span>
                    }
                    else
                    {
                        <i class="ph-bold ph-arrow-right"></i>
                    }
                </button>
                </div>
            }
            else
            {
                <div class="giz-signin__pill">
                    <i class="@GlyphClass giz-signin__glyph"></i>
                    <TextInput UpdateOnInput="true"
                               Value="@ViewState.MatchValue"
                               ValueChanged="@((string value) => PasswordRecoveryDestinationViewService.SetMatchValue(value))"
                               ValueExpression="@(() => ViewState.MatchValue)"
                               IsDisabled="@ViewState.IsLoading"
                               Size="InputSizes.Medium"
                               IsFullWidth="true"
                               MaxLength="@PasswordRecoveryDestinationViewService.MatchValueMaxLength"
                               Placeholder="@FieldLabel" />
                <button type="button" class="giz-signin__go" disabled="@IsSubmitDisabled" aria-label="@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_CONTINUE))" @onclick="@PasswordRecoveryDestinationViewService.SubmitAsync">
                    @if (ViewState.IsLoading)
                    {
                        <span class="giz-loader giz-loader--small"></span>
                    }
                    else
                    {
                        <i class="ph-bold ph-arrow-right"></i>
                    }
                </button>
                </div>
            }
        </EditForm>
    </CardBody>
    <CardFooter>
        <InputLanguageMenu />
    </CardFooter>
</LoginCard>
