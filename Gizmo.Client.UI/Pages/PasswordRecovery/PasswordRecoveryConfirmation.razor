@namespace Gizmo.Client.UI.Pages
@inherits CustomDOMComponentBase

@if (ViewState.Action == PasswordRecoveryAction.Code)
{
    <LoginCard Modifier="giz-login-card--steps">
        <CardBody>
            <div class="giz-signin giz-signin--code">
                <button type="button" class="giz-signin__link giz-signin__back" @onclick="@Back">
                    <i class="ph-bold ph-arrow-left"></i>
                    <span>@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_BACK))</span>
                </button>

                <div class="giz-signin__intro">
                    <h1 class="giz-signin__title">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_RECOVERY_CODE_TITLE)</h1>
                    <p class="giz-signin__lead">@CodeSubtitle</p>
                </div>

                @if (ViewState.HasError)
                {
                    <ErrorBlock Message="@ViewState.ErrorMessage" ShowIcon="true" Class="giz-login-error-block giz-signin__error" />
                }

                <div class="giz-signin__pill giz-signin__pill--code">
                    <i class="ph-bold ph-key giz-signin__glyph"></i>
                    <CodeBoxes Value="@ViewState.ConfirmationCode"
                               ValueChanged="@OnCodeChanged"
                               Length="@PasswordRecoverySession.CodeLength"
                               IsDisabled="@ViewState.IsLoading"
                               HasError="@ViewState.HasError"
                               Label="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_PASSWORD_RECOVERY_ENTER_YOUR_CODE))"
                               OnSubmit="@ConfirmAsync" />
                    <button type="button" class="giz-signin__go" disabled="@IsConfirmDisabled" aria-label="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_CONFIRM))" @onclick="@ConfirmAsync">
                        @if (ViewState.IsLoading)
                        {
                            <span class="giz-loader giz-loader--small"></span>
                        }
                        else
                        {
                            <i class="ph-bold ph-arrow-right"></i>
                        }
                    </button>
                </div>

                <div class="giz-signin__links">
                    <button type="button" class="giz-signin__link" disabled="@IsResendDisabled" @onclick="@ResendCode">
                        <i class="ph-bold ph-arrow-clockwise"></i>
                        <span>@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_RESEND))</span>
                        @if (!ViewState.TimerExpired)
                        {
                            <b class="giz-signin__timer">@TimerText</b>
                        }
                    </button>
                </div>
            </div>
        </CardBody>
        <CardFooter>
            <InputLanguageMenu />
        </CardFooter>
    </LoginCard>
}
else
{
    <LoginCard>
        <CardHeader>
            <div class="giz-login-links">
                <div class="giz-back-button" @onclick="@(() => NavigationService.NavigateTo(ClientRoutes.PasswordRecoveryRoute))">
                    <Icon SVGIcon="Icons.ArrowLeft_Client" Size="IconSizes.ExtraSmall" />
                </div>
            </div>
            <div class="giz-login-alerts"></div>
        </CardHeader>
        <CardBody>
            @if (ViewState.HasError)
            {
                <ErrorBlock Message="@ViewState.ErrorMessage" ShowIcon="true" Class="giz-login-error-block" />
            }
            @if (ViewState.IsLoading)
            {
                <Spinner />
            }
            else if (ViewState.Action == PasswordRecoveryAction.Redirect && ViewState.RedirectUrl is not null)
            {
                <div class="giz-registration-redirect">
                    <div class="giz-registration-redirect__provider">
                        <div class="giz-registration-redirect__provider-icon @GetProviderIconCssClass()">
                            <Icon SVGIcon="@GetProviderIcon()" />
                        </div>
                        <div class="giz-registration-redirect__provider-text">
                            <div class="giz-registration-redirect__title">
                                @LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_REGISTRATION_REDIRECT_TITLE), GetProviderDisplayName())
                            </div>
                            <div class="giz-registration-redirect__subtitle">
                                @LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_PASSWORD_RECOVERY_FORGOT_PASSWORD))
                            </div>
                        </div>
                    </div>

                    <div class="giz-registration-redirect__info">
                        <span>@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_REGISTRATION_REDIRECT_SCAN_HINT))</span>
                    </div>

                    <div class="giz-registration-redirect__qr-card @(ViewState.IsQrExpired ? "giz-registration-redirect__qr-card--expired" : null)">
                        <div class="giz-registration-redirect__qr-image @(ViewState.IsQrExpired ? "giz-registration-redirect__qr-image--expired" : null)">
                            @if (ViewState.QrCode is not null)
                            {
                                @((MarkupString)ViewState.QrCode)
                            }
                            else
                            {
                                <div class="giz-registration-redirect__url">@ViewState.RedirectUrl</div>
                            }
                            @if (ViewState.IsQrExpired)
                            {
                                <div class="giz-registration-redirect__qr-overlay">
                                    <Icon SVGIcon="Icons.Clock_Client" Size="IconSizes.Medium" Class="giz-registration-redirect__qr-overlay-clock" />
                                    <span>@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_REGISTRATION_REDIRECT_QR_EXPIRED_OVERLAY))</span>
                                </div>
                            }
                        </div>
                        @if (ViewState.IsQrExpired)
                        {
                            <div class="giz-registration-redirect__status giz-registration-redirect__status--expired">
                                <span class="giz-registration-redirect__status-dot giz-registration-redirect__status-dot--expired"></span>
                                <span>@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_REGISTRATION_REDIRECT_QR_EXPIRED))</span>
                            </div>
                        }
                    </div>
                </div>
            }
            else if (ViewState.Action == PasswordRecoveryAction.Call)
            {
                <div class="giz-registration-redirect">
                    <div class="giz-registration-redirect__provider">
                        <div class="giz-registration-redirect__provider-icon @GetProviderIconCssClass()">
                            <Icon SVGIcon="@GetProviderIcon()" />
                        </div>
                        <div class="giz-registration-redirect__provider-text">
                            <div class="giz-registration-redirect__title">
                                @LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_PASSWORD_RECOVERY_CALL_TITLE))
                            </div>
                            <div class="giz-registration-redirect__subtitle">
                                @LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_PASSWORD_RECOVERY_CALL_SUBTITLE))
                            </div>
                        </div>
                    </div>

                    <div class="giz-registration-redirect__info">
                        <Icon SVGIcon="Icons.Info_Client" Size="IconSizes.ExtraSmall" Class="giz-registration-redirect__info-icon" />
                        <span>@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_PASSWORD_RECOVERY_CALL_HINT), ViewState.CallPhoneNumber)</span>
                    </div>

                    <div class="giz-registration-redirect__status">
                        <span class="giz-registration-redirect__status-dot"></span>
                        <span>@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_PASSWORD_RECOVERY_WAITING_CONFIRMATION))</span>
                    </div>
                </div>
            }
        </CardBody>
        <CardFooter>
            <InputLanguageMenu />
        </CardFooter>
    </LoginCard>
}
