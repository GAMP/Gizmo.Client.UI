@namespace Gizmo.Client.UI.Pages
@inherits CustomDOMComponentBase

<LoginCard>
    <CardHeader>
        <div class="giz-login-links">
            <div class="giz-back-button" @onclick="@(() => NavigationService.NavigateTo(ClientRoutes.LoginRoute))">
                <Icon SVGIcon="Icons.ArrowLeft_Client" Size="IconSizes.ExtraSmall" />
            </div>
        </div>
        <div class="giz-login-alerts"></div>
    </CardHeader>
    <CardBody>
        @if (ViewState.IsLoading)
        {
            <Spinner />
        }
        else
        {
            <div class="giz-login-title">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_PASSWORD_RECOVERY_KIND_TITLE))</div>
            <div class="giz-login-subtitle--sign-up">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_PASSWORD_RECOVERY_KIND_SUBTITLE))</div>

            <div class="giz-registration-providers-list">
                <button class="giz-registration-provider-btn" type="button" @onclick="@(() => PasswordRecoveryKindViewService.SelectKind(PasswordRecoveryIdentifierKind.Username))">
                    <Icon SVGIcon="Icons.User" />
                    @LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_USERNAME))
                </button>
                @if (ViewState.CanUseEmail)
                {
                    <button class="giz-registration-provider-btn" type="button" @onclick="@(() => PasswordRecoveryKindViewService.SelectKind(PasswordRecoveryIdentifierKind.Email))">
                        <Icon SVGIcon="Icons.Email" />
                        @LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_EMAIL_ADDRESS))
                    </button>
                }
                @if (ViewState.CanUseMobilePhone)
                {
                    <button class="giz-registration-provider-btn" type="button" @onclick="@(() => PasswordRecoveryKindViewService.SelectKind(PasswordRecoveryIdentifierKind.MobilePhone))">
                        <Icon SVGIcon="Icons.Sms" />
                        @LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_PHONE_NUMBER))
                    </button>
                }
            </div>
        }
    </CardBody>
    <CardFooter>
        <InputLanguageMenu />
    </CardFooter>
</LoginCard>
