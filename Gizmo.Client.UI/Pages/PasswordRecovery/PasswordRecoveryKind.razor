@namespace Gizmo.Client.UI.Pages
@inherits CustomDOMComponentBase

<LoginCard Modifier="giz-login-card--steps">
    <CardBody>
        <div class="giz-signin giz-signin--recovery">
            <button type="button" class="giz-signin__link giz-signin__back" @onclick="BackToSignIn">
                <i class="ph-bold ph-arrow-left"></i>
                <span>@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_RECOVERY_TO_SIGN_IN)</span>
            </button>
            <div class="giz-signin__intro">
                <h1 class="giz-signin__title">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_RECOVERY_TITLE)</h1>
                <p class="giz-signin__lead">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_RECOVERY_KIND_LEAD)</p>
            </div>
            @if (IsHandingOff)
            {
                <Spinner />
            }
            else
            {
                <div class="giz-ways">
                    <button class="giz-way" type="button" @onclick="@(() => PasswordRecoveryKindViewService.SelectKind(PasswordRecoveryIdentifierKind.Username))">
                        <span class="giz-way__icon"><i class="ph-bold ph-user"></i></span>
                        <span class="giz-way__text"><b>@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_RECOVERY_BY_USERNAME)</b></span>
                        <i class="ph-bold ph-arrow-right giz-way__go"></i>
                    </button>
                    <button class="giz-way" type="button" @onclick="@(() => PasswordRecoveryKindViewService.SelectKind(PasswordRecoveryIdentifierKind.MobilePhone))">
                        <span class="giz-way__icon"><i class="ph-bold ph-device-mobile"></i></span>
                        <span class="giz-way__text"><b>@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_RECOVERY_BY_PHONE)</b></span>
                        <i class="ph-bold ph-arrow-right giz-way__go"></i>
                    </button>
                    <button class="giz-way" type="button" @onclick="@(() => PasswordRecoveryKindViewService.SelectKind(PasswordRecoveryIdentifierKind.Email))">
                        <span class="giz-way__icon"><i class="ph-bold ph-envelope-simple"></i></span>
                        <span class="giz-way__text"><b>@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_RECOVERY_BY_EMAIL)</b></span>
                        <i class="ph-bold ph-arrow-right giz-way__go"></i>
                    </button>
                </div>
            }
        </div>
    </CardBody>
    <CardFooter>
        <InputLanguageMenu />
    </CardFooter>
</LoginCard>
