@namespace Gizmo.Client.UI.Pages
@inherits CustomDOMComponentBase
@layout _Layout_Login
@using System.Threading
@using Gizmo.UI;
@using Microsoft.AspNetCore.Components.Forms

@* A reservation is a property of the machine, not of the sign-in form, so its notice is
   a separate tile ABOVE the card rather than inside its header. Inside, it pushed the
   heading down and read as an input error. The stack keeps the pair centred. *@
<div class="giz-login-stack">

    @if (!ViewState.HasLoginError && ReservationMessage is { } reservationMessage)
    {
        <ReservationNotice Time="@HostReservationViewState.Time.GetValueOrDefault().ToShortTimeString()"
                           Message="@reservationMessage" />
    }

    <LoginCard>

    <CardBody>
        @if (ViewState.HasLoginError)
        {
            <ErrorBlock Message="@ViewState.LoginError" ShowIcon="true" Class="giz-login-error-block" />
        }
        @if (!UserLoginOptions.Value.Disabled)
        {
            <div class="giz-login-title">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_LOGIN_SIGN_IN_TITLE))</div>
            <div>
                <ButtonGroup Class="giz-login-method" IsMandatory="true" SelectedItemsChanged="@SelectLoginType" IsDisabled="@(ViewState.IsLogginIn || ViewState.IsLogginOut)">
                    <Button Name="Username" IsSelected="@(ViewState.LoginType == View.UserLoginType.UsernameOrEmail)">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_USERNAME))</Button>
                    <Button Name="Phone" IsSelected="@(ViewState.LoginType == View.UserLoginType.MobilePhone)">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_PHONE_NUMBER))</Button>
                </ButtonGroup>
            </div>
            <EditForm EditContext="@UserLoginService.EditContext" @onkeydown="OnKeyDownHandle">
                @* Keyed on the login type so switching Username <-> Phone
                   remounts this row and replays the entrance animation,
                   rather than swapping the field in place with no motion. *@
                <div class="giz-form-input giz-form-input--swappable" @key="ViewState.LoginType">
                    @if (ViewState.LoginType == View.UserLoginType.UsernameOrEmail)
                    {
                        <TextInput UpdateOnInput="true"
                                   Value="@ViewState.LoginName"
                                   ValueChanged="@((string value) => UserLoginService.SetLoginName(value))"
                                   ValueExpression="@(() => ViewState.LoginName)"
                                   ValidateFunction="@UserLoginService.UsernameCharacterIsValid"
                                   IsDisabled="@(ViewState.IsLogginIn || ViewState.IsLogginOut)"
                                   Size="InputSizes.Medium"
                                   IsFullWidth="true"
                                   Label="@Gizmo.Client.UI.Localization.ShellStringOverrides.Get(LocalizationService, nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_USERNAME))" />
                    }
                    else
                    {
                        @* Country picker instead of the old static "+7": since 3.0.91
                           UserLoginViewService validates Country and assembles the number
                           in E.164 itself, so phone sign-in fails validation without it. *@
                        <PhoneNumberField SelectedCountryName="@ViewState.Country"
                                          PhoneValue="@ViewState.LoginName"
                                          PhoneValueExpression="@(() => ViewState.LoginName)"
                                          CountryFieldIdentifier="@GetCountryFieldIdentifier()"
                                          IsDisabled="@(ViewState.IsLogginIn || ViewState.IsLogginOut)"
                                          Size="InputSizes.Medium"
                                          IsFullWidth="true"
                                          RenderWrappers="false"
                                          CountryLabel="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_USER_COUNTRY))"
                                          PhoneLabel="@Gizmo.Client.UI.Localization.ShellStringOverrides.Get(LocalizationService, nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_PHONE_NUMBER))"
                                          SearchPlaceholder="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_SEARCH))"
                                          CountryChanged="@OnCountryChangedAsync"
                                          PhoneValueChanged="@OnPhoneValueChangedAsync" />
                    }
                </div>
                <div class="giz-form-input">
                    <PasswordInput ShowRevealButton="true"
                                   UpdateOnInput="true" Value="@ViewState.Password"
                                   ValueChanged="@((string value) => UserLoginService.SetPassword(value))"
                                   ValueExpression="@(() => ViewState.Password)"
                                   IsPasswordVisible="@ViewState.IsPasswordVisible"
                                   IsPasswordVisibleChanged="@((bool value) => UserLoginService.SetPasswordVisible(value))"
                                   IsDisabled="@(ViewState.IsLogginIn || ViewState.IsLogginOut)"
                                   Size="InputSizes.Medium"
                                   IsFullWidth="true"
                                   Label="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_PASSWORD))" />
                    @if (ShowPasswordRecovery)
                    {
                        <div class="giz-login-forgot-password">
                            <a tabindex="-1" href="@ClientRoutes.PasswordRecoveryKindRoute">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_LOGIN_FORGOT_YOUR_PASSWORD))</a>
                        </div>
                    }
                </div>

                @if (HostReservationViewState.ReservationNotificationTimeReached || HostReservationViewState.ReservationBlockTimeReached)
                {
                    <div class="giz-form-input">
                        <div class="giz-login-pin-label-wrapper">
                            <div class="giz-login-pin-label">
                                <div>
                                    @LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_RESERVATION_PIN_INPUT_LABEL))
                                </div>
                            </div>
                        </div>
                        @* The code is visible: it is not a password but a one-time code
                           from the reservation confirmation, copied from a phone and
                           checked character by character. Hence no reveal button. *@
                        <PasswordInput UpdateOnInput="true" Value="@ViewState.Pin"
                                       ValueChanged="@((string value) => UserLoginService.SetPin(value))"
                                       ValueExpression="@(() => ViewState.Pin)"
                                       IsDisabled="@(ViewState.IsLogginIn || ViewState.IsLogginOut)"
                                       IsPasswordVisible="true"
                                       ShowRevealButton="false"
                                       Placeholder="@ShellText.Get(ShellText.LOGIN_PIN_PLACEHOLDER)"
                                       Size="InputSizes.Medium"
                                       IsFullWidth="true"
                                       HasOutline="false"
                                       Class="giz-password-input--pin" />
                    </div>
                }

                <div>
                    <Button Color="ButtonColors.Accent" Size="ButtonSizes.ExtraLarge" IsFullWidth="true" Class="giz-login-submit" @onclick="@UserLoginService.LoginAsync">
                        @if (ViewState.IsLogginIn || ViewState.IsLogginOut)
                        {
                            <Spinner />
                        }
                        else
                        {
                            <div class="giz-login-submit__content">
                                <span>@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_CONTINUE))</span>
                                <i class="ph-bold ph-arrow-right"></i>
                            </div>
                        }
                    </Button>
                </div>

                @* Moved inside the card (was a separate element pinned to the
                   header's top-right corner). Still gated on the same
                   registration-enabled config as before. *@
                @if (UserRegisterConfigurationViewState.IsEnabled)
                {
                    <div class="giz-login-new-user">
                        <span>@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_LOGIN_NOT_A_MEMBER))</span>
                        <a @onclick="UserLoginService.OpenRegistrationAsync">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_LOGIN_SIGN_UP_NOW))</a>
                    </div>
                }
            </EditForm>

            @* TODO: stub — social login buttons, no action. Wire up when provider auth flow is available. *@
            @* <LoginSocialButtons /> *@
        }
    </CardBody>
    <CardFooter>
        @* QR login block removed per the design brief. The underlying
           HostQRCodeViewState / HostQrCodeOptions services are untouched, so
           re-adding it later is markup-only. *@
        <InputLanguageMenu />
    </CardFooter>
    </LoginCard>

</div>
