@namespace Gizmo.Client.UI.Pages
@inherits CustomDOMComponentBase
@layout _Layout_Login
@using System.Threading
@using Gizmo.UI;
@using Microsoft.AspNetCore.Components.Forms

<LoginCard>
    <CardHeader>
        <div class="giz-login-links">
            @if (UserRegisterConfigurationViewState.IsEnabled)
            {
                <div class="giz-login-new-user">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_LOGIN_NOT_A_MEMBER)) <a @onclick="UserLoginService.OpenRegistrationAsync">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_LOGIN_SIGN_UP_NOW))</a></div>
            }
        </div>
        <div class="giz-login-alerts">
            @if (ViewState.HasLoginError)
            {
                <Toast CanClose="true" OnCloseButtonClick="OnCloseButtonClickHandler" AlertType="AlertTypes.Danger" Text="@ViewState.LoginError" />
            }
            else
            {
                @if (HostReservationViewState.ReservationBlockTimeReached)
                {
                    <Alert AlertType="AlertTypes.Info"
                           Title="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_LOGIN_RESERVATION_WARNING_TITLE), HostReservationViewState.Time.GetValueOrDefault().ToShortTimeString())"
                           Text="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_HOST_RESERVATION_LOGIN_BLOCK_TIME_REACHED_MESSAGE))" />

                }
                else if (HostReservationViewState.ReservationNotificationTimeReached)
                {
                    <Alert AlertType="AlertTypes.Warning"
                           Title="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_LOGIN_RESERVATION_WARNING_TITLE), HostReservationViewState.Time.GetValueOrDefault().ToShortTimeString())"
                           Text="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_HOST_RESERVATION_LOGIN_NOTIFICATION_TIME_REACHED_MESSAGE))" />
                }
            }
        </div>
    </CardHeader>

    <CardBody>
        @if (!UserLoginOptions.Value.Disabled)
        {
            <div class="giz-login-title">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_LOGIN_SIGN_IN_TITLE))</div>
            <div>
                <ButtonGroup Class="giz-login-method" IsMandatory="true" SelectedItemsChanged="@SelectLoginType" IsDisabled="@(ViewState.IsLogginIn || ViewState.IsLogginOut)">
                    <Button Name="Username" IsSelected="@(ViewState.LoginType == View.UserLoginType.UsernameOrEmail)">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_USERNAME))</Button>
                    <Button Name="Phone" IsSelected="@(ViewState.LoginType == View.UserLoginType.MobilePhone)">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_PHONE_NUMBER))</Button>
                </ButtonGroup>
            </div>
            <EditForm EditContext="@UserLoginService.EditContext" @onkeydown="OnKeyDownHandle">
                @if (ViewState.LoginType == View.UserLoginType.UsernameOrEmail)
                {
                    <div class="giz-form-input">
                        <TextInput UpdateOnInput="true"
                                   Value="@ViewState.LoginName"
                                   ValueChanged="@((string value) => UserLoginService.SetLoginName(value))"
                                   ValueExpression="@(() => ViewState.LoginName)"
                                   ValidateFunction="@UserLoginService.UsernameCharacterIsValid"
                                   IsDisabled="@(ViewState.IsLogginIn || ViewState.IsLogginOut)"
                                   Size="InputSizes.Medium"
                                   IsFullWidth="true"
                                   Label="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_USERNAME))" />
                    </div>
                }
                else
                {
                    <div class="giz-form-input">
                        <PhoneNumberField SelectedCountryName="@ViewState.Country"
                                          PhoneValue="@ViewState.LoginName"
                                          PhoneValueExpression="@(() => ViewState.LoginName)"
                                          CountryFieldIdentifier="@GetCountryFieldIdentifier()"
                                          IsDisabled="@(ViewState.IsLogginIn || ViewState.IsLogginOut)"
                                          Size="InputSizes.Medium"
                                          IsFullWidth="true"
                                          RenderWrappers="false"
                                          CountryLabel="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_USER_COUNTRY))"
                                          PhoneLabel="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_PHONE_NUMBER))"
                                          SearchPlaceholder="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_SEARCH))"
                                          CountryChanged="@OnCountryChangedAsync"
                                          PhoneValueChanged="@OnPhoneValueChangedAsync" />
                    </div>
                }
                <div class="giz-form-input">
                    <PasswordInput ShowRevealButton="true"
                                   UpdateOnInput="true" Value="@ViewState.Password"
                                   ValueChanged="@((string value) => UserLoginService.SetPassword(value))"
                                   ValueExpression="@(() => ViewState.Password)"
                                   IsPasswordVisible="@ViewState.IsPasswordVisible"
                                   IsPasswordVisibleChanged="@((bool value) => UserLoginService.SetPasswordVisible(value))"
                                   IsDisabled="@(ViewState.IsLogginIn || ViewState.IsLogginOut)"
                                   Size="InputSizes.Medium"
                                   IsFullWidth="true"
                                   Label="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_PASSWORD))" />
                    @if (ViewState.IsPasswordRecoveryAvailable)
                    {
                        <div class="giz-login-forgot-password">
                            <a tabindex="-1" href="@ClientRoutes.PasswordRecoveryRoute">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_LOGIN_FORGOT_YOUR_PASSWORD))</a>
                        </div>
                    }
                </div>

                @if (HostReservationViewState.ReservationNotificationTimeReached || HostReservationViewState.ReservationBlockTimeReached)
                {
                    <div class="giz-form-input">
                        <div class="giz-login-pin-label-wrapper">
                            <div class="giz-login-pin-label">
                                <div>
                                    @LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_RESERVATION_PIN_INPUT_LABEL))
                                </div>
                            </div>
                        </div>
                        <PasswordInput UpdateOnInput="true" Value="@ViewState.Pin"
                                       ValueChanged="@((string value) => UserLoginService.SetPin(value))"
                                       ValueExpression="@(() => ViewState.Pin)"
                                       IsDisabled="@(ViewState.IsLogginIn || ViewState.IsLogginOut)"
                                       Size="InputSizes.Medium"
                                       IsFullWidth="true"
                                       HasOutline="false"
                                       Class="giz-password-input--pin" />
                    </div>
                }

                <div>
                    <Button Color="ButtonColors.Accent" LeftSVGIcon="@(!(ViewState.IsLogginIn || ViewState.IsLogginOut) ? Icons.Login_Client : null)" Size="ButtonSizes.ExtraLarge" IsFullWidth="true" @onclick="@UserLoginService.LoginAsync">
                        @if (ViewState.IsLogginIn || ViewState.IsLogginOut)
                        {
                            <Spinner />
                        }
                        else
                        {
                            <div>@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_CONTINUE))</div>
                        }
                    </Button>
                </div>
            </EditForm>

            @* TODO: stub — social login buttons, no action. Wire up when provider auth flow is available. *@
            @* <LoginSocialButtons /> *@
        }

        @if (HostQRCodeViewState.IsEnabled)
        {
            <div class="giz-login-or">
                <span>@LocalizationService.GetString("GIZ_LOGIN_OR")</span>
            </div>
        }

        @if (HostQRCodeViewState.IsEnabled)
        {
            <div class="giz-login-qr">
                <div class="giz-login-qr__text">
                    <div class="giz-login-qr__text__title">
                        @(string.IsNullOrEmpty(HostQrCodeOptions.Value.Title)
                            ? LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_LOGIN_QR_TITLE))
                            : HostQrCodeOptions.Value.Title)
                    </div>
                    <div class="giz-login-qr__text__subtitle">
                        @(string.IsNullOrEmpty(HostQrCodeOptions.Value.Description)
                            ? LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_LOGIN_QR_MESSAGE))
                            : HostQrCodeOptions.Value.Description)
                    </div>
                </div>
                <div class="giz-login-qr__image">
                    @((MarkupString)HostQRCodeViewState.HostQRCode)
                </div>
            </div>
        }
    </CardBody>
    <CardFooter>
        <InputLanguageMenu />
    </CardFooter>
</LoginCard>
