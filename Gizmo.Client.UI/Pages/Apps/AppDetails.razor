@namespace Gizmo.Client.UI.Pages
@inherits CustomDOMComponentBase

<div class="giz-app-page">
    <button type="button" class="giz-app-page__back" @onclick="OnClickBackButtonHandler">
        <i class="ph-bold ph-arrow-left"></i>
        <span>@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_BACK))</span>
    </button>
    <div class="giz-app-page__grid">
        <aside class="giz-app-page__side">
            <div class="giz-app-page__poster">
                <GizImage @key="ViewState.Application" ImageType="Gizmo.UI.ImageType.Application" ImageId="@ViewState.Application?.ImageId" ImageFitType="ImageFitType.Cover">
                    <EmptyResultPlaceholder>
                        <div class="giz-default-image">
                            <GizCoverPlaceholder />
                        </div>
                    </EmptyResultPlaceholder>
                    <ErrorPlaceholder>
                        <div class="giz-default-image">
                            <GizCoverPlaceholder />
                        </div>
                    </ErrorPlaceholder>
                </GizImage>
            </div>
            @if (MainExecutable is { } main)
            {
                <div class="giz-app-page__launch" style="--giz-play-label: '@LaunchLabel'">
                    <UniversalExecutable @key="main.ExecutableId" ExecutableId="@main.ExecutableId" ShowProgressBar="true" />
                </div>
            }
            @if (HasFacts)
            {
                <div class="giz-app-page__facts">
                    @if (PublisherId is int publisherId)
                    {
                        <div class="giz-app-page__fact">
                            <span>@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_APPS_PUBLISHER))</span>
                            <b><AppDetailsAppPublisher @key="publisherId" PublisherId="@publisherId" /></b>
                        </div>
                    }
                    @if (ReleaseDateText is { Length: > 0 } released)
                    {
                        <div class="giz-app-page__fact">
                            <span>@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_APPS_RELEASE_DATE))</span>
                            <b>@released</b>
                        </div>
                    }
                    @if (AddDateText is { Length: > 0 } added)
                    {
                        <div class="giz-app-page__fact">
                            <span>@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_APP_IN_CLUB_SINCE)</span>
                            <b>@added</b>
                        </div>
                    }
                </div>
            }
        </aside>
        <div class="giz-app-page__main giz-scrollbar--v">
            <div class="giz-app-page__head">
                @if (ViewState.Application != null)
                {
                    <AppDetailsAppCategory @key="ViewState.Application.ApplicationCategoryId" ApplicationCategoryId="@ViewState.Application.ApplicationCategoryId" />
                }
                <h1 class="giz-app-page__title">@ViewState.Application?.Title</h1>
            </div>
            @if (HasDescription)
            {
                <p class="giz-app-page__about">@ViewState.Application.Description</p>
            }
            @if (HasMoreExecutables)
            {
                <section class="giz-app-page__section">
                    <h2 class="giz-app-page__caption">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_APP_LAUNCH_SECTION)</h2>
                    <div class="giz-app-page__exes">
                        @foreach (var executable in ViewState.Executables)
                        {
                            <UniversalExecutable @key="executable.ExecutableId" ExecutableId="@executable.ExecutableId" ShowProgressBar="true" ShowExeName="true" />
                        }
                    </div>
                </section>
            }
            @if (_hasMedia)
            {
                <section class="giz-app-page__section">
                    <h2 class="giz-app-page__caption">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_APPS_MEDIA))</h2>
                    <AppDetailsMediaItems ApplicationId="@ApplicationId" @key="ApplicationId" />
                </section>
            }
            @if (_hasLinks)
            {
                <section class="giz-app-page__section">
                    <h2 class="giz-app-page__caption">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_APPS_LINKS))</h2>
                    <AppDetailsLinks ApplicationId="@ApplicationId" @key="ApplicationId" />
                </section>
            }
        </div>
    </div>
</div>
