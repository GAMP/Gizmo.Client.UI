@inherits CustomDOMComponentBase
@using System.Globalization
@using Gizmo.Web.Api.Models

@* Home board.

   Two slots that answer two different questions, and because the questions are
   different they never take each other's room:

     HERO  what is worth looking at. Banners when the club has them, otherwise the
           popular games on a slow rotation with their launch buttons, otherwise the
           popular goods, otherwise a quiet line. It is never the shop list, so
           adding a banner hides nothing.
     TILL  what can I buy. Balance, time packages and a short bar list, always in
           the right column, unaffected by whatever the hero is doing.

   Under the hero, four popular games. The full catalogues live behind the Shop and
   Games routes on the left rail.

   The reservation notice lives in the top bar (TopBarReservation), so it shows on
   every page rather than only here.

   Packages are filtered on DisallowPurchase, which the server computes from the
   availability window, guest and user group restrictions and stock. *@

@* With the ladder or achievements on, the board takes the stage's two rows: the stage
   spans both, the till sits level with the hero and the loyalty summary level with the
   strip; the bar is one click away in the shop. Otherwise the two-column board with the
   bar at the foot of the till, as always. *@
<div class="gg-board @(LoyaltyOn ? "gg-board--split" : null)">

    <div class="gg-stage">

        @* HERO *@
        @if (Hero == HeroKind.Banner && CurrentBanner is { } banner)
        {
            @* News is drawn by the stock AdsCarouselItem - the same component the shell's
               own carousel uses. No markup of our own here on purpose: an item may carry
               its own HTML template, image, button and media, and all of that is its
               normal behaviour. Fitting it to the hero tile is .gg-hero--news's job. *@
            <section class="gg-hero gg-hero--news" aria-label="@ShellText.Get(ShellText.HERO_PROMOS)" @key="@($"b{banner.Id}")">
                <AdsCarouselItem @key="@banner.Id" AdvertisementId="@banner.Id" SimpleMode="true" />
            </section>
        }
        else if (Hero == HeroKind.App && CurrentHeroApp is { } app)
        {
            @* A game cover is tall: it stands as a card on the right over its own blurred
               copy, and the launch buttons are the same UniversalExecutable the launch
               overlay and the dock use, so deployment, progress and personal files behave
               exactly as they do everywhere else. *@
            <section class="gg-hero gg-hero--app" aria-label="@ShellText.Get(ShellText.HERO_POPULAR)" @key="@($"a{app.ApplicationId}")">
                <div class="gg-hero__bg">
                    <GizImage @key="app.ApplicationId" ImageType="Gizmo.UI.ImageType.Application" ImageId="@app.ImageId" ImageFitType="ImageFitType.Cover">
                        <EmptyResultPlaceholder><div class="giz-default-image"></div></EmptyResultPlaceholder>
                        <ErrorPlaceholder><div class="giz-default-image"></div></ErrorPlaceholder>
                    </GizImage>
                </div>
                <div class="gg-hero__scrim"></div>

                <div class="gg-hero__art gg-hero__art--tall">
                    <GizImage @key="app.ApplicationId" ImageType="Gizmo.UI.ImageType.Application" ImageId="@app.ImageId" ImageFitType="ImageFitType.Cover">
                        <EmptyResultPlaceholder>
                            <div class="giz-default-image">
                                <img src="_content/Gizmo.Client.UI/img/no-app-image.svg" alt="" />
                            </div>
                        </EmptyResultPlaceholder>
                        <ErrorPlaceholder>
                            <div class="giz-default-image">
                                <img src="_content/Gizmo.Client.UI/img/broken-image.svg" alt="" />
                            </div>
                        </ErrorPlaceholder>
                    </GizImage>
                </div>

                <div class="gg-hero__body">
                    <div class="gg-hero__kick">@ShellText.Get(ShellText.HERO_POPULAR)</div>
                    <div class="gg-hero__title">@app.Title</div>
                    @{
                        var executables = HeroExecutables(app.ApplicationId);
                    }
                    @* The word on a lone launch button comes in through a CSS variable: the
                       button is the vendor's component, which prints the executable's
                       caption or nothing, and "Counter-Strike 2" under a title that already
                       says so is no invitation. See .gg-hero__exe--play. *@
                    <div class="gg-hero__launch" style="--gg-play-label: '@LaunchLabel'">
                        @foreach (var exe in executables)
                        {
                            var plain = IsPlainLaunch(app, exe, executables.Count);
                            <div class="gg-hero__exe @(plain ? "gg-hero__exe--play" : null)" @key="exe.ExecutableId">
                                <UniversalExecutable ExecutableId="@exe.ExecutableId" ShowProgressBar="true" ShowExeName="@(!plain)" />
                            </div>
                        }
                        @if (!AppDetailsPageViewState.DisableAppDetails)
                        {
                            <button type="button" class="gg-hero__more" @onclick="@(() => OpenApp(app.ApplicationId))">
                                <span>@ShellText.Get(ShellText.GEN_DETAILS)</span><i class="ph-bold ph-arrow-right"></i>
                            </button>
                        }
                    </div>
                </div>
            </section>
        }
        else if (Hero == HeroKind.Product && CurrentHeroProduct is { } featured)
        {
            @* A tall product image in a wide block: the background is the same picture
               blurred and enlarged, with the sharp copy standing as a card on the right,
               so nothing is cropped. *@
            <section class="gg-hero gg-hero--goods" aria-label="@ShellText.Get(ShellText.HERO_POPULAR)" @key="@($"p{featured.Id}")">
                <div class="gg-hero__bg">
                    <GizImage @key="featured.Id" ImageType="Gizmo.UI.ImageType.ProductDefault" ImageId="@featured.DefaultImageId" ImageFitType="ImageFitType.Cover">
                        <EmptyResultPlaceholder><div class="giz-default-image"></div></EmptyResultPlaceholder>
                        <ErrorPlaceholder><div class="giz-default-image"></div></ErrorPlaceholder>
                    </GizImage>
                </div>
                <div class="gg-hero__scrim"></div>

                <div class="gg-hero__art">
                    <GizImage @key="featured.Id" ImageType="Gizmo.UI.ImageType.ProductDefault" ImageId="@featured.DefaultImageId" ImageFitType="ImageFitType.Cover">
                        <EmptyResultPlaceholder>
                            <div class="giz-default-image">
                                <img src="_content/Gizmo.Client.UI/img/no-product-image.svg" alt="" />
                            </div>
                        </EmptyResultPlaceholder>
                        <ErrorPlaceholder>
                            <div class="giz-default-image">
                                <img src="_content/Gizmo.Client.UI/img/broken-image.svg" alt="" />
                            </div>
                        </ErrorPlaceholder>
                    </GizImage>
                </div>

                <div class="gg-hero__body">
                    <div class="gg-hero__kick">@ShellText.Get(ShellText.HERO_POPULAR)</div>
                    <div class="gg-hero__title">@featured.Name</div>
                    <div class="gg-hero__price">@featured.UnitPrice.ToString("C", CultureInfo.CurrentCulture)</div>
                    <button type="button" class="gg-hero__cta" @onclick="@(() => AddToCart(featured.Id))">
                        <i class="ph-bold ph-shopping-bag"></i><span>@ShellText.Get(ShellText.GEN_ADD_TO_CART)</span>
                    </button>
                </div>
            </section>
        }
        else
        {
            <section class="gg-hero gg-hero--empty">
                <div class="gg-hero__empty-note">@ShellText.Get(ShellText.HERO_EMPTY)</div>
            </section>
        }

        @if (SlideCount > 1)
        {
            @* Keyed on the index deliberately: changing slide recreates the block so the
               fill bar restarts, instead of finishing the previous slide's cycle. *@
            <div class="gg-dots" @key="SlideIndex">
                @for (var i = 0; i < SlideCount; i++)
                {
                    <span class="gg-dots__dot @(i == SlideIndex ? "is-on" : null)">
                        @if (i == SlideIndex)
                        {
                            <span class="gg-dots__fill"></span>
                        }
                    </span>
                }
            </div>
        }

        @* POPULAR GAMES *@
        <section class="gg-strip" aria-label="@ShellText.Get(ShellText.HOME_GAMES_SECTION)">
            <div class="gg-cap gg-cap--rule">
                <span>@ShellText.Get(ShellText.POPULAR_APPS)</span>
                <span class="gg-cap__rule"></span>
                <a href="@ClientRoutes.ApplicationsRoute">@ShellText.Get(ShellText.ALL_APPS)</a>
            </div>

            @if (StripApps.Count > 0)
            {
                <div class="gg-strip__row">
                    @* The shared ApplicationCard, so hovering a game still opens
                       its real launch overlay with every executable, exactly as
                       on the Apps page. Only the frame is restyled, in CSS. *@
                    @foreach (var app in StripApps)
                    {
                        <ApplicationCard @key="app.ApplicationId" Application="@app" />
                    }
                </div>
            }
            else
            {
                <div class="gg-empty">@ShellText.Get(ShellText.GEN_EMPTY)</div>
            }
        </section>
    </div>

    @* TILL *@
    <aside class="gg-till" aria-label="@ShellText.Get(ShellText.PURCHASES)">

        @* No top-up button here on purpose: there is already one in the top bar. *@
        <div class="gg-wallet">
            <div class="gg-cap">@ShellText.Get(ShellText.GEN_BALANCE)</div>
            <div class="gg-wallet__row">
                <span class="gg-wallet__sum">@UserBalanceViewState.Balance.ToString("C", CultureInfo.CurrentCulture)</span>
            </div>
        </div>

        <div class="gg-till__sec gg-till__sec--packs">
            <div class="gg-cap gg-cap--rule">
                <span>@ShellText.Get(ShellText.HOME_TIME_PACKAGES)</span>
                <span class="gg-cap__rule"></span>
                <a href="@ClientRoutes.ShopRoute">@ShellText.Get(ShellText.GEN_ALL)</a>
            </div>

            @if (TimeProducts.Any())
            {
                <div class="gg-packs">
                    @foreach (var product in TimeProducts)
                    {
                        @* One thin row: name, price, button. No duration tag on purpose -
                           it is almost always already in the name ("Standard 3 hours"), and
                           as a separate tag it took fifty pixels from the one thing that
                           needed them. The full duration is in the purchase dialog. *@
                        <article class="gg-pack" @key="product.Id">
                            <span class="gg-pack__name" @onclick="@(() => OpenProduct(product.Id))">@product.Name</span>
                            <span class="gg-pack__price">
                                @if (IsPointsOnly(product))
                                {
                                    <span class="gg-pack__pts">@product.UnitPointsPrice.GetValueOrDefault().ToString("N0", CultureInfo.CurrentCulture)<i class="ph-fill ph-coins"></i></span>
                                }
                                else
                                {
                                    @product.UnitPrice.ToString("C", CultureInfo.CurrentCulture)
                                }
                            </span>
                            <button type="button" class="gg-buy"
                                    disabled="@(_buyingProductId.HasValue)"
                                    @onclick="@(() => BuyPackage(product.Id))">
                                @ShellText.Get(_buyingProductId == product.Id ? ShellText.GEN_WORKING : ShellText.GEN_BUY)
                            </button>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="gg-empty gg-empty--small">@ShellText.Get(ShellText.HOME_NO_PACKAGES)</div>
            }
        </div>

        @if (!LoyaltyOn)
        {
        <div class="gg-till__sec gg-till__sec--bar">
            <div class="gg-cap gg-cap--rule">
                <span>@ShellText.Get(ShellText.HOME_BAR)</span>
                <span class="gg-cap__rule"></span>
                <a href="@ClientRoutes.ShopRoute">@ShellText.Get(ShellText.HOME_WHOLE_SHOP)</a>
            </div>

            @if (BarProducts.Count > 0)
            {
                <div class="gg-bar">
                    @foreach (var product in BarProducts)
                    {
                        <div class="gg-bar__row" @key="product.Id" title="@product.Name">
                            <span class="gg-bar__thumb" @onclick="@(() => OpenProduct(product.Id))">
                                <GizImage @key="product.Id" ImageType="Gizmo.UI.ImageType.ProductDefault" ImageId="@product.DefaultImageId" ImageFitType="ImageFitType.Cover">
                                    <EmptyResultPlaceholder>
                                        <div class="giz-default-image">
                                            <img src="_content/Gizmo.Client.UI/img/no-product-image.svg" alt="" />
                                        </div>
                                    </EmptyResultPlaceholder>
                                    <ErrorPlaceholder>
                                        <div class="giz-default-image">
                                            <img src="_content/Gizmo.Client.UI/img/broken-image.svg" alt="" />
                                        </div>
                                    </ErrorPlaceholder>
                                </GizImage>
                            </span>
                            <span class="gg-bar__name" @onclick="@(() => OpenProduct(product.Id))">@product.Name</span>
                            <span class="gg-bar__price">@product.UnitPrice.ToString("C", CultureInfo.CurrentCulture)</span>
                            <button type="button" class="gg-bar__add" title="@ShellText.Get(ShellText.GEN_ADD_TO_CART)"
                                    @onclick="@(() => AddToCart(product.Id))">
                                <i class="ph-bold ph-plus"></i>
                            </button>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="gg-empty gg-empty--small">@ShellText.Get(ShellText.GEN_EMPTY)</div>
            }
        </div>
        }
    </aside>
    @if (LoyaltyOn)
    {
        <LoyaltySummary />
    }

</div>
