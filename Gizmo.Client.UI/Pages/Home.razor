@inherits ShellComponentBase
@using Gizmo.Web.Api.Models

<div class="@BoardClass">

    <div class="giz-home-stage">

        @if (Hero == HeroKind.Banner && CurrentBanner is { } banner)
        {
            <section class="giz-home-hero giz-home-hero--news" aria-label="@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_HERO_PROMOS)" @key="@($"b{banner.Id}")">
                <AdsCarouselItem @key="@banner.Id" AdvertisementId="@banner.Id" SimpleMode="true" />
            </section>
        }
        else if (Hero == HeroKind.App && CurrentHeroApp is { } app)
        {
            <section class="giz-home-hero giz-home-hero--app" aria-label="@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_HERO_POPULAR)" @key="@($"a{app.ApplicationId}")">
                <div class="giz-home-hero__bg">
                    <GizImage @key="app.ApplicationId" ImageType="Gizmo.UI.ImageType.Application" ImageId="@app.ImageId" ImageFitType="ImageFitType.Cover">
                        <EmptyResultPlaceholder><div class="giz-default-image"></div></EmptyResultPlaceholder>
                        <ErrorPlaceholder><div class="giz-default-image"></div></ErrorPlaceholder>
                    </GizImage>
                </div>
                <div class="giz-home-hero__scrim"></div>

                <div class="giz-home-hero__art giz-home-hero__art--tall">
                    <GizImage @key="app.ApplicationId" ImageType="Gizmo.UI.ImageType.Application" ImageId="@app.ImageId" ImageFitType="ImageFitType.Cover">
                        <EmptyResultPlaceholder>
                            <div class="giz-default-image">
                                <img src="_content/Gizmo.Client.UI/img/no-app-image.svg" alt="" />
                            </div>
                        </EmptyResultPlaceholder>
                        <ErrorPlaceholder>
                            <div class="giz-default-image">
                                <img src="_content/Gizmo.Client.UI/img/broken-image.svg" alt="" />
                            </div>
                        </ErrorPlaceholder>
                    </GizImage>
                </div>

                <div class="giz-home-hero__body">
                    <div class="giz-home-hero__kick">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_HERO_POPULAR)</div>
                    <div class="giz-home-hero__title">@app.Title</div>
                    <div class="giz-home-hero__launch" style="--giz-play-label: '@LaunchLabel'">
                        @foreach (var exe in HeroExecutables(app.ApplicationId))
                        {
                            <div class="@HeroExeClass(app, exe)" @key="exe.ExecutableId">
                                <UniversalExecutable ExecutableId="@exe.ExecutableId" ShowProgressBar="true" ShowExeName="@(!IsPlainLaunch(app, exe))" />
                            </div>
                        }
                        @if (!AppDetailsPageViewState.DisableAppDetails)
                        {
                            <button type="button" class="giz-home-hero__more" @onclick="@(() => OpenApp(app.ApplicationId))">
                                <span>@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_DETAILS))</span><i class="ph-bold ph-arrow-right"></i>
                            </button>
                        }
                    </div>
                </div>
            </section>
        }
        else if (Hero == HeroKind.Product && CurrentHeroProduct is { } featured)
        {
            <section class="giz-home-hero giz-home-hero--goods" aria-label="@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_HERO_POPULAR)" @key="@($"p{featured.Id}")">
                <div class="giz-home-hero__bg">
                    <GizImage @key="featured.Id" ImageType="Gizmo.UI.ImageType.ProductDefault" ImageId="@featured.DefaultImageId" ImageFitType="ImageFitType.Cover">
                        <EmptyResultPlaceholder><div class="giz-default-image"></div></EmptyResultPlaceholder>
                        <ErrorPlaceholder><div class="giz-default-image"></div></ErrorPlaceholder>
                    </GizImage>
                </div>
                <div class="giz-home-hero__scrim"></div>

                <div class="giz-home-hero__art">
                    <GizImage @key="featured.Id" ImageType="Gizmo.UI.ImageType.ProductDefault" ImageId="@featured.DefaultImageId" ImageFitType="ImageFitType.Cover">
                        <EmptyResultPlaceholder>
                            <div class="giz-default-image">
                                <img src="_content/Gizmo.Client.UI/img/no-product-image.svg" alt="" />
                            </div>
                        </EmptyResultPlaceholder>
                        <ErrorPlaceholder>
                            <div class="giz-default-image">
                                <img src="_content/Gizmo.Client.UI/img/broken-image.svg" alt="" />
                            </div>
                        </ErrorPlaceholder>
                    </GizImage>
                </div>

                <div class="giz-home-hero__body">
                    <div class="giz-home-hero__kick">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_HERO_POPULAR)</div>
                    <div class="giz-home-hero__title">@featured.Name</div>
                    <div class="giz-home-hero__price">
                        @if (IsPointsOnly(featured))
                        {
                            <span class="giz-home-hero__pts">@PointsPrice(featured)<i class="ph-fill ph-coins"></i></span>
                        }
                        else
                        {
                            @Money(featured.UnitPrice)
                        }
                    </div>
                    <button type="button" class="giz-home-hero__cta" @onclick="@(() => AddToCart(featured.Id))">
                        <i class="ph-bold ph-shopping-bag"></i><span>@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_ADD_TO_CART))</span>
                    </button>
                </div>
            </section>
        }
        else
        {
            <section class="giz-home-hero giz-home-hero--empty">
                <div class="giz-home-hero__empty-note">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_HERO_EMPTY)</div>
            </section>
        }

        @if (SlideCount > 1)
        {
            <div class="giz-home-dots" @key="SlideIndex">
                <button type="button" class="giz-home-dots__arrow" title="@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_HERO_PREVIOUS)" @onclick="PreviousSlide" @onclick:stopPropagation="true">
                    <i class="ph-bold ph-caret-left"></i>
                </button>
                @if (ShowSlideDots)
                {
                    @for (var i = 0; i < SlideCount; i++)
                    {
                        <span class="giz-home-dots__dot @(i == SlideIndex ? "giz-home-dots__dot--on" : null)">
                            @if (i == SlideIndex)
                            {
                                <span class="giz-home-dots__fill"></span>
                            }
                        </span>
                    }
                }
                else
                {
                    <span class="giz-home-dots__count">@SlidePositionText</span>
                    <span class="giz-home-dots__dot giz-home-dots__dot--on"><span class="giz-home-dots__fill"></span></span>
                }
                <button type="button" class="giz-home-dots__arrow" title="@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_HERO_NEXT)" @onclick="NextSlide" @onclick:stopPropagation="true">
                    <i class="ph-bold ph-caret-right"></i>
                </button>
            </div>
        }

        <section class="giz-home-strip" aria-label="@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_HOME_GAMES_SECTION)">
            <div class="giz-caption giz-caption--rule">
                <span>@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_POPULAR_APPS))</span>
                <span class="giz-caption__rule"></span>
                <a href="@ClientRoutes.ApplicationsRoute">@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_APP_FILTERS_ALL_APPS))</a>
            </div>

            @if (StripApps.Count > 0)
            {
                <div class="giz-home-strip__row">
                    @foreach (var app in StripApps)
                    {
                        <ApplicationCard @key="app.ApplicationId" Application="@app" />
                    }
                </div>
            }
            else
            {
                <div class="giz-home-empty">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_GEN_EMPTY)</div>
            }
        </section>
    </div>

    @if (HasSales)
    {
        <aside class="giz-home-till" aria-label="@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_USER_PURCHASES))">

            <div class="giz-home-wallet">
                <span class="giz-caption">@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_BALANCE))</span>
                <span class="giz-home-wallet__sum">@Money(UserBalanceViewState.Balance)</span>
                @if (HasPoints)
                {
                    <span class="giz-home-wallet__points"><i class="ph-fill ph-coins"></i>@PointsText</span>
                }
            </div>

            @if (ShowTillTabs)
            {
                <div class="giz-home-tabs" role="tablist">
                    <button type="button" role="tab" class="@TabClass(TillTab.Time)" aria-selected="@(ActiveTab == TillTab.Time)" @onclick="@(() => SelectTab(TillTab.Time))">
                        <i class="ph-bold ph-hourglass-medium"></i>
                        <span>@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_ACCOUNT_TAB_TIME)</span>
                        <em>@Packs.Count</em>
                    </button>
                    <button type="button" role="tab" class="@TabClass(TillTab.Bar)" aria-selected="@(ActiveTab == TillTab.Bar)" @onclick="@(() => SelectTab(TillTab.Bar))">
                        <i class="ph-bold ph-coffee"></i>
                        <span>@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_HOME_BAR)</span>
                        <em>@GoodsCount</em>
                    </button>
                </div>
            }
            else
            {
                <div class="giz-caption giz-caption--rule giz-home-till__cap">
                    <span>@GrafitLocalization.GetString(ActiveTab == TillTab.Time ? GrafitResourceKeys.SHELL_HOME_TIME_PACKAGES : GrafitResourceKeys.SHELL_HOME_BAR)</span>
                    <span class="giz-caption__rule"></span>
                </div>
            }

            @if (ActiveTab == TillTab.Time)
            {
                <div class="giz-home-packs">
                    @foreach (var pack in Packs)
                    {
                        <div class="@PackClass(pack)" @key="pack.Product.Id">
                            <span class="giz-home-pack__icon" @onclick="@(() => OpenProduct(pack.Product.Id))">
                                @if (pack.Length is { } length)
                                {
                                    <b>@length</b><small>@pack.Unit</small>
                                }
                                else
                                {
                                    <i class="ph-bold ph-clock"></i>
                                }
                            </span>
                            <span class="giz-home-pack__text" @onclick="@(() => OpenProduct(pack.Product.Id))">
                                <b>@pack.Product.Name</b>
                                @if (pack.IsBest)
                                {
                                    <em>@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_HOME_BEST_VALUE)</em>
                                }
                            </span>
                            <button type="button" class="giz-home-pack__buy"
                                    disabled="@(_buyingProductId.HasValue)"
                                    @onclick="@(() => BuyPackage(pack.Product.Id))">
                                @if (_buyingProductId == pack.Product.Id)
                                {
                                    @GrafitLocalization.GetString(GrafitResourceKeys.SHELL_GEN_WORKING)
                                }
                                else if (IsPointsOnly(pack.Product))
                                {
                                    <span class="giz-home-pack__pts">@PointsPrice(pack.Product)<i class="ph-fill ph-coins"></i></span>
                                }
                                else
                                {
                                    @ShortMoney(pack.Product.UnitPrice)
                                }
                            </button>
                        </div>
                    }
                </div>
            }
            else
            {
                @if (BarGroups.Count > 1)
                {
                    <div class="giz-home-cats">
                        <button type="button" class="@GroupClass(null)" @onclick="@(() => SelectGroup(null))">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_FILTERS_ALL)</button>
                        @foreach (var group in BarGroups)
                        {
                            <button type="button" class="@GroupClass(group.ProductGroupId)" @key="group.ProductGroupId" @onclick="@(() => SelectGroup(group.ProductGroupId))">@group.Name</button>
                        }
                    </div>
                }

                <div class="giz-home-goods">
                    @foreach (var product in BarGoods)
                    {
                        <div class="@GoodClass(product)" @key="product.Id">
                            <span class="giz-home-good__pic" @onclick="@(() => OpenProduct(product.Id))">
                                <GizImage @key="product.Id" ImageType="Gizmo.UI.ImageType.ProductDefault" ImageId="@product.DefaultImageId" ImageFitType="ImageFitType.Cover">
                                    <EmptyResultPlaceholder>
                                        <div class="giz-default-image">
                                            <img src="_content/Gizmo.Client.UI/img/no-product-image.svg" alt="" />
                                        </div>
                                    </EmptyResultPlaceholder>
                                    <ErrorPlaceholder>
                                        <div class="giz-default-image">
                                            <img src="_content/Gizmo.Client.UI/img/broken-image.svg" alt="" />
                                        </div>
                                    </ErrorPlaceholder>
                                </GizImage>
                            </span>
                            <span class="giz-home-good__body">
                                <b class="giz-home-good__name" title="@product.Name" @onclick="@(() => OpenProduct(product.Id))">@product.Name</b>
                                <span class="giz-home-good__foot">
                                    <span class="giz-home-good__price">
                                        @if (IsPointsOnly(product))
                                        {
                                            <span class="giz-home-good__pts">@PointsPrice(product)<i class="ph-fill ph-coins"></i></span>
                                        }
                                        else
                                        {
                                            @ShortMoney(product.UnitPrice)
                                        }
                                    </span>
                                    @if (CartLine(product.Id) is { Quantity: > 0 } line)
                                    {
                                        <span class="giz-home-good__step">
                                            <button type="button" disabled="@CartBusy" @onclick="@(() => Decrease(line))"><i class="ph-bold ph-minus"></i></button>
                                            <b>@line.Quantity</b>
                                            <button type="button" disabled="@CartBusy" @onclick="@(() => Increase(line))"><i class="ph-bold ph-plus"></i></button>
                                        </span>
                                    }
                                    else
                                    {
                                        <button type="button" class="giz-home-good__add" title="@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_ADD_TO_CART))"
                                                disabled="@CartBusy" @onclick="@(() => AddGood(product.Id))">
                                            <i class="ph-bold ph-plus"></i>
                                        </button>
                                    }
                                </span>
                            </span>
                        </div>
                    }
                </div>
            }

            @if (CartCount > 0)
            {
                <div class="giz-home-cart">
                    <span class="giz-home-cart__icon"><i class="ph-bold ph-shopping-bag"></i><em>@CartCount</em></span>
                    <span class="giz-home-cart__text">
                        <b>
                            @if (ShowCartMoney)
                            {
                                @Money(CartService.ViewState.Total)
                            }
                            @if (CartService.ViewState.PointsTotal > 0)
                            {
                                <span class="giz-home-cart__pts">@CartPointsText<i class="ph-fill ph-coins"></i></span>
                            }
                        </b>
                        <small>@CartSummary</small>
                    </span>
                    <button type="button" class="giz-home-cart__go" disabled="@CartBusy" @onclick="Checkout">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_HOME_CHECKOUT)</button>
                </div>
            }
            else
            {
                <div class="giz-caption giz-caption--rule giz-home-till__foot">
                    <span class="giz-caption__rule"></span>
                    <a href="@ClientRoutes.ShopRoute">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_HOME_WHOLE_SHOP)</a>
                </div>
            }
        </aside>
    }
    else
    {
        <aside class="giz-home-till giz-home-till--pass" aria-label="@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_SIGNUP_CARD)">
            <HomePass />
        </aside>
    }

    @if (ClientFeatures.Ladder)
    {
        <HomeProgress />
    }

</div>
