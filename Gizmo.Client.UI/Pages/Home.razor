@inherits CustomDOMComponentBase
@using System.Globalization
@using Gizmo.Web.Api.Models

@* Home board — «Витрина».

   Two slots that answer two different questions, and because the questions are
   different they never take each other's room:

     ГЕРОЙ  — «на что смотреть». Banners when the club has them, otherwise the
              club's popular GOODS on a slow rotation, otherwise a quiet mark.
              It is never the shop list, so adding a banner hides nothing.
     КАССА  — «что купить». Balance, time packages and a short bar list, always
              in the right column, unaffected by whatever the hero is doing.

   Under the hero, four popular games. Nine pictures on the board in total; the
   full catalogues live behind the Shop and Games routes on the left rail.

   The reservation notice lives in the top bar (TopBarReservation), so it shows
   on every page rather than only here.

   Packages are filtered on DisallowPurchase, which the server computes from the
   availability window, guest and user group restrictions and stock. *@

<div class="gg-board">

    <div class="gg-stage">

        @* ── ГЕРОЙ ──────────────────────────────────────────────────────── *@
        @if (Hero == HeroKind.Banner && CurrentBanner is { } banner)
        {
            @* Новость показывает штатный AdsCarouselItem — тот же компонент, что
               рисует новости в обычной карусели оболочки. Своей вёрстки здесь
               нет намеренно: у новости бывает свой HTML-шаблон, картинка,
               кнопка и медиа, и всё это её штатное поведение. Наше дело —
               только вписать её в плитку героя, чем занимается .gg-hero--news
               в _page-home.scss. *@
            <section class="gg-hero gg-hero--news" aria-label="Акции" @key="@($"b{banner.Id}")">
                <AdsCarouselItem @key="@banner.Id" AdvertisementId="@banner.Id" SimpleMode="true" />
            </section>
        }
        else if (Hero == HeroKind.Product && CurrentHeroProduct is { } featured)
        {
            @* Товар вертикальной картинкой в широком блоке: фон — та же
               картинка, размытая и укрупнённая, а резкая стоит карточкой
               справа. Так ничего не обрезается. *@
            <section class="gg-hero gg-hero--goods" aria-label="Популярное" @key="@($"p{featured.Id}")">
                <div class="gg-hero__bg">
                    <GizImage @key="featured.Id" ImageType="Gizmo.UI.ImageType.ProductDefault" ImageId="@featured.DefaultImageId" ImageFitType="ImageFitType.Cover">
                        <EmptyResultPlaceholder><div class="giz-default-image"></div></EmptyResultPlaceholder>
                        <ErrorPlaceholder><div class="giz-default-image"></div></ErrorPlaceholder>
                    </GizImage>
                </div>
                <div class="gg-hero__scrim"></div>

                <div class="gg-hero__art">
                    <GizImage @key="featured.Id" ImageType="Gizmo.UI.ImageType.ProductDefault" ImageId="@featured.DefaultImageId" ImageFitType="ImageFitType.Cover">
                        <EmptyResultPlaceholder>
                            <div class="giz-default-image">
                                <img src="_content/Gizmo.Client.UI/img/no-product-image.svg" alt="" />
                            </div>
                        </EmptyResultPlaceholder>
                        <ErrorPlaceholder>
                            <div class="giz-default-image">
                                <img src="_content/Gizmo.Client.UI/img/broken-image.svg" alt="" />
                            </div>
                        </ErrorPlaceholder>
                    </GizImage>
                </div>

                <div class="gg-hero__body">
                    <div class="gg-hero__kick">Популярное</div>
                    <div class="gg-hero__title">@featured.Name</div>
                    <div class="gg-hero__price">@featured.UnitPrice.ToString("C", CultureInfo.CurrentCulture)</div>
                    <button type="button" class="gg-hero__cta" @onclick="@(() => AddToCart(featured.Id))">
                        <i class="ph-bold ph-shopping-bag"></i><span>В корзину</span>
                    </button>
                </div>
            </section>
        }
        else
        {
            <section class="gg-hero gg-hero--empty" aria-label="Главная">
                <div class="gg-hero__mark">GRAFIT</div>
                <div class="gg-hero__note">Скоро здесь что-нибудь появится</div>
            </section>
        }

        @if (SlideCount > 1)
        {
            @* @key по индексу нарочно: смена слайда пересоздаёт блок, и полоса
               заполнения стартует заново — иначе анимация досчитывала бы старый
               цикл поверх нового слайда. *@
            <div class="gg-dots" @key="SlideIndex">
                @for (var i = 0; i < SlideCount; i++)
                {
                    <span class="gg-dots__dot @(i == SlideIndex ? "is-on" : null)">
                        @if (i == SlideIndex)
                        {
                            <span class="gg-dots__fill"></span>
                        }
                    </span>
                }
            </div>
        }

        @* ── ПОПУЛЯРНЫЕ ИГРЫ ────────────────────────────────────────────── *@
        <section class="gg-strip" aria-label="Игры и приложения">
            <div class="gg-cap gg-cap--rule">
                <span>Популярные приложения</span>
                <span class="gg-cap__rule"></span>
                <a href="@ClientRoutes.ApplicationsRoute">Все приложения</a>
            </div>

            @if (StripApps.Count > 0)
            {
                <div class="gg-strip__row">
                    @* The shared ApplicationCard, so hovering a game still opens
                       its real launch overlay with every executable, exactly as
                       on the Apps page. Only the frame is restyled, in CSS. *@
                    @foreach (var app in StripApps)
                    {
                        <ApplicationCard @key="app.ApplicationId" Application="@app" />
                    }
                </div>
            }
            else
            {
                <div class="gg-empty">Пока пусто</div>
            }
        </section>
    </div>

    @* ── КАССА ──────────────────────────────────────────────────────────── *@
    <aside class="gg-till" aria-label="Покупки">

        @* Кнопки пополнения тут нет намеренно: она уже стоит в верхней
           панели, и второй такой же кнопкой экран не становится понятнее. *@
        <div class="gg-wallet">
            <div class="gg-cap">На счете</div>
            <div class="gg-wallet__row">
                <span class="gg-wallet__sum">@UserBalanceViewState.Balance.ToString("C", CultureInfo.CurrentCulture)</span>
            </div>
        </div>

        <div class="gg-till__sec gg-till__sec--packs">
            <div class="gg-cap gg-cap--rule">
                <span>Пакеты времени</span>
                <span class="gg-cap__rule"></span>
                <a href="@ClientRoutes.ShopRoute">Все</a>
            </div>

            @if (TimeProducts.Any())
            {
                <div class="gg-packs">
                    @foreach (var product in TimeProducts)
                    {
                        @* Одна тонкая строка: имя, цена, кнопка. Срока тут нет
                           намеренно — он почти всегда уже стоит в самом названии
                           («Standart 3 часа», «5 часов»), а отдельным тегом
                           съедал полсотни пикселей ровно у того, кому их не
                           хватало, — у имени. Полная длительность есть в окне
                           покупки, где место позволяет. *@
                        <article class="gg-pack" @key="product.Id">
                            <span class="gg-pack__name" @onclick="@(() => OpenProduct(product.Id))">@product.Name</span>
                            <span class="gg-pack__price">@product.UnitPrice.ToString("C", CultureInfo.CurrentCulture)</span>
                            <button type="button" class="gg-buy"
                                    disabled="@(_buyingProductId.HasValue)"
                                    @onclick="@(() => BuyPackage(product.Id))">
                                @(_buyingProductId == product.Id ? "Минуту…" : "Купить")
                            </button>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="gg-empty gg-empty--small">Сейчас нет пакетов, доступных к покупке</div>
            }
        </div>

        <div class="gg-till__sec gg-till__sec--bar">
            <div class="gg-cap gg-cap--rule">
                <span>Бар</span>
                <span class="gg-cap__rule"></span>
                <a href="@ClientRoutes.ShopRoute">Весь магазин</a>
            </div>

            @if (BarProducts.Count > 0)
            {
                <div class="gg-bar">
                    @foreach (var product in BarProducts)
                    {
                        <div class="gg-bar__row" @key="product.Id" title="@product.Name">
                            <span class="gg-bar__thumb" @onclick="@(() => OpenProduct(product.Id))">
                                <GizImage @key="product.Id" ImageType="Gizmo.UI.ImageType.ProductDefault" ImageId="@product.DefaultImageId" ImageFitType="ImageFitType.Cover">
                                    <EmptyResultPlaceholder>
                                        <div class="giz-default-image">
                                            <img src="_content/Gizmo.Client.UI/img/no-product-image.svg" alt="" />
                                        </div>
                                    </EmptyResultPlaceholder>
                                    <ErrorPlaceholder>
                                        <div class="giz-default-image">
                                            <img src="_content/Gizmo.Client.UI/img/broken-image.svg" alt="" />
                                        </div>
                                    </ErrorPlaceholder>
                                </GizImage>
                            </span>
                            <span class="gg-bar__name" @onclick="@(() => OpenProduct(product.Id))">@product.Name</span>
                            <span class="gg-bar__price">@product.UnitPrice.ToString("C", CultureInfo.CurrentCulture)</span>
                            <button type="button" class="gg-bar__add" title="В корзину"
                                    @onclick="@(() => AddToCart(product.Id))">
                                <i class="ph-bold ph-plus"></i>
                            </button>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="gg-empty gg-empty--small">Пока пусто</div>
            }
        </div>
    </aside>

</div>
