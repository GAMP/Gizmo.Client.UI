@namespace Gizmo.Client.UI.Pages
@inherits CustomDOMComponentBase

<div class="giz-product-page-wrap">
    <div class="giz-product-page @(CanPurchase ? "giz-product-page--with-cart" : null)">
        <div class="giz-product-page__page giz-scrollbar--v">

            <button type="button" class="giz-product-page__back" @onclick="OnClickBackButtonHandler">
                <i class="ph-bold ph-arrow-left"></i>
                <span>@ShellText.Get(ShellText.GEN_BACK)</span>
            </button>

            @if (Product is not null)
            {
                <section class="giz-product-page__main">
                    <div class="giz-product-page__art @(IsTime ? "giz-product-page__art--time" : null)">
                        <GizImage @key="Product" ImageType="Gizmo.UI.ImageType.ProductDefault" ImageId="@Product.DefaultImageId" ImageFitType="ImageFitType.Cover">
                            <EmptyResultPlaceholder>
                                @if (IsTime)
                                {
                                    <div class="giz-product-page__time">
                                        <b>@ProductHelpers.GetProductTimeNumber(Product)</b>
                                        <span>@ProductHelpers.GetProductTimeText(Product, LocalizationService)</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="giz-product-page__no-art"><i class="ph ph-image"></i></div>
                                }
                            </EmptyResultPlaceholder>
                            <ErrorPlaceholder>
                                <div class="giz-product-page__no-art"><i class="ph ph-image-broken"></i></div>
                            </ErrorPlaceholder>
                        </GizImage>
                    </div>

                    <div class="giz-product-page__info">
                        @if (!string.IsNullOrWhiteSpace(UserProductGroupViewState?.Name))
                        {
                            <div class="giz-caption">@UserProductGroupViewState.Name</div>
                        }
                        <h1 class="giz-product-page__title">@Product.Name</h1>

                        <div class="giz-product-page__price"><ProductCardPrice @key="ProductId" Product="@Product" /></div>

                        @if (CanPurchase)
                        {
                            <div class="giz-product-page__buy">
                                <ProductQuantityPicker @key="ProductId" ProductId="@ProductId" Size="ButtonSizes.ExtraLarge" IsFullWidth="false" />
                                @if (Product.DisallowPurchase && !string.IsNullOrWhiteSpace(Product.DisallowPurchaseReason))
                                {
                                    <div class="giz-product-page__why">
                                        <i class="ph-fill ph-info"></i>
                                        <span>@Product.DisallowPurchaseReason</span>
                                    </div>
                                }
                            </div>
                        }

                        <div class="giz-product-page__facts">
                            @if (IsTime)
                            {
                                <div class="giz-product-page__fact">
                                    <i class="ph ph-desktop"></i>
                                    <div>
                                        <small>@ShellText.Get(ShellText.PD_WHERE)</small>
                                        <ProductTimeHostGroups @key="ProductId" Product="@Product" />
                                    </div>
                                </div>

                                @if (TimeProduct.ExpirationOptions != ProductTimeExpirationOptionType.None)
                                {
                                    <div class="giz-product-page__fact">
                                        <i class="ph ph-hourglass-low"></i>
                                        <div>
                                            <small>@ShellText.Get(ShellText.PRODUCT_EXPIRY)</small>
                                            @if (TimeProduct.ExpirationOptions.HasFlag(ProductTimeExpirationOptionType.ExpireAtDayTime))
                                            {
                                                <b>@ShellText.Get(ShellText.PD_EXPIRES_AT_DAYTIME, ProductHelpers.GetDayTimeFromMinute(TimeProduct.ExpireAtDayTimeMinute))</b>
                                            }
                                            @if (TimeProduct.ExpirationOptions.HasFlag(ProductTimeExpirationOptionType.ExpireAfterTime))
                                            {
                                                <b>@ShellText.Get(ShellText.PD_EXPIRES_AFTER, ProductHelpers.GetExpiresAfterText(TimeProduct, LocalizationService))</b>
                                            }
                                            @if (TimeProduct.ExpirationOptions.HasFlag(ProductTimeExpirationOptionType.ExpiresAtLogout))
                                            {
                                                <b>@ShellText.Get(ShellText.PD_EXPIRES_AT_LOGOUT)</b>
                                            }
                                        </div>
                                    </div>
                                }
                            }

                            @if (Product.PurchaseAvailability is not null)
                            {
                                <div class="giz-product-page__fact">
                                    <i class="ph ph-shopping-cart-simple"></i>
                                    <div>
                                        <small>@ShellText.Get(ShellText.PRODUCT_BUY_WINDOW)</small>
                                        @foreach (var line in ProductHelpers.GetPurchaseAvailabilities(Product, !_showMore, LocalizationService))
                                        {
                                            <b>@line</b>
                                        }
                                    </div>
                                </div>
                            }

                            @if (IsTime && TimeProduct.UsageAvailability is not null)
                            {
                                <div class="giz-product-page__fact">
                                    <i class="ph ph-play-circle"></i>
                                    <div>
                                        <small>@ShellText.Get(ShellText.PRODUCT_USE_WINDOW)</small>
                                        @foreach (var line in ProductHelpers.GetUsageAvailabilities(Product, !_showMore, LocalizationService))
                                        {
                                            <b>@line</b>
                                        }
                                    </div>
                                </div>
                            }

                            @if (HasMoreAvailability)
                            {
                                <button type="button" class="giz-product-page__more" @onclick="ToggleMore">
                                    <span>@ShellText.Get(_showMore ? ShellText.PRODUCT_LESS : ShellText.PRODUCT_MORE)</span>
                                    <i class="ph-bold @(_showMore ? "ph-caret-up" : "ph-caret-down")"></i>
                                </button>
                            }
                        </div>
                    </div>
                </section>

                @if (!string.IsNullOrWhiteSpace(Product.Description))
                {
                    <section class="giz-product-page__about">
                        <div class="giz-caption giz-caption--rule"><span>@ShellText.Get(ShellText.PD_ABOUT)</span><span class="giz-caption__rule"></span></div>
                        <p class="giz-product-page__desc">@Product.Description</p>
                    </section>
                }

                @if (IsBundle && Product.BundledProducts.Any())
                {
                    <section class="giz-product-page__bundle">
                        <div class="giz-caption giz-caption--rule"><span>@ShellText.Get(ShellText.PD_INCLUDES)</span><span class="giz-caption__rule"></span></div>
                        <div class="giz-product-page__bundle-row">
                            @foreach (var bundled in Product.BundledProducts)
                            {
                                <ProductDetailsBundledProduct @key="@bundled" ProductId="@bundled.Id" Quantity="bundled.Quantity" />
                            }
                        </div>
                    </section>
                }

                @if (CanPurchase && ViewState.RelatedProducts != null && ViewState.RelatedProducts.Any())
                {
                    <section class="giz-product-page__related">
                        <div class="giz-caption giz-caption--rule"><span>@ShellText.Get(ShellText.SHOP_RELATED)</span><span class="giz-caption__rule"></span></div>
                        <div class="giz-product-page__related-row">
                            @foreach (var related in ViewState.RelatedProducts)
                            {
                                <ProductCard @key="related.Id" Product="@related" />
                            }
                        </div>
                    </section>
                }
            }
        </div>

        @if (CanPurchase)
        {
            <aside class="giz-product-page__cart">
                <GizOrder />
            </aside>
        }
    </div>
</div>
