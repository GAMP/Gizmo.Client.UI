@namespace Gizmo.Client.UI.Pages.Registration
@inherits CustomDOMComponentBase

<LoginCard>
    <CardHeader>
        <div class="giz-login-links">
            <div class="giz-back-button" @onclick="@(() => NavigationService.NavigateTo(ClientRoutes.RegistrationProvidersRoute))">
                <Icon SVGIcon="Icons.ArrowLeft_Client" Size="IconSizes.ExtraSmall" />
            </div>
            <div class="giz-login-new-user">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_LOGIN_ALREADY_A_MEMBER)) <RegistrationSignInLink>@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_REGISTRATION_SIGN_IN))</RegistrationSignInLink></div>
        </div>
        <div class="giz-login-alerts">
            @if (ViewState.HasError)
            {
                <Toast CanClose="true" OnCloseButtonClick="OnCloseButtonClickHandler" AlertType="AlertTypes.Danger" Text="@ViewState.ErrorMessage" />
            }
        </div>
    </CardHeader>
    <CardBody>
        <EditForm EditContext="@RegistrationPhoneViewService.EditContext">
            <div class="giz-registration-phone">
                <div class="giz-registration-phone__header">
                    <div class="giz-login-title">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_REGISTRATION_SIGN_UP_TITLE))</div>
                    <div class="giz-login-subtitle--sign-up">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_REGISTRATION_MOBILE_CONFIRMATION_MESSAGE))</div>
                </div>
                <div class="giz-registration-phone__fields">
                    <PhoneNumberField SelectedCountryName="@ViewState.Country"
                                      PhoneValue="@ViewState.MobilePhone"
                                      PhoneValueExpression="@(() => ViewState.MobilePhone)"
                                      CountryFieldIdentifier="@GetCountryFieldIdentifier()"
                                      IsDisabled="@ViewState.IsLoading"
                                      Size="InputSizes.Medium"
                                      IsFullWidth="true"
                                      CountryLabel="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_USER_COUNTRY))"
                                      PhoneLabel="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_PHONE_NUMBER))"
                                      SearchPlaceholder="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_SEARCH))"
                                      CountryChanged="@OnCountryChangedAsync"
                                      PhoneValueChanged="@OnPhoneValueChangedAsync" />
                </div>
                <div class="giz-registration-phone__submit">
                    <Button IsDisabled="@(ViewState.IsValid != true || ViewState.IsLoading)"
                            Color="ButtonColors.Accent"
                            Size="ButtonSizes.ExtraLarge"
                            IsFullWidth="true"
                            @onclick="@RegistrationPhoneViewService.SubmitAsync">
                        <ChildContent>
                            @if (ViewState.IsLoading)
                            {
                                <Spinner />
                            }
                            else
                            {
                                <div>@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_USER_CONFIRMATION_SEND_CODE))</div>
                            }
                        </ChildContent>
                    </Button>
                </div>
            </div>
        </EditForm>
    </CardBody>
    <CardFooter>
        <InputLanguageMenu />
    </CardFooter>
</LoginCard>
