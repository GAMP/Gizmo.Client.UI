@namespace Gizmo.Client.UI.Pages.Registration
@inherits CustomDOMComponentBase

<LoginCard Modifier="giz-login-card--steps">
    <CardBody>
        <div class="giz-signin giz-signin--signup">
            <div class="giz-signin__intro">
                <h1 class="giz-signin__title">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_SIGNUP_Q_PHONE)</h1>
            </div>
            @if (ViewState.HasError)
            {
                <ErrorBlock Message="@ViewState.ErrorMessage" ShowIcon="true" Class="giz-login-error-block giz-signin__error" />
            }
            <EditForm EditContext="@RegistrationPhoneViewService.EditContext" @onkeydown="OnKeyDownAsync">
                <div class="giz-signin__pill giz-signin__pill--phone">
                    <PhoneNumberField SelectedCountryName="@ViewState.Country"
                                      PhoneValue="@ViewState.MobilePhone"
                                      PhoneValueExpression="@(() => ViewState.MobilePhone)"
                                      CountryFieldIdentifier="@GetCountryFieldIdentifier()"
                                      IsDisabled="@ViewState.IsLoading"
                                      Size="InputSizes.Medium"
                                      IsFullWidth="true"
                                      RenderWrappers="false"
                                      CanClearCountry="false"
                                      CountryLabel="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_USER_COUNTRY))"
                                      PhoneLabel="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_PHONE_NUMBER))"
                                      SearchPlaceholder="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_SEARCH))"
                                      CountryChanged="@OnCountryChangedAsync"
                                      PhoneValueChanged="@OnPhoneValueChangedAsync" />
                    <SignupGo Label="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_USER_CONFIRMATION_SEND_CODE))"
                              IsBusy="@ViewState.IsLoading"
                              IsDisabled="@(ViewState.IsValid != true)"
                              OnClick="@RegistrationPhoneViewService.SubmitAsync" />
                </div>
            </EditForm>

            @if (PhoneError is { Length: > 0 } phoneError)
            {
                <div class="giz-signin__note giz-signin__note--error">
                    <i class="ph-bold ph-warning-circle"></i>
                    <span>@phoneError</span>
                </div>
            }
        </div>
    </CardBody>
    <CardFooter>
        <InputLanguageMenu />
    </CardFooter>
</LoginCard>
