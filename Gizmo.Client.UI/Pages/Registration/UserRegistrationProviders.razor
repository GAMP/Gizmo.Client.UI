@namespace Gizmo.Client.UI.Pages.Registration
@inherits CustomDOMComponentBase

<LoginCard>
    <CardHeader>
        <div class="giz-login-links">
            <div class="giz-login-new-user">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_LOGIN_ALREADY_A_MEMBER)) <a href="@ClientRoutes.LoginRoute">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_REGISTRATION_SIGN_IN))</a></div>
        </div>
        <div class="giz-login-alerts"></div>
    </CardHeader>
    <CardBody>
        @if (ViewState.IsLoading)
        {
            <Spinner />
        }
        else
        {
            @if (ViewState.HasError)
            {
                <ErrorBlock Message="@ViewState.ErrorMessage" ShowIcon="true" Class="giz-registration-providers-error-block" />
            }

            <div class="giz-login-title">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_REGISTRATION_CREATE_ACCOUNT))</div>
            <div class="giz-login-subtitle--sign-up">
                @if (ViewState.HasError)
                {
                    @LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_REGISTRATION_SELECT_OTHER_METHOD))
                }
                else
                {
                    @LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_REGISTRATION_SELECT_METHOD))
                }
            </div>

            @if (ViewState.PriorityProviders.Count > 0)
            {
                <div class="giz-registration-providers-list">
                    @foreach (var provider in ViewState.PriorityProviders)
                    {
                        var displayName = GetProviderDisplayName(provider.ChannelGuid, provider.Name);
                        <button class="giz-registration-provider-btn @GetProviderCssClass(provider.ChannelGuid)"
                                type="button"
                                @onclick="@(() => SelectProvider(provider.PublicId))">
                            <Icon SVGIcon="@GetProviderIcon(provider.ChannelGuid)" />
                            @LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_REGISTRATION_CONTINUE_WITH), displayName)
                        </button>
                    }
                </div>
            }

            @* @if (ViewState.AltProviders.Count > 0 && (ViewState.HasError || ViewState.PriorityProviders.Count == 0 || ViewState.ShowAllProviders)) *@
                if(true)
            {
                @* @if ((ViewState.HasError || ViewState.ShowAllProviders) && ViewState.PriorityProviders.Count > 0) *@
                    if(true)
                {
                    <div class="giz-registration-providers-divider">
                        <div class="giz-registration-providers-divider__line"></div>
                        <div class="giz-registration-providers-divider__badge">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_REGISTRATION_OTHER_METHODS))</div>
                        <div class="giz-registration-providers-divider__line"></div>
                    </div>

                    <p class="giz-registration-providers-hint">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_REGISTRATION_TRY_ALTERNATIVES))</p>
                }

                <div class="giz-registration-providers-list">
                    @foreach (var provider in ViewState.AltProviders)
                    {
                        var displayName = GetProviderDisplayName(provider.ChannelGuid, provider.Name);
                        <button class="giz-registration-provider-btn @GetProviderCssClass(provider.ChannelGuid)"
                                type="button"
                                @onclick="@(() => SelectProvider(provider.PublicId))">
                            <Icon SVGIcon="@GetProviderIcon(provider.ChannelGuid)" />
                            @LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_REGISTRATION_CONTINUE_WITH), displayName)
                        </button>
                    }
                </div>
            }

            <p class="giz-registration-providers-terms">
                @LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_REGISTRATION_TERMS_PREFIX))<a href="#">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_REGISTRATION_TERMS_OF_USE))</a>@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_REGISTRATION_TERMS_AND))<a href="#">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_REGISTRATION_PRIVACY_POLICY))</a>.
            </p>
        }
    </CardBody>
    <CardFooter>
        <InputLanguageMenu />
    </CardFooter>
</LoginCard>
