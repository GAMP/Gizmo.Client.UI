@namespace Gizmo.Client.UI.Pages.Registration
@inherits CustomDOMComponentBase

<LoginCard Modifier="giz-login-card--steps">
    <CardBody>
        <div class="giz-signin giz-signin--signup">
            <div class="giz-signin__intro">
                <h1 class="giz-signin__title">@LocalizationService.GetString("GIZ_REGISTRATION_ERROR_TITLE")</h1>
            </div>
            <div class="giz-signin__note giz-signin__note--error">
                <i class="ph-bold ph-warning-circle"></i>
                <span>@LocalizationService.GetString("GIZ_REGISTRATION_ERROR_ALERT")</span>
            </div>

            <div class="giz-signin__actions">
                <button type="button" class="giz-signin__button giz-signin__button--primary" @onclick="GoBack">
                    @LocalizationService.GetString("GIZ_REGISTRATION_ERROR_BACK")
                </button>
                <button type="button" class="giz-signin__button" @onclick="TryAgain">
                    @LocalizationService.GetString("GIZ_REGISTRATION_ERROR_RETRY")
                </button>
            </div>
        </div>
    </CardBody>
    <CardFooter>
        <InputLanguageMenu />
    </CardFooter>
</LoginCard>
