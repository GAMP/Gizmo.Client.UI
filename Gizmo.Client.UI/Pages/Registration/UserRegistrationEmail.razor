@namespace Gizmo.Client.UI.Pages.Registration
@inherits ShellComponentBase

<LoginCard Modifier="giz-login-card--steps">
    <CardBody>
        <div class="giz-signin giz-signin--signup">
            <button type="button" class="giz-signin__link giz-signin__back" @onclick="@(() => NavigationService.NavigateTo(ClientRoutes.RegistrationProvidersRoute))">
                <i class="ph-bold ph-arrow-left"></i>
                <span>@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_BACK))</span>
            </button>
            <div class="giz-signin__intro">
                <h1 class="giz-signin__title">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_SIGNUP_Q_EMAIL)</h1>
                <p class="giz-signin__lead">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_SIGNUP_EMAIL_HINT)</p>
            </div>
            @if (ViewState.HasError)
            {
                <ErrorBlock Message="@ViewState.ErrorMessage" ShowIcon="true" Class="giz-login-error-block giz-signin__error" />
            }
            <EditForm EditContext="@RegistrationEmailViewService.EditContext" @onkeydown="OnKeyDownAsync">
                <div class="giz-signin__pill">
                    <i class="ph-bold ph-at giz-signin__glyph"></i>
                    <TextInput @ref="_emailInput"
                               UpdateOnInput="true"
                               Value="@ViewState.Email"
                               ValueChanged="@((string value) => RegistrationEmailViewService.SetEmail(value))"
                               ValueExpression="@(() => ViewState.Email)"
                               IsDisabled="@ViewState.IsLoading"
                               Size="InputSizes.Medium"
                               IsFullWidth="true"
                               Label="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_EMAIL_ADDRESS))" />
                    <SignupGo Label="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_USER_CONFIRMATION_SEND_CODE))"
                              IsBusy="@ViewState.IsLoading"
                              IsDisabled="@(ViewState.IsValid == false)"
                              OnClick="@RegistrationEmailViewService.SubmitAsync" />
                </div>
            </EditForm>
            <div class="giz-signin__links">
                <div class="giz-signin__new">
                    <span>@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_LOGIN_ALREADY_A_MEMBER))</span>
                    <RegistrationSignInLink>@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_REGISTRATION_SIGN_IN))</RegistrationSignInLink>
                </div>
            </div>
        </div>
    </CardBody>
    <CardFooter>
        <InputLanguageMenu />
    </CardFooter>
</LoginCard>
