@namespace Gizmo.Client.UI.Pages.Registration
@inherits CustomDOMComponentBase

<LoginCard Modifier="giz-login-card--steps">
    <CardBody>
        <div class="giz-signin giz-signin--signup">
            <div class="giz-signin__intro">
                <h1 class="giz-signin__title">@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_REGISTRATION_REDIRECT_TITLE), GetProviderDisplayName())</h1>
            </div>
            @if (ViewState.HasError)
            {
                <ErrorBlock Message="@ViewState.ErrorMessage" ShowIcon="true" Class="giz-login-error-block giz-signin__error" />
            }
            @if (ViewState.IsLoading)
            {
                <Spinner />
            }
            else if (!ViewState.HasError && ViewState.RedirectUrl is not null)
            {
                <div class="@QrCardClass">
                    <div class="giz-signin__qr">
                        @if (ViewState.QrCode is not null)
                        {
                            @((MarkupString)ViewState.QrCode)
                        }
                        else
                        {
                            <span class="giz-signin__qr-url">@ViewState.RedirectUrl</span>
                        }
                    </div>
                    <div class="giz-signin__qr-text">
                        <b>@QrTitle</b>
                        <span>@QrText</span>
                    </div>
                </div>

                @if (ViewState.IsQrExpired)
                {
                    <div class="giz-signin__actions">
                        <button type="button" class="giz-signin__button giz-signin__button--primary" @onclick="@RegistrationRedirectViewService.NavigateToProvidersAsync">
                            @LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_REGISTRATION_REDIRECT_BACK_TO_MAIN))
                        </button>
                    </div>
                }
            }
        </div>
    </CardBody>
    <CardFooter>
        <InputLanguageMenu />
    </CardFooter>
</LoginCard>
