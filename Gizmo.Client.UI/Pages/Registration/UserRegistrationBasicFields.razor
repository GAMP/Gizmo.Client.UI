@namespace Gizmo.Client.UI.Pages.Registration
@inherits CustomDOMComponentBase

<LoginCard>
    <CardHeader>
        <div class="giz-login-links">
            @if (RegistrationSession.Flow != RegistrationFlow.None || !string.IsNullOrEmpty(RegistrationSession.Token))
            {
                <div class="giz-back-button" @onclick="@NavigateBackAsync">
                    <Icon SVGIcon="Icons.ArrowLeft_Client" Size="IconSizes.ExtraSmall" />
                </div>
            }
            <div class="giz-login-new-user">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_LOGIN_ALREADY_A_MEMBER)) <RegistrationSignInLink>@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_REGISTRATION_SIGN_IN))</RegistrationSignInLink></div>
        </div>
        <div class="giz-login-alerts">
            @if (ViewState.HasError)
            {
                <Toast CanClose="true" OnCloseButtonClick="OnCloseButtonClickHandler" AlertType="AlertTypes.Danger" Text="@ViewState.ErrorMessage" />
            }
        </div>
    </CardHeader>
    <CardBody>
        <EditForm EditContext="@UserRegistrationBasicFieldsViewService.EditContext">
            <div class="giz-login-title">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_REGISTRATION_SIGN_UP_TITLE))</div>
            <div class="giz-registration-form-input">
                <TextInput UpdateOnInput="true"
                           Value="@ViewState.Username"
                           ValueChanged="@((string value) => UserRegistrationBasicFieldsViewService.SetUsername(value))"
                           ValueExpression="@(() => ViewState.Username)"
                           Size="InputSizes.Small"
                           IsFullWidth="true"
                           Label="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_USERNAME))" />
            </div>
            @if (ShowPassword)
            {
                <div class="giz-registration-form-input giz-form-input-columns">
                    @if (ViewState.PasswordTooltip.TotalRules > 0)
                    {
                        <ClientTooltip OpenDirection="TooltipOpenDirections.Left" Class="giz-password-tooltip-root">
                            <ChildContent>
                                <PasswordInput ShowRevealButton="true"
                                               UpdateOnInput="true"
                                               Value="@ViewState.Password"
                                               ValueChanged="@((string value) => UserRegistrationBasicFieldsViewService.SetPassword(value))"
                                               ValueExpression="@(() => ViewState.Password)"
                                               Size="InputSizes.Small"
                                               IsFullWidth="true"
                                               Label="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_PASSWORD))" />
                            </ChildContent>
                            <TooltipContent>
                                <PasswordTooltip PasswordTooltipViewState="@ViewState.PasswordTooltip" />
                            </TooltipContent>
                        </ClientTooltip>
                    }
                    else
                    {
                        <PasswordInput ShowRevealButton="true"
                                       UpdateOnInput="true"
                                       Value="@ViewState.Password"
                                       ValueChanged="@((string value) => UserRegistrationBasicFieldsViewService.SetPassword(value))"
                                       ValueExpression="@(() => ViewState.Password)"
                                       Size="InputSizes.Small"
                                       IsFullWidth="true"
                                       Label="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_PASSWORD))" />
                    }

                    <PasswordInput UpdateOnInput="true"
                                   Value="@ViewState.RepeatPassword"
                                   ValueChanged="@((string value) => UserRegistrationBasicFieldsViewService.SetRepeatPassword(value))"
                                   ValueExpression="@(() => ViewState.RepeatPassword)"
                                   Size="InputSizes.Small"
                                   IsFullWidth="true"
                                   Label="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_CONFIRM_PASSWORD))" />
                </div>
            }
            @if (ShowFirstName || ShowLastName)
            {
                <div class="giz-registration-form-input giz-form-input-columns">
                    @if (ShowFirstName)
                    {
                        <TextInput Value="@ViewState.FirstName"
                                   ValueChanged="@((string value) => UserRegistrationBasicFieldsViewService.SetFirstName(value))"
                                   ValueExpression="@(() => ViewState.FirstName)"
                                   Size="InputSizes.Small"
                                   IsFullWidth="true"
                                   Label="@FirstNameLabel" />
                    }
                    @if (ShowLastName)
                    {
                        <TextInput Value="@ViewState.LastName"
                                   ValueChanged="@((string value) => UserRegistrationBasicFieldsViewService.SetLastName(value))"
                                   ValueExpression="@(() => ViewState.LastName)"
                                   Size="InputSizes.Small"
                                   IsFullWidth="true"
                                   Label="@LastNameLabel" />
                    }
                </div>
            }
            @if (ShowBirthDate || ShowSex)
            {
                <div class="giz-registration-form-input giz-form-input-columns">
                    @if (ShowBirthDate)
                    {
                        <MaskedDateInput Value="@ViewState.BirthDate"
                                         ValueChanged="@((DateTime? value) => UserRegistrationBasicFieldsViewService.SetBirthDate(value))"
                                         ValueExpression="@(() => ViewState.BirthDate)"
                                         Size="InputSizes.Small"
                                         IsFullWidth="true"
                                         Label="@BirthDateLabel" />
                    }
                    @if (ShowSex)
                    {
                        <Select Value="@ViewState.Sex"
                                ValueChanged="@((Sex value) => UserRegistrationBasicFieldsViewService.SetSex(value))"
                                ValueExpression="@(() => ViewState.Sex)"
                                Size="InputSizes.Small"
                                HandleSVGIcon="Icons.Select_Client"
                                IsFullWidth="true"
                                Label="@SexLabel"
                                OpenDirection="PopupOpenDirections.Cursor"
                                PopupClass="giz-scrollbar--v">
                            <SelectItem Value="@Sex.Unspecified" Text="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_SEX_UNSPECIFIED))" />
                            <SelectItem Value="@Sex.Male" Text="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_SEX_MALE))" />
                            <SelectItem Value="@Sex.Female" Text="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_SEX_FEMALE))" />
                        </Select>
                    }
                </div>
            }
            @if (ShowMobilePhone)
            {
                <div class="giz-registration-form-input">
                    <IconSelect Placeholder="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_SEARCH))"
                                IsVirtualized="false"
                                IsLoading="@(!_phoneCountriesLoaded)"
                                HandleSVGIcon="Icons.Select_Client"
                                TValue="IconSelectCountry"
                                ItemSource="@PhoneCountries"
                                SelectedItem="@GetSelectedPhoneCountry()"
                                SelectedItemChanged="@SetPhoneCountry"
                                Size="InputSizes.Small"
                                IsFullWidth="true"
                                Label="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_USER_COUNTRY))"
                                OpenDirection="PopupOpenDirections.Bottom"
                                MaximumHeight="20.0rem"
                                PopupClass="giz-scrollbar--v" />
                </div>
                <div class="giz-form-input">
                    <MaskedPhoneInput Mask="@GetPhoneMask()"
                                      Prefix="+"
                                      AllowMoreDigits="false"
                                      LockedLength="@GetLockedPrefixLength()"
                                      Value="@ViewState.MobilePhone"
                                      ValueChanged="@((string value) => UserRegistrationBasicFieldsViewService.SetMobilePhone(value))"
                                      ValueExpression="@(() => ViewState.MobilePhone)"
                                      Size="InputSizes.Small"
                                      IsFullWidth="true"
                                      Label="@MobilePhoneLabel" />
                </div>
            }
            @if (ShowEmail)
            {
                <div class="giz-form-input">
                    <TextInput UpdateOnInput="true"
                               Value="@ViewState.Email"
                               ValueChanged="@((string value) => UserRegistrationBasicFieldsViewService.SetEmail(value))"
                               ValueExpression="@(() => ViewState.Email)"
                               Size="InputSizes.Small"
                               IsFullWidth="true"
                               Label="@EmailLabel" />
                </div>
            }
            @if (ShowPhone)
            {
                <div class="giz-form-input">
                    <TextInput UpdateOnInput="true"
                               Value="@ViewState.Phone"
                               ValueChanged="@((string value) => UserRegistrationBasicFieldsViewService.SetPhone(value))"
                               ValueExpression="@(() => ViewState.Phone)"
                               Size="InputSizes.Small"
                               IsFullWidth="true"
                               Label="@PhoneLabel" />
                </div>
            }
            <div>
                <Button IsDisabled="@(ViewState.IsValid != true || ViewState.IsLoading)"
                        Color="ButtonColors.Accent"
                        Size="ButtonSizes.Large"
                        IsFullWidth="true"
                        @onclick="@UserRegistrationBasicFieldsViewService.SubmitAsync">
                    <ChildContent>
                        @if (ViewState.IsLoading)
                        {
                            <Spinner />
                        }
                        else
                        {
                            @if (HasAdditionalFields)
                            {
                                <div>@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_CONTINUE))</div>
                            }
                            else
                            {
                                <div>@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_REGISTRATION_SIGN_UP_BUTTON))</div>
                            }
                        }
                    </ChildContent>
                </Button>
            </div>
        </EditForm>
    </CardBody>
    <CardFooter>
        <InputLanguageMenu />
    </CardFooter>
</LoginCard>
