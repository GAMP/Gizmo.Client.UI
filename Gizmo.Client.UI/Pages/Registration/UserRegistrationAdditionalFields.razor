@namespace Gizmo.Client.UI.Pages.Registration
@inherits CustomDOMComponentBase

<LoginCard Modifier="giz-login-card--steps">
    <CardBody>
        <div class="giz-signin giz-signin--signup">
            <div class="giz-signin__intro">
                <h1 class="giz-signin__title">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_SIGNUP_Q_ADDRESS)</h1>
            </div>
            @if (IsExpired)
            {
                <SignupExpired OnVerifyAgain="@VerifyAgain" />
            }
            else if (ViewState.HasError)
            {
                <ErrorBlock Message="@ViewState.ErrorMessage" ShowIcon="true" Class="giz-login-error-block giz-signin__error" />
            }
            <EditForm EditContext="@UserRegistrationAdditionalFieldsViewService.EditContext" @onkeydown="OnKeyDownAsync">
                @if (ShowCountry)
                {
                    <div class="giz-signin__pill">
                        <i class="ph-bold ph-globe-hemisphere-east giz-signin__glyph"></i>
                            <TextInput Value="@ViewState.Country"
                                       ValueChanged="@((string value) => UserRegistrationAdditionalFieldsViewService.SetCountry(value))"
                                       ValueExpression="@(() => ViewState.Country)"
                                       Size="InputSizes.Medium"
                                       IsFullWidth="true"
                                       MaxLength="45"
                                       Label="@CountryLabel" />
                        @if (!ShowAddress && !ShowCity && !ShowPostCode)
                        {
    <SignupGo Label="@GoLabel" IsFinal="true" IsBusy="@ViewState.IsLoading" OnClick="@SubmitAsync" />
                        }
                    </div>
                }
                @if (ShowAddress)
                {
                    <div class="giz-signin__pill">
                        <i class="ph-bold ph-map-pin giz-signin__glyph"></i>
                            <TextInput Value="@ViewState.Address"
                                       ValueChanged="@((string value) => UserRegistrationAdditionalFieldsViewService.SetAddress(value))"
                                       ValueExpression="@(() => ViewState.Address)"
                                       Size="InputSizes.Medium"
                                       IsFullWidth="true"
                                       MaxLength="255"
                                       Label="@AddressLabel" />
                        @if (!ShowCity && !ShowPostCode)
                        {
    <SignupGo Label="@GoLabel" IsFinal="true" IsBusy="@ViewState.IsLoading" OnClick="@SubmitAsync" />
                        }
                    </div>
                }
                @if (ShowCity)
                {
                    <div class="giz-signin__pill">
                        <i class="ph-bold ph-buildings giz-signin__glyph"></i>
                            <TextInput Value="@ViewState.City"
                                       ValueChanged="@((string value) => UserRegistrationAdditionalFieldsViewService.SetCity(value))"
                                       ValueExpression="@(() => ViewState.City)"
                                       Size="InputSizes.Medium"
                                       IsFullWidth="true"
                                       MaxLength="45"
                                       Label="@CityLabel" />
                        @if (!ShowPostCode)
                        {
    <SignupGo Label="@GoLabel" IsFinal="true" IsBusy="@ViewState.IsLoading" OnClick="@SubmitAsync" />
                        }
                    </div>
                }
                @if (ShowPostCode)
                {
                    <div class="giz-signin__pill">
                        <i class="ph-bold ph-mailbox giz-signin__glyph"></i>
                            <TextInput Value="@ViewState.PostCode"
                                       ValueChanged="@((string value) => UserRegistrationAdditionalFieldsViewService.SetPostCode(value))"
                                       ValueExpression="@(() => ViewState.PostCode)"
                                       Size="InputSizes.Medium"
                                       IsFullWidth="true"
                                       MaxLength="@PostCodeMaxLength"
                                       ValidateFunction="@ValidatePostCodeCharacterAsync"
                                       Label="@PostCodeLabel" />
                        @if (true)
                        {
    <SignupGo Label="@GoLabel" IsFinal="true" IsBusy="@ViewState.IsLoading" OnClick="@SubmitAsync" />
                        }
                    </div>
                }
            </EditForm>
        </div>
    </CardBody>
    <CardFooter>
        <InputLanguageMenu />
    </CardFooter>
</LoginCard>
