@namespace Gizmo.Client.UI.Pages.Registration
@inherits CustomDOMComponentBase

<LoginCard>
    <CardHeader>
        <div class="giz-login-links">
            <div class="giz-back-button" @onclick="@(() => NavigationService.NavigateTo(ClientRoutes.RegistrationBasicFieldsRoute))">
                <Icon SVGIcon="Icons.ArrowLeft_Client" Size="IconSizes.ExtraSmall" />
            </div>
            <div class="giz-login-new-user">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_LOGIN_ALREADY_A_MEMBER)) <a href="@ClientRoutes.LoginRoute">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_REGISTRATION_SIGN_IN))</a></div>
        </div>
        <div class="giz-login-alerts">
            @if (ViewState.HasError)
            {
                <Toast CanClose="true" OnCloseButtonClick="OnCloseButtonClickHandler" AlertType="AlertTypes.Danger" Text="@ViewState.ErrorMessage" />
            }
        </div>
    </CardHeader>
    <CardBody>
        <EditForm EditContext="@UserRegistrationAdditionalFieldsViewService.EditContext">
            <div class="giz-registration-basic">
                <div class="giz-registration-basic__header">
                    <div class="giz-login-title giz-registration-basic__title">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_REGISTRATION_SIGN_UP_TITLE))</div>
                    <div class="giz-login-subtitle--sign-up giz-registration-basic__subtitle">Amet minim mollit non deserunt ullamco est sit aliqua dolor do amet sint. Velit officia consequat duis enim</div>
                </div>

                <div class="giz-registration-basic__fields">
                    <div class="giz-registration-basic__field giz-registration-basic__field--full">
                        <IconSelect Placeholder="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_SEARCH))"
                                    IsVirtualized="false"
                                    IsLoading="@(!_isLoaded)"
                                    CanClearValue="@(GetSelectedCountry() != null)"
                                    OnClickClearValueButton="OnClickClearValueButtonHandler"
                                    HandleSVGIcon="Icons.Select_Client"
                                    TValue="IconSelectCountry"
                                    ItemSource="@Countries"
                                    SelectedItem="@GetSelectedCountry()"
                                    SelectedItemChanged="@SetSelectedCountry"
                                    FieldIdentifier="@GetCountryFieldIdentifier()"
                                    Size="InputSizes.Small"
                                    IsFullWidth="true"
                                    Label="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_USER_COUNTRY_REGION))"
                                    OpenDirection="PopupOpenDirections.Bottom"
                                    MaximumHeight="20.0rem"
                                    PopupClass="giz-scrollbar--v" />
                    </div>

                    <div class="giz-registration-basic__field giz-registration-basic__field--full">
                        <TextInput Value="@ViewState.Address"
                                   ValueChanged="@((string value) => UserRegistrationAdditionalFieldsViewService.SetAddress(value))"
                                   ValueExpression="@(() => ViewState.Address)"
                                   Size="InputSizes.Small"
                                   IsFullWidth="true"
                                   Label="@($"{LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_USER_ADDRESS))} (optional)")" />
                    </div>

                    <div class="giz-registration-basic__field giz-registration-basic__field--full">
                        <TextInput Value="@ViewState.PostCode"
                                   ValueChanged="@((string value) => UserRegistrationAdditionalFieldsViewService.SetPostCode(value))"
                                   ValueExpression="@(() => ViewState.PostCode)"
                                   Size="InputSizes.Small"
                                   IsFullWidth="true"
                                   Label="@($"{LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_USER_POST_CODE))} (optional)")" />
                    </div>
                </div>

                <div class="giz-registration-basic__submit">
                    <Button IsDisabled="@(ViewState.IsValid == false || ViewState.IsLoading)"
                            Color="ButtonColors.Accent"
                            Size="ButtonSizes.Large"
                            IsFullWidth="true"
                            @onclick="@UserRegistrationAdditionalFieldsViewService.SubmitAsync">
                        <ChildContent>
                            @if (ViewState.IsLoading)
                            {
                                <Spinner />
                            }
                            else
                            {
                                <div>@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_REGISTRATION_SIGN_UP_BUTTON))</div>
                            }
                        </ChildContent>
                    </Button>
                </div>
            </div>
        </EditForm>
    </CardBody>
    <CardFooter>
        <InputLanguageMenu />
    </CardFooter>
</LoginCard>
