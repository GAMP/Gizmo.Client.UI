@namespace Gizmo.Client.UI.Pages
@inherits CustomDOMComponentBase

<AccountFrame>
    <div class="giz-account__grid">

        <section class="giz-account-card">
            <div class="giz-account-card__head">
                <i class="ph-fill ph-address-book"></i>
                <h2>@ShellText.Get(ShellText.USER_CONTACT_INFO)</h2>
            </div>
            <div class="giz-account-card__fields">
                <div class="giz-account-field">
                    <small>@ShellText.Get(ShellText.GEN_EMAIL_ADDRESS)</small>
                    @if (string.IsNullOrWhiteSpace(ViewState.Email))
                    {
                        <span class="giz-account-field__empty">@ShellText.Get(ShellText.ACCOUNT_NOT_SET)</span>
                    }
                    else
                    {
                        <b>@ViewState.Email</b>
                    }
                </div>
                <div class="giz-account-field">
                    <small>@ShellText.Get(ShellText.GEN_PHONE)</small>
                    @if (string.IsNullOrWhiteSpace(ViewState.MobilePhone))
                    {
                        <span class="giz-account-field__empty">@ShellText.Get(ShellText.ACCOUNT_NOT_SET)</span>
                    }
                    else
                    {
                        <b>@ViewState.MobilePhone</b>
                    }
                </div>
            </div>
            <p class="giz-account-card__note">@ShellText.Get(ShellText.ACCOUNT_CONTACTS_NOTE)</p>
        </section>

        <section class="giz-account-card">
            <div class="giz-account-card__head">
                <i class="ph-fill ph-shield-check"></i>
                <h2>@ShellText.Get(ShellText.USER_SECURITY)</h2>
            </div>
            <div class="giz-account-card__fields">
                <div class="giz-account-field">
                    <small>@ShellText.Get(ShellText.GEN_PASSWORD)</small>
                    <b class="giz-account-field__secret">••••••••</b>
                </div>
            </div>
            <p class="giz-account-card__note">@ShellText.Get(ShellText.ACCOUNT_PASSWORD_NOTE)</p>
            <div class="giz-account-card__actions">
                <button type="button" class="giz-account-button" @onclick="OnClickChangePasswordButtonHandler">
                    <i class="ph-bold ph-key"></i>
                    <span>@ShellText.Get(ShellText.USER_CHANGE_PASSWORD)</span>
                </button>
            </div>
        </section>

    </div>

    @if (!string.IsNullOrEmpty(ShellVersion.Grafit))
    {
        <div class="giz-account__version">Grafit @ShellVersion.Grafit</div>
    }
</AccountFrame>
