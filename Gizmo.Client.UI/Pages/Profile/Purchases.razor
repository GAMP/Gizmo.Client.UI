@namespace Gizmo.Client.UI.Pages
@inherits CustomDOMComponentBase
@using System.Globalization
@using Gizmo.Client.UI.View.States
@using Gizmo

<AccountFrame>
    <section class="giz-account-card giz-account-card--list">
        <div class="giz-account-card__head">
            <i class="ph-fill ph-receipt"></i>
            <h2>@ShellText.Get(ShellText.PURCHASES_HISTORY)</h2>
            @if (ViewState.PrevCursor != null || ViewState.NextCursor != null)
            {
                <div class="giz-account-pager">
                    <button type="button" class="giz-account-pager__btn" disabled="@(ViewState.PrevCursor == null)" @onclick="PurchasesService.LoadPrevious">
                        <i class="ph-bold ph-arrow-left"></i>
                        <span>@ShellText.Get(ShellText.ACCOUNT_NEWER)</span>
                    </button>
                    <button type="button" class="giz-account-pager__btn" disabled="@(ViewState.NextCursor == null)" @onclick="PurchasesService.LoadNext">
                        <span>@ShellText.Get(ShellText.ACCOUNT_OLDER)</span>
                        <i class="ph-bold ph-arrow-right"></i>
                    </button>
                </div>
            }
        </div>

        @if (!HasOrders)
        {
            <div class="giz-account-card__empty">
                <i class="ph ph-receipt"></i>
                <b>@ShellText.Get(ShellText.ACCOUNT_NO_PURCHASES)</b>
                <span>@ShellText.Get(ShellText.ACCOUNT_NO_PURCHASES_HINT)</span>
            </div>
        }
        else
        {
            <div class="giz-account-orders">
                @foreach (var order in ViewState.Orders)
                {
                    <details class="giz-account-order @StatusClass(order)" @key="order">
                        <summary class="giz-account-order__sum">
                            <div class="giz-account-order__when">
                                <b>@order.OrderDate.ToString("d MMM", CultureInfo.CurrentCulture)</b>
                                <small>@order.OrderDate.ToString("HH:mm", CultureInfo.CurrentCulture)</small>
                            </div>
                            <div class="giz-account-order__what">
                                <b>@order.ProductNames</b>
                                <small>
                                    @if (order.Id > 0)
                                    {
                                        <span class="giz-account-order__fact">@ShellText.Get(ShellText.ACCOUNT_ORDER_NUMBER, order.Id)</span>
                                    }
                                    <span class="giz-account-order__fact">@ShellText.GetPlural(ShellText.BUY_ITEMS_COUNT, order.OrderLines.Count())</span>
                                    @if (!string.IsNullOrWhiteSpace(order.Invoice?.PaymentMethodNames))
                                    {
                                        <span class="giz-account-order__fact">@order.Invoice.PaymentMethodNames</span>
                                    }
                                </small>
                            </div>
                            <div class="giz-account-order__sum-total">
                                @if (order.TotalPrice > 0 || order.TotalPointsPrice == 0)
                                {
                                    <b>@order.TotalPrice.ToString("C", CultureInfo.CurrentCulture)</b>
                                }
                                @if (order.TotalPointsPrice > 0)
                                {
                                    <b class="giz-account-order__pts">@order.TotalPointsPrice.ToString("N0", CultureInfo.CurrentCulture) <i class="ph-fill ph-coins"></i></b>
                                }
                            </div>
                            <div class="giz-account-order__status">
                                <span class="giz-account-tag @StatusClass(order)">@ShellText.Get(StatusKey(order))</span>
                                @if (ShowPaymentStatus(order))
                                {
                                    <span class="giz-account-tag giz-account-tag--off">@ShellText.Get(PaymentKey(order))</span>
                                }
                            </div>
                            <i class="ph-bold ph-caret-down giz-account-order__caret"></i>
                        </summary>

                        <div class="giz-account-order__body">
                            <div class="giz-account-order__lines">
                                @foreach (var line in order.OrderLines)
                                {
                                    <div class="giz-account-order__line">
                                        @if (IsLinkable(line))
                                        {
                                            <a class="giz-account-order__line-name" href="@ProductLink(line)">@line.ProductName</a>
                                        }
                                        else
                                        {
                                            <span class="giz-account-order__line-name">@line.ProductName</span>
                                        }
                                        <span class="giz-account-order__line-qty">@line.Quantity @ShellText.Get(ShellText.GEN_PIECES_ABBR)</span>
                                        <span class="giz-account-order__line-sum">
                                            @if (line.TotalPointsPrice > 0)
                                            {
                                                <span class="giz-account-order__pts">@line.TotalPointsPrice.ToString("N0", CultureInfo.CurrentCulture) <i class="ph-fill ph-coins"></i></span>
                                            }
                                            else
                                            {
                                                @line.TotalPrice.ToString("C", CultureInfo.CurrentCulture)
                                            }
                                        </span>
                                    </div>
                                }
                            </div>
                            @if (order.TotalPointsAward > 0 || !string.IsNullOrWhiteSpace(order.Notes))
                            {
                                <div class="giz-account-order__extra">
                                    @if (order.TotalPointsAward > 0)
                                    {
                                        <span class="giz-account-order__earned">
                                            <i class="ph-fill ph-sparkle"></i>
                                            @ShellText.Get(ShellText.ORDER_EARNED_POINTS) @order.TotalPointsAward.ToString("N0", CultureInfo.CurrentCulture)
                                        </span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(order.Notes))
                                    {
                                        <span class="giz-account-order__note">@ShellText.Get(ShellText.ORDER_NOTE) @order.Notes</span>
                                    }
                                </div>
                            }
                        </div>
                    </details>
                }
            </div>
        }
    </section>
</AccountFrame>
