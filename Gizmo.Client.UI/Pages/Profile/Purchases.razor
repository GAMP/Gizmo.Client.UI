@namespace Gizmo.Client.UI.Pages
@inherits CustomDOMComponentBase
@using System.Globalization
@using Gizmo.Client.UI.View.States
@using Gizmo

@* Purchases tab: orders newest first, one row each, the lines behind a native
   disclosure so a long history stays a list and not a ledger. *@
<AccountFrame>
    <section class="gg-card gg-card--list">
        <div class="gg-card__head">
            <i class="ph-fill ph-receipt"></i>
            <h2>@ShellText.Get(ShellText.PURCHASES_HISTORY)</h2>
            @if (ViewState.PrevCursor != null || ViewState.NextCursor != null)
            {
                <div class="gg-pager">
                    <button type="button" class="gg-pager__btn" disabled="@(ViewState.PrevCursor == null)" @onclick="PurchasesService.LoadPrevious">
                        <i class="ph-bold ph-arrow-left"></i>
                        <span>@ShellText.Get(ShellText.ACCOUNT_NEWER)</span>
                    </button>
                    <button type="button" class="gg-pager__btn" disabled="@(ViewState.NextCursor == null)" @onclick="PurchasesService.LoadNext">
                        <span>@ShellText.Get(ShellText.ACCOUNT_OLDER)</span>
                        <i class="ph-bold ph-arrow-right"></i>
                    </button>
                </div>
            }
        </div>

        @{
            var orders = ViewState.Orders.ToList();
        }

        @if (orders.Count == 0)
        {
            <div class="gg-card__empty">
                <i class="ph ph-receipt"></i>
                <b>@ShellText.Get(ShellText.ACCOUNT_NO_PURCHASES)</b>
                <span>@ShellText.Get(ShellText.ACCOUNT_NO_PURCHASES_HINT)</span>
            </div>
        }
        else
        {
            <div class="gg-orders">
                @foreach (var order in orders)
                {
                    var voided = order.Invoice?.IsVoided == true;
                    var (statusKey, statusClass) = voided
                        ? (ShellText.ORDER_STATUS_VOIDED, "is-off")
                        : order.OrderStatus switch
                        {
                            OrderStatus.Completed => (ShellText.ORDER_STATUS_COMPLETED, "is-good"),
                            OrderStatus.Accepted => (ShellText.ORDER_STATUS_ACCEPTED, "is-on"),
                            OrderStatus.Canceled => (ShellText.ORDER_STATUS_CANCELED, "is-off"),
                            _ => (ShellText.ORDER_STATUS_ON_HOLD, "is-wait"),
                        };
                    var paymentKey = order.Invoice?.PaymentStatus switch
                    {
                        InvoiceStatus.Unpaid => ShellText.INVOICE_UNPAID,
                        InvoiceStatus.PartiallyPaid => ShellText.INVOICE_PARTIALLY_PAID,
                        _ => null,
                    };
                    var lines = order.OrderLines.ToList();

                    @* Keyed by the object: the vendor leaves Id at 0 on every order, and two
                       siblings with one key make Blazor throw on the next re-render. *@
                    <details class="gg-order @statusClass" @key="order">
                        <summary class="gg-order__sum">
                            <div class="gg-order__when">
                                <b>@order.OrderDate.ToString("d MMM", CultureInfo.CurrentCulture)</b>
                                <small>@order.OrderDate.ToString("HH:mm", CultureInfo.CurrentCulture)</small>
                            </div>
                            <div class="gg-order__what">
                                <b>@order.ProductNames</b>
                                <small>
                                    @if (order.Id > 0)
                                    {
                                        <span>@ShellText.Get(ShellText.ACCOUNT_ORDER_NUMBER, order.Id) · </span>
                                    }
                                    @ShellText.GetPlural(ShellText.BUY_ITEMS_COUNT, lines.Count)
                                    @if (!string.IsNullOrWhiteSpace(order.Invoice?.PaymentMethodNames))
                                    {
                                        <span> · @order.Invoice.PaymentMethodNames</span>
                                    }
                                </small>
                            </div>
                            <div class="gg-order__sum-total">
                                @if (order.TotalPrice > 0 || order.TotalPointsPrice == 0)
                                {
                                    <b>@order.TotalPrice.ToString("C", CultureInfo.CurrentCulture)</b>
                                }
                                @if (order.TotalPointsPrice > 0)
                                {
                                    <b class="gg-order__pts">@order.TotalPointsPrice.ToString("N0", CultureInfo.CurrentCulture) <i class="ph-fill ph-coins"></i></b>
                                }
                            </div>
                            <div class="gg-order__status">
                                <span class="gg-tag @statusClass">@ShellText.Get(statusKey)</span>
                                @if (paymentKey is not null && !voided)
                                {
                                    <span class="gg-tag gg-tag--off">@ShellText.Get(paymentKey)</span>
                                }
                            </div>
                            <i class="ph-bold ph-caret-down gg-order__caret"></i>
                        </summary>

                        <div class="gg-order__body">
                            <div class="gg-order__lines">
                                @foreach (var line in lines)
                                {
                                    var linkable = ProductDetailsNavigationEnabled
                                        && line.LineType != LineType.SessionTime
                                        && line.LineType != LineType.FixedTime
                                        && line.ProductId.HasValue;

                                    <div class="gg-order__line">
                                        @if (linkable)
                                        {
                                            <a class="gg-order__line-name" href="@($"{ClientRoutes.ProductDetailsRoute}?ProductId={line.ProductId.Value}")">@line.ProductName</a>
                                        }
                                        else
                                        {
                                            <span class="gg-order__line-name">@line.ProductName</span>
                                        }
                                        <span class="gg-order__line-qty">@line.Quantity @ShellText.Get(ShellText.GEN_PIECES_ABBR)</span>
                                        <span class="gg-order__line-sum">
                                            @if (line.TotalPointsPrice > 0)
                                            {
                                                <span class="gg-order__pts">@line.TotalPointsPrice.ToString("N0", CultureInfo.CurrentCulture) <i class="ph-fill ph-coins"></i></span>
                                            }
                                            else
                                            {
                                                @line.TotalPrice.ToString("C", CultureInfo.CurrentCulture)
                                            }
                                        </span>
                                    </div>
                                }
                            </div>
                            @if (order.TotalPointsAward > 0 || !string.IsNullOrWhiteSpace(order.Notes))
                            {
                                <div class="gg-order__extra">
                                    @if (order.TotalPointsAward > 0)
                                    {
                                        <span class="gg-order__earned">
                                            <i class="ph-fill ph-sparkle"></i>
                                            @ShellText.Get(ShellText.ORDER_EARNED_POINTS) @order.TotalPointsAward.ToString("N0", CultureInfo.CurrentCulture)
                                        </span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(order.Notes))
                                    {
                                        <span class="gg-order__note">@ShellText.Get(ShellText.ORDER_NOTE) @order.Notes</span>
                                    }
                                </div>
                            }
                        </div>
                    </details>
                }
            </div>
        }
    </section>
</AccountFrame>
