<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <CompressionEnabled>false</CompressionEnabled>
    <BuildCompressionFormats></BuildCompressionFormats>
    <PublishCompressionFormats></PublishCompressionFormats>
	</PropertyGroup>

	<!-- The shell's version, the Gizmo release it is built for and the oldest client it
	     starts on. The only place these numbers are written: they end up in the assembly's
	     version info and metadata, and deploy\stage.ps1 reads them from here for the package
	     name and grafit.version.txt. The Profile tab shows GrafitVersion in its corner
	     (Code/ShellVersion.cs). Bump it for every shell release, and GizmoVersion on every
	     vendor merge (the server's own GizmoService.dll carries it). -->
	<PropertyGroup>
		<GrafitVersion>1.3.4</GrafitVersion>
		<GizmoVersion>3.0.95</GizmoVersion>
		<GizmoClientMinVersion>3.0.94 (the ladder, achievements and challenges show from the client release that has them)</GizmoClientMinVersion>
		<Product>Grafit</Product>
		<Description>Grafit skin for the Gizmo client, built for Gizmo $(GizmoVersion).</Description>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<FileVersion>$(GrafitVersion).0</FileVersion>
		<InformationalVersion>$(GrafitVersion) (Gizmo $(GizmoVersion))</InformationalVersion>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
	</PropertyGroup>

	<ItemGroup>
		<AssemblyMetadata Include="GrafitVersion" Value="$(GrafitVersion)" />
		<AssemblyMetadata Include="GizmoVersion" Value="$(GizmoVersion)" />
		<AssemblyMetadata Include="GizmoClientMinVersion" Value="$(GizmoClientMinVersion)" />
	</ItemGroup>

	<ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.6" />
		<ProjectReference Include="..\Submodules\Gizmo.Client.UI.Services\Gizmo.Client.UI.Services\Gizmo.Client.UI.Services.csproj" />
		<ProjectReference Include="..\Submodules\Gizmo.Web.Components\Gizmo.Web.Components.csproj" />
	</ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\notifications.html"></EmbeddedResource>
  </ItemGroup>

	<!-- Grafit's strings, every language inside Gizmo.Client.UI.dll: the client loads no
	     satellite assemblies from a skin folder. GrafitLocalizationService reads them. -->
	<ItemGroup>
		<EmbeddedResource Update="Localization\Resources\GrafitResources.resx" LogicalName="Gizmo.Client.UI.Localization.Resources.GrafitResources.resources" />
		<EmbeddedResource Update="Localization\Resources\GrafitResources.*.resx" WithCulture="false" LogicalName="Gizmo.Client.UI.Localization.Resources.%(Filename).resources" />
	</ItemGroup>

  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <Exec Command="npm install" WorkingDirectory="." />
    <Exec Condition="'$(Configuration)' == 'Debug'" Command="npm run build_dev" WorkingDirectory="." />
    <Exec Condition="'$(Configuration)' == 'Release'" Command="npm run build_prod" WorkingDirectory="." />
  </Target>
  
</Project>
