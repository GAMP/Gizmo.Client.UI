@namespace Gizmo.Client.UI.Components
@inherits CustomDOMComponentBase
@using Gizmo.Client.UI.Services

@* The loyalty summary at the foot of the home board's right column, in the bar's place
   when the club runs the ladder or achievements: the level with its ring, one line on
   where the customer stands, the bar to the next level, the one most useful thing to
   do next, and the way to the Progress tab. On a short screen the next step hides
   (CSS) and the level, the bar and the button remain. *@
@{
    var s = Loyalty.State;
    var level = s.CurrentLevel;
    var emblem = level is null ? null : Loyalty.Image(level.EmblemGuid);
    var action = s.NextAction;
}
<aside class="gg-till gg-till--loyal" aria-label="@ShellText.Get(ShellText.LOYALTY_HOME_CAP)">
    <div class="gg-cap gg-cap--rule">
        <span>@ShellText.Get(ShellText.LOYALTY_HOME_CAP)</span>
        <span class="gg-cap__rule"></span>
        @if (s.HasAchievements)
        {
            <a href="@ProgressRoute">@ShellText.Get(ShellText.LOYALTY_ACHIEVEMENTS) @ShellText.Get(ShellText.LOYALTY_OF, s.EarnedAchievements, s.Achievements.Count)</a>
        }
    </div>

    <div class="gg-loyal">
        @if (s.HasLadder && level is not null)
        {
            <div class="gg-loyal__top">
                <div class="gg-loyal__mark">
                    <svg viewBox="0 0 40 40" aria-hidden="true">
                        <circle class="gg-ring__track" cx="20" cy="20" r="18"></circle>
                        <circle class="gg-ring__bar" cx="20" cy="20" r="18" style="stroke-dashoffset: @LoyaltyRing.Offset(s.ProgressToNext)"></circle>
                    </svg>
                    <div class="gg-loyal__disc">
                        @if (emblem is not null)
                        {
                            <img src="@emblem" alt="" />
                        }
                        else
                        {
                            @LoyaltyText.Mark(level.Name)
                        }
                    </div>
                </div>
                <div class="gg-loyal__who">
                    <b>@level.Name</b>
                    <span>@LoyaltyLines.Short(s)</span>
                </div>
            </div>
            <div class="gg-loyal__track"><i style="width: @LoyaltyRing.Percent(s.ProgressToNext)%"></i></div>
        }
        else
        {
            @* No ladder, only achievements or challenges: the count is the headline. *@
            <div class="gg-loyal__top">
                <div class="gg-loyal__mark gg-loyal__mark--plain"><i class="ph-fill ph-trophy"></i></div>
                <div class="gg-loyal__who">
                    <b>@ShellText.Get(ShellText.LOYALTY_ACHIEVEMENTS)</b>
                    <span>@ShellText.Get(ShellText.LOYALTY_OF, s.EarnedAchievements, s.Achievements.Count)</span>
                </div>
            </div>
        }

        @if (action is not null)
        {
            <div class="gg-loyal__next">
                <i class="ph-fill @(action.Kind == LoyaltyActionKind.Challenge ? "ph-flag-checkered" : "ph-target")"></i>
                <span>
                    @action.Title
                    @if (!string.IsNullOrEmpty(action.ChallengeName))
                    {
                        <text> — </text><b>«@action.ChallengeName»</b>
                    }
                </span>
                @if (LoyaltyRing.RewardChip(action) is string chip)
                {
                    <em>@chip</em>
                }
                else if (action.TargetValue is > 0)
                {
                    <em>@LoyaltyText.Progress(action.CurrentValue, action.TargetValue, action.Unit)</em>
                }
            </div>
        }
        else if (s.RewardWaiting)
        {
            <div class="gg-loyal__next gg-loyal__next--reward">
                <i class="ph-fill ph-gift"></i>
                <span>@ShellText.Get(ShellText.LOYALTY_REWARD_WAITING_SHORT)</span>
            </div>
        }

        <button type="button" class="gg-loyal__more" @onclick="OpenProgress">
            <i class="ph-bold ph-trophy"></i>@ShellText.Get(ShellText.LOYALTY_MORE)<i class="ph-bold ph-arrow-right"></i>
        </button>
    </div>
</aside>
