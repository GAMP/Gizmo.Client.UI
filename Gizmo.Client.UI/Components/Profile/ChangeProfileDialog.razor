@namespace Gizmo.Client.UI.Components
@inherits CustomDOMComponentBase
@using Microsoft.AspNetCore.Components.Forms

<HostedDialog>
    <div class="giz-client-dialog giz-change-profile-dialog">
        <div class="giz-client-dialog__header">
            <div class="giz-client-dialog__header__title">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_USER_COMPLETE_PROFILE_TITLE))</div>
            <div class="giz-client-dialog__header__subtitle">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_USER_COMPLETE_PROFILE_SUBTITLE))</div>
        </div>

        <div class="giz-client-dialog__body giz-scrollbar--v">
            <EditForm EditContext="@UserChangeProfileViewStateService.EditContext">
                <div class="giz-change-profile-fields">

                    @if (ViewState.ShowFirstName)
                    {
                        <TextInput UpdateOnInput="true"
                                   IsDisabled="@ViewState.IsLoading"
                                   IsTransparent="true"
                                   Value="@ViewState.FirstName"
                                   ValueChanged="@((string value) => UserChangeProfileViewStateService.SetFirstName(value))"
                                   ValueExpression="@(() => ViewState.FirstName)"
                                   Size="InputSizes.Small"
                                   IsFullWidth="true"
                                   MaxLength="45"
                                   Label="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_USER_FIRST_NAME))" />
                    }

                    @if (ViewState.ShowLastName)
                    {
                        <TextInput UpdateOnInput="true"
                                   IsDisabled="@ViewState.IsLoading"
                                   IsTransparent="true"
                                   Value="@ViewState.LastName"
                                   ValueChanged="@((string value) => UserChangeProfileViewStateService.SetLastName(value))"
                                   ValueExpression="@(() => ViewState.LastName)"
                                   Size="InputSizes.Small"
                                   IsFullWidth="true"
                                   MaxLength="45"
                                   Label="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_USER_LAST_NAME))" />
                    }

                    @if (ViewState.ShowBirthDate)
                    {
                        <MaskedDateInput IsDisabled="@ViewState.IsLoading"
                                         IsTransparent="true"
                                         Value="@ViewState.BirthDate"
                                         ValueChanged="@((DateTime? value) => UserChangeProfileViewStateService.SetBirthDate(value))"
                                         ValueExpression="@(() => ViewState.BirthDate)"
                                         Size="InputSizes.Small"
                                         IsFullWidth="true"
                                         Label="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_USER_BIRTH_DATE))" />
                    }

                    @if (ViewState.ShowSex)
                    {
                        <Select IsDisabled="@ViewState.IsLoading"
                                IsTransparent="true"
                                HandleSVGIcon="Icons.Select_Client"
                                Value="@ViewState.Sex"
                                ValueChanged="@((Sex value) => UserChangeProfileViewStateService.SetSex(value))"
                                ValueExpression="@(() => ViewState.Sex)"
                                Size="InputSizes.Small"
                                IsFullWidth="true"
                                Label="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_USER_GENDER))"
                                OpenDirection="PopupOpenDirections.Cursor"
                                PopupClass="giz-scrollbar--v">
                            <SelectItem Value="@Sex.Unspecified" Text="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_SEX_UNSPECIFIED))" />
                            <SelectItem Value="@Sex.Male" Text="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_SEX_MALE))" />
                            <SelectItem Value="@Sex.Female" Text="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_SEX_FEMALE))" />
                        </Select>
                    }

                    @if (ViewState.ShowEmail)
                    {
                        <TextInput UpdateOnInput="true"
                                   IsDisabled="@ViewState.IsLoading"
                                   IsTransparent="true"
                                   Value="@ViewState.Email"
                                   ValueChanged="@((string value) => UserChangeProfileViewStateService.SetEmail(value))"
                                   ValueExpression="@(() => ViewState.Email)"
                                   Size="InputSizes.Small"
                                   IsFullWidth="true"
                                   MaxLength="254"
                                   Label="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_EMAIL))" />
                    }

                    @if (ViewState.ShowMobilePhone)
                    {
                        <PhoneNumberField SelectedCountryName="@_selectedPhoneCountryName"
                                          PhoneValue="@ViewState.MobilePhone"
                                          PhoneValueExpression="@(() => ViewState.MobilePhone)"
                                          IsDisabled="@ViewState.IsLoading"
                                          RenderWrappers="false"
                                          Size="InputSizes.Small"
                                          IsFullWidth="true"
                                          CanClearCountry="false"
                                          CountryLabel="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_USER_COUNTRY))"
                                          PhoneLabel="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_MOBILE_PHONE))"
                                          SearchPlaceholder="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_SEARCH))"
                                          CountryChanged="@OnPhoneCountryChangedAsync"
                                          PhoneValueChanged="@OnPhoneValueChangedAsync" />
                    }

                    @if (ViewState.ShowPhone)
                    {
                        <TextInput UpdateOnInput="true"
                                   IsDisabled="@ViewState.IsLoading"
                                   IsTransparent="true"
                                   Value="@ViewState.Phone"
                                   ValueChanged="@((string value) => UserChangeProfileViewStateService.SetPhone(value))"
                                   ValueExpression="@(() => ViewState.Phone)"
                                   Size="InputSizes.Small"
                                   IsFullWidth="true"
                                   MaxLength="20"
                                   Label="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_PHONE))" />
                    }

                    @if (ViewState.ShowCountry)
                    {
                        <TextInput UpdateOnInput="true"
                                   IsDisabled="@ViewState.IsLoading"
                                   IsTransparent="true"
                                   Value="@ViewState.Country"
                                   ValueChanged="@((string value) => UserChangeProfileViewStateService.SetCountry(value))"
                                   ValueExpression="@(() => ViewState.Country)"
                                   Size="InputSizes.Small"
                                   IsFullWidth="true"
                                   MaxLength="45"
                                   Label="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_USER_COUNTRY))" />
                    }

                    @if (ViewState.ShowAddress)
                    {
                        <TextInput UpdateOnInput="true"
                                   IsDisabled="@ViewState.IsLoading"
                                   IsTransparent="true"
                                   Value="@ViewState.Address"
                                   ValueChanged="@((string value) => UserChangeProfileViewStateService.SetAddress(value))"
                                   ValueExpression="@(() => ViewState.Address)"
                                   Size="InputSizes.Small"
                                   IsFullWidth="true"
                                   MaxLength="255"
                                   Label="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_USER_ADDRESS))" />
                    }

                    @if (ViewState.ShowCity)
                    {
                        <TextInput UpdateOnInput="true"
                                   IsDisabled="@ViewState.IsLoading"
                                   IsTransparent="true"
                                   Value="@ViewState.City"
                                   ValueChanged="@((string value) => UserChangeProfileViewStateService.SetCity(value))"
                                   ValueExpression="@(() => ViewState.City)"
                                   Size="InputSizes.Small"
                                   IsFullWidth="true"
                                   MaxLength="45"
                                   Label="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_USER_CITY))" />
                    }

                    @if (ViewState.ShowPostCode)
                    {
                        <TextInput UpdateOnInput="true"
                                   IsDisabled="@ViewState.IsLoading"
                                   IsTransparent="true"
                                   Value="@ViewState.PostCode"
                                   ValueChanged="@((string value) => UserChangeProfileViewStateService.SetPostCode(value))"
                                   ValueExpression="@(() => ViewState.PostCode)"
                                   Size="InputSizes.Small"
                                   IsFullWidth="true"
                                   MaxLength="20"
                                   Label="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_USER_POST_CODE))" />
                    }

                </div>
            </EditForm>
        </div>

        <div class="giz-client-dialog__footer">
            @if (ViewState.HasError)
            {
                <div class="giz-change-profile-dialog__error">@ViewState.ErrorMessage</div>
            }

            <Button IsDisabled="@(ViewState.IsLoading || ViewState.IsValid == false)"
                    Color="ButtonColors.Accent"
                    Size="ButtonSizes.Large"
                    IsFullWidth="true"
                    @onclick="@(() => UserChangeProfileViewStateService.SubmitAsync())"
                    Text="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_USER_COMPLETE_PROFILE_SAVE))" />
        </div>
    </div>
</HostedDialog>
