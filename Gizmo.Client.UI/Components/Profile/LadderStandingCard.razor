@namespace Gizmo.Client.UI.Components
@inherits CustomDOMComponentBase
@using Gizmo.Client.UI.Services
@using Gizmo.Client.UI.View.States

<div class="giz-stairs">
    <div class="giz-stairs__head">
        <div class="giz-stairs__score">
            <span class="giz-stairs__period">@PeriodLine</span>
            @if (ViewState.ShowScore)
            {
                <div class="giz-stairs__value"><b>@ViewState.ScoreText</b><small>@ViewState.ScoreUnitText</small></div>
            }
            else if (ViewState.ShowSegments)
            {
                <div class="giz-stairs__value"><b>@ViewState.ProgressCountText</b><small>@ViewState.ProgressUnitText</small></div>
            }
        </div>
        <div class="giz-stairs__say">
            <div class="giz-stairs__line">
                <b>@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_LADDER_YOU_ARE, ViewState.CurrentLevelName)</b>
                @if (!string.IsNullOrEmpty(StatusText))
                {
                    <span>@StatusText</span>
                }
            </div>
            <div class="giz-stairs__chips">
                @if (ViewState.ShowBanner)
                {
                    <span class="giz-stairs__chip giz-stairs__chip--good" title="@ViewState.BannerDetailText"><i class="ph-bold ph-shield-check"></i>@ViewState.BannerTitleText</span>
                }
                @if (!string.IsNullOrEmpty(ViewState.DaysLeftText))
                {
                    <span class="giz-stairs__chip"><i class="ph-bold ph-timer"></i>@ViewState.DaysLeftText</span>
                }
            </div>
            @if (ViewState.ShowKeepWarning)
            {
                <span class="giz-stairs__note giz-stairs__note--warning">@ViewState.KeepWarningText</span>
            }
            @if (ViewState.ShowProgressUpdating)
            {
                <span class="giz-stairs__note">@ViewState.ProgressUpdatingText</span>
            }
            @if (ViewState.ShowFrozen)
            {
                <span class="giz-stairs__note">@ViewState.FrozenText</span>
            }
        </div>
    </div>

    <div class="@StepsClass">
        @foreach (var step in Steps)
        {
            <LadderLevelRow @key="step.Level.Rank"
                            Item="@step.Level"
                            Rise="@step.Rise"
                            Fill="@step.Fill"
                            Here="@step.Here"
                            Requirements="@step.Requirements"
                            Dense="@IsDense" />
        }
    </div>
</div>
