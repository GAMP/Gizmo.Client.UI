@namespace Gizmo.Client.UI.Components
@inherits CustomDOMComponentBase

@* New feature, not yet in the vendor .resx (and per the lesson learned
   elsewhere in this shell, new .resx keys don't reliably reach a real
   deployment since Resources.dll ships with the base client install, not
   the skin) - so this dialog's own text is hard-coded here instead of
   going through LocalizationService, except for the two generic buttons
   (Cancel/Save) that already exist and are already correctly localized
   everywhere else in the app. *@

<HostedDialog>
    <div class="giz-client-dialog giz-change-picture-dialog">
        <div class="giz-client-dialog__header">
            <div class="giz-client-dialog__header__title">Фото профиля</div>
            @if (DisplayOptions.Closable)
            {
                <IconButton SVGIcon="Icons.Close" Variant="ButtonVariants.Text" Size="ButtonSizes.Small" Class="close-btn" @onclick="() => CloseDialog()" />
            }
        </div>

        <div class="giz-client-dialog__body">

            @if (_sourceDataUrl != null)
            {
                @* Редактор, а не просто предпросмотр: раньше картинка резалась
                   вслепую по центру, и портрет в полный рост превращался в
                   аватарку живота. Сцену наполняет JS (avatarCropInit), он же
                   держит перетаскивание и масштаб — гонять pointermove через
                   Blazor на каждый кадр незачем. *@
                <div class="giz-change-picture-preview">
                    <div class="giz-avatar-crop" @ref="_stageRef"></div>

                    <div class="giz-avatar-zoom">
                        <i class="ph-bold ph-magnifying-glass-minus"></i>
                        <input type="range" min="100" max="400" step="1"
                               value="@_zoomPercent"
                               disabled="@_isBusy"
                               @oninput="OnZoomInput" />
                        <i class="ph-bold ph-magnifying-glass-plus"></i>
                    </div>

                    <button class="giz-change-picture-preview__retry" @onclick="OnChooseDifferentClick" disabled="@_isBusy">
                        <i class="ph-bold ph-arrow-counter-clockwise"></i>
                        <span>Заменить</span>
                    </button>
                </div>
            }
            else
            {
                <label class="giz-avatar-dropzone">
                    <input type="file" accept="image/*" @ref="_fileInputRef" @onchange="OnFileInputChanged" disabled="@_isBusy" />
                    <i class="ph-bold ph-image-square"></i>
                    <div class="giz-avatar-dropzone__title">Перетащите, вставьте (Ctrl+V) или выберите файл</div>
                </label>

                <div class="giz-avatar-url-row">
                    <input type="text"
                           class="giz-avatar-url-row__input"
                           placeholder="...или ссылка на картинку"
                           value="@_urlInput"
                           disabled="@_isBusy"
                           @oninput="@((ChangeEventArgs e) => _urlInput = e.Value?.ToString() ?? string.Empty)"
                           @onkeydown="@OnUrlInputKeyDown" />
                    <button class="giz-avatar-url-row__submit" @onclick="OnLoadUrlClick" disabled="@(_isBusy || string.IsNullOrWhiteSpace(_urlInput))">
                        <i class="ph-bold ph-arrow-right"></i>
                    </button>
                </div>
            }

            @if (_isBusy)
            {
                <div class="giz-avatar-busy">
                    <Spinner />
                </div>
            }

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="giz-avatar-error">@_errorMessage</div>
            }

        </div>

        <div class="giz-client-dialog__footer giz-change-picture-dialog__footer">
            <Button Variant="ButtonVariants.Outline" Size="ButtonSizes.Large" IsFullWidth="true" @onclick="() => CloseDialog()" Text="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_CANCEL))" />
            <Button Color="ButtonColors.Accent" Size="ButtonSizes.Large" IsFullWidth="true" IsDisabled="@(_sourceDataUrl == null || _isBusy)" @onclick="OnSaveClick" Text="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_SAVE))" />
        </div>
    </div>
</HostedDialog>
