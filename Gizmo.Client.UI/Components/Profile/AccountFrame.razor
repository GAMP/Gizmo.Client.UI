@namespace Gizmo.Client.UI.Components
@inherits ShellComponentBase
@using System.Globalization
@using Gizmo.Client.UI.View.States

<div class="giz-account giz-scrollbar--v">
    <div class="giz-account__inner">

        <header class="giz-account__head">
            <UserAvatar Picture="@Profile.Picture" Class="giz-account__avatar" />

            <div class="giz-account__who">
                <h1 class="giz-account__name">@DisplayName</h1>
                <div class="giz-account__sub">
                    @if (!string.IsNullOrEmpty(FullName))
                    {
                        <span>@FullName</span>
                    }
                    @if (ShowMemberSince)
                    {
                        <span>@MemberSince</span>
                    }
                </div>
                <ProfileHeaderLadderLevel />
            </div>

            <div class="giz-account__stats">
                <div class="giz-account__stat giz-account__stat--money">
                    <small>@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_BALANCE))</small>
                    <b>@BalanceText</b>
                </div>
                <div class="giz-account__stat giz-account__stat--points">
                    <small>@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_POINTS))</small>
                    <b>@PointsText <i class="ph-fill ph-coins"></i></b>
                </div>
                <div class="giz-account__stat">
                    <small>@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_TIME))</small>
                    <b>
                        @if (Balance.Time.HasValue)
                        {
                            @TimeText
                        }
                        else
                        {
                            <i class="ph-bold ph-infinity"></i>
                        }
                    </b>
                </div>
                @if (HasCredit)
                {
                    <div class="giz-account__stat giz-account__stat--credit">
                        <small>@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_USER_PROFILE_HEADER_CREDIT))</small>
                        <b>
                            @if (CreditIsMixed)
                            {
                                <span class="giz-account__credit-part" title="@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_USER_PROFILE_CREDIT_TOOLTIP_TIME_CREDIT_DESCRIPTION))">
                                    <i class="ph-bold ph-clock giz-account__credit-kind"></i>
                                    @if (TimeCreditUnlimited)
                                    {
                                        <i class="ph-bold ph-infinity"></i>
                                    }
                                    else
                                    {
                                        @CreditLimitText
                                    }
                                </span>
                                <span class="giz-account__credit-part" title="@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_USER_PROFILE_CREDIT_TOOLTIP_SALES_CREDIT_DESCRIPTION))">
                                    <i class="ph-bold ph-shopping-cart-simple giz-account__credit-kind"></i>
                                    @if (SalesCreditUnlimited)
                                    {
                                        <i class="ph-bold ph-infinity"></i>
                                    }
                                    else
                                    {
                                        @CreditLimitText
                                    }
                                </span>
                            }
                            else if (CreditUnlimited)
                            {
                                <i class="ph-bold ph-infinity"></i>
                            }
                            else
                            {
                                @CreditLimitText
                            }
                        </b>
                        <span>@CreditNote</span>
                    </div>
                }
            </div>
        </header>

        <nav class="giz-account__tabs" aria-label="@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_USER_DETAILS))">
            @if (!UserViewState.IsGuest)
            {
                <NavLink class="giz-account__tab" href="@ClientRoutes.UserProfileRoute" Match="NavLinkMatch.All">
                    <i class="ph-bold ph-user"></i>
                    <span>@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_ACCOUNT_TAB_PROFILE)</span>
                </NavLink>
            }
            <NavLink class="giz-account__tab" href="@ClientRoutes.UserProductsRoute" Match="NavLinkMatch.All">
                <i class="ph-bold ph-hourglass-medium"></i>
                <span>@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_ACCOUNT_TAB_TIME)</span>
            </NavLink>
            @if (!InterfaceOptions.CurrentValue.DisableUserPurchaseHistory)
            {
                <NavLink class="giz-account__tab" href="@ClientRoutes.UserPurchasesRoute" Match="NavLinkMatch.All">
                    <i class="ph-bold ph-receipt"></i>
                    <span>@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_USER_PURCHASES))</span>
                </NavLink>
            }
            @if (!UserViewState.IsGuest)
            {
                <NavLink class="giz-account__tab" href="@ClientRoutes.UserLadderRoute" Match="NavLinkMatch.All">
                    <i class="ph-bold ph-ranking"></i>
                    <span>@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_USER_LADDER))</span>
                </NavLink>
                <NavLink class="giz-account__tab" href="@ClientRoutes.UserAchievementsRoute" Match="NavLinkMatch.All">
                    <i class="ph-bold ph-trophy"></i>
                    <span>@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_USER_ACHIEVEMENTS))</span>
                </NavLink>
                <NavLink class="giz-account__tab" href="@ClientRoutes.UserChallengesRoute" Match="NavLinkMatch.All">
                    <i class="ph-bold ph-flag-checkered"></i>
                    <span>@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_USER_CHALLENGES))</span>
                </NavLink>
            }
        </nav>

        <div class="giz-account__body">
            @ChildContent
        </div>
    </div>
</div>
