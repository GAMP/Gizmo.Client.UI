@namespace Gizmo.Client.UI.Components
@inherits CustomDOMComponentBase
@using System.Globalization
@using Gizmo.Client.UI.View.States
@using Gizmo.Client.UI.Pages

<div class="@RowClass">
    <div class="giz-account-time__order">@OrderText</div>

    <div class="giz-account-time__type"><i class="ph-fill @TimeProductText.Icon(Product.TimeProductType)"></i></div>

    <div class="giz-account-time__main">
        <div class="giz-account-time__line">
            <b class="giz-account-time__name">@TimeProductText.Name(Product)</b>
            <span class="giz-account-time__kind">@ShellText.Get(TimeProductText.TypeKey(Product.TimeProductType))</span>
            @if (IsCurrent)
            {
                <span class="giz-account-tag giz-account-tag--on">@ShellText.Get(ShellText.ACCOUNT_ACTIVE_NOW)</span>
            }
            else if (Order.HasValue)
            {
                <span class="giz-account-tag">@ShellText.Get(ShellText.ACCOUNT_QUEUE_POSITION, Order.Value)</span>
            }
            else
            {
                <span class="giz-account-tag giz-account-tag--off">@ShellText.Get(ShellText.ACCOUNT_NOT_HERE)</span>
            }
            @if (Product.InCredit)
            {
                <span class="giz-account-tag giz-account-tag--credit">@ShellText.Get(ShellText.TIME_IN_CREDIT)</span>
            }
        </div>
        <div class="giz-account-time__meta">
            @if (Product.PurchaseTime.HasValue)
            {
                <span class="giz-account-time__fact">
                    <i class="ph ph-calendar-blank"></i>
                    <span>@ShellText.Get(ShellText.TIME_BOUGHT): @Product.PurchaseTime.Value.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)</span>
                </span>
            }
            @if (!string.IsNullOrEmpty(Expiry))
            {
                <span class="giz-account-time__fact">
                    <i class="ph ph-hourglass-low"></i>
                    <span>@Expiry</span>
                </span>
            }
            <span class="giz-account-time__fact giz-account-time__fact--hosts">
                <i class="ph ph-desktop"></i>
                <ProductsProductHosts TimeProduct="@Product" />
            </span>
        </div>
    </div>

    <div class="giz-account-time__stat">
        <small>@ShellText.Get(ShellText.TIME_REMAINING)</small>
        <b>@TimeProductText.Span(Product.RemainingTime)</b>
    </div>
    <div class="giz-account-time__stat">
        <small>@ShellText.Get(ShellText.TIME_USABLE_HERE)</small>
        <b>@TimeProductText.Span(Product.UsableTime)</b>
    </div>

    @if (CanOpen)
    {
        <button type="button" class="giz-account-time__open" title="@ShellText.Get(ShellText.GEN_DETAILS)" @onclick="OnOpen">
            <i class="ph-bold ph-arrow-up-right"></i>
        </button>
    }
    else
    {
        <span class="giz-account-time__open giz-account-time__open--none"></span>
    }
</div>
