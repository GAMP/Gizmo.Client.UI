@namespace Gizmo.Client.UI.Components
@inherits ShellComponentBase

@if (ProgressOn)
{
    <aside class="giz-home-till giz-home-till--progress" aria-label="@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_PROGRESS_HOME_CAP)">
        <div class="giz-home-progress__head">
            @if (HasLadder)
            {
                <LadderLevelBadge Ordinal="@Ladder.Ordinal" EmblemUrl="@Ladder.EmblemUrl" />
            }
            else
            {
                <span class="giz-home-progress__glyph"><i class="ph-fill ph-trophy"></i></span>
            }
            <span class="giz-home-progress__who">
                <b>@Title</b>
                @if (!string.IsNullOrEmpty(Subtitle))
                {
                    <span>@Subtitle</span>
                }
            </span>
            @if (ShowLine)
            {
                <span class="giz-home-progress__line" style="--giz-ring-progress: @LineValue"><i></i></span>
            }
        </div>

        @if (Steps.Count > 0)
        {
            <div class="giz-home-progress__list">
                @foreach (var step in Steps)
                {
                    <div class="giz-home-progress__row">
                        <span class="giz-home-progress__text">
                            <b>@step.Title</b>
                            @if (!string.IsNullOrEmpty(step.Note))
                            {
                                <span>@step.Note</span>
                            }
                        </span>
                        @if (!string.IsNullOrEmpty(step.Reward))
                        {
                            <span class="giz-home-progress__reward"><i class="@step.RewardIcon"></i>@step.Reward</span>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <p class="giz-home-progress__empty">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_PROGRESS_NOTHING)</p>
        }

        <button type="button" class="giz-home-progress__open" @onclick="OpenProgress">
            <i class="ph-bold ph-trophy"></i>
            <span>@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_PROGRESS_OPEN)</span>
            <i class="ph-bold ph-arrow-right giz-home-progress__go"></i>
        </button>
    </aside>
}
