@namespace Gizmo.Client.UI.Components
@inherits ProfileCardBase
@using Gizmo.Client.UI.Services
@using Gizmo.Client.UI.View.States

<div class="@CardClass">
    <div class="giz-challenge-card__info" @onclick="ToggleInfo" @onclick:stopPropagation="true">
        <Icon SVGIcon="Icons.Info2_Client" />
    </div>

    <ProfileCardPopup WrapperClass="giz-challenge-popup-wrapper" ContentClass="giz-challenge-popup" @bind-IsOpen="IsInfoOpen">
        <ChallengeCardPopup Item="@Item" />
    </ProfileCardPopup>

    <div class="giz-challenge-card__top">
        <div class="giz-challenge-card__art"><i class="ph-fill @ArtIcon"></i></div>
        <div class="giz-challenge-card__head">
            <div class="giz-challenge-card__name">@Item.Name</div>
            @if (!string.IsNullOrEmpty(Item.WindowText))
            {
                <div class="@WindowClass">@Item.WindowText</div>
            }
        </div>
        @if (!string.IsNullOrEmpty(Item.CountText))
        {
            <div class="giz-challenge-card__count-pill">@Item.CountText</div>
        }
    </div>

    @if (Item.Requirements.Count > 0)
    {
        <div class="giz-challenge-card__segments">
            @foreach (var requirement in Item.Requirements)
            {
                <span class="@SegmentClass(requirement)"></span>
            }
        </div>
    }
    else if (Item.ShowProgressBar)
    {
        <div class="giz-challenge-card__progress" style="--giz-ring-progress: @ProgressValue">
            <div class="giz-challenge-card__progress-fill"></div>
        </div>
    }

    <div class="giz-challenge-card__requirements">
        @if (NextRequirement is not null)
        {
            <b>@NextRequirement.Name</b>
        }
        <span>@Item.RequirementsText</span>
    </div>

    <div class="giz-challenge-card__foot">
        @if (Item.HasChip)
        {
            <span class="@ChipClass">@Item.ChipText</span>
        }
        @foreach (var reward in Item.Rewards)
        {
            <span class="giz-challenge-card__reward">
                <i class="ph-fill @RewardIcon(reward)"></i>
                <span>@reward.Text</span>
                @if (!string.IsNullOrEmpty(reward.StatusText))
                {
                    <small>@reward.StatusText</small>
                }
            </span>
        }
    </div>
</div>
