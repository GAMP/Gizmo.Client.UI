@namespace Gizmo.Client.UI.Components
@inherits CustomDOMComponentBase

@if (ViewState.HasLevel)
{
    @if (ViewState.ShowTopBarProgress)
    {
        <svg class="giz-avatar-level__ring" viewBox="0 0 40 40" aria-hidden="true" style="--giz-ring-progress: @ProgressValue">
            <circle class="giz-avatar-level__track" cx="20" cy="20" r="19"></circle>
            <circle class="giz-avatar-level__bar" cx="20" cy="20" r="19"></circle>
        </svg>
    }
    <span class="giz-avatar-level__mark">
        <LadderLevelBadge Ordinal="@ViewState.Ordinal" EmblemUrl="@ViewState.EmblemUrl" />
    </span>
}
