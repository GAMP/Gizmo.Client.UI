@namespace Gizmo.Client.UI.Components
@inherits CustomDOMComponentBase
@using Gizmo.Client.UI.View.States

<div class="@StepClass" style="@StepStyle" @onclick="OnClick" @onclick:stopPropagation="true">
    @if (!string.IsNullOrEmpty(Here))
    {
        <span class="giz-stairs__here">@Here</span>
    }
    <div class="giz-stairs__block">
        @if (Fill is not null)
        {
            <span class="giz-stairs__fill"></span>
        }
        <div class="giz-stairs__top">
            <LadderLevelBadge Ordinal="@Item.Ordinal" EmblemUrl="@Item.EmblemUrl" />
            <b class="giz-stairs__name" title="@Item.Name">@Item.Name</b>
            @if (Item.HasInfo)
            {
                <LadderLevelInfo Item="@Item" />
            }
        </div>
        @if (IsPassed || !string.IsNullOrEmpty(MetaText))
        {
            <span class="giz-stairs__meta">
                @if (IsPassed)
                {
                    <i class="ph-bold ph-check giz-stairs__passed"></i>
                }
                <span>@MetaText</span>
            </span>
        }
        @if (!Dense)
        {
            @if (Requirements is not null)
            {
                <div class="giz-stairs__reqs">
                    @foreach (var requirement in Requirements)
                    {
                        <LadderRequirementRow Item="@requirement" />
                    }
                </div>
            }
            else if (Item.HasPerks)
            {
                <div class="giz-stairs__perks">
                    @foreach (var perk in Item.PerkTexts)
                    {
                        <span>@perk</span>
                    }
                </div>
            }
        }
    </div>
</div>
