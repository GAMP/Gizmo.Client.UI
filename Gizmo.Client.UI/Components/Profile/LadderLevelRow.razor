@namespace Gizmo.Client.UI.Components
@inherits CustomDOMComponentBase
@using Gizmo.Client.UI.View.States

<div class="giz-ladder-level-row @(Item.IsCurrent ? "giz-ladder-level-row--current" : "") @(Item.IsSelected ? "giz-ladder-level-row--selected" : "")"
     @onclick="OnClick" @onclick:stopPropagation="true">
    <span class="giz-ladder-level-row__check">
        <Icon SVGIcon="@(Item.IsSatisfied ? Icons.CheckCircle_Client : Icons.Circle_Client)" />
    </span>
    <span class="giz-ladder-rank">@Item.Ordinal</span>
    <span class="giz-ladder-level-row__name">@Item.Name</span>
    @if (Item.IsCurrent)
    {
        <span class="giz-ladder-level-row__chip">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_USER_LADDER_CURRENT))</span>
    }
    else if (Item.IsNext)
    {
        <span class="giz-ladder-level-row__chip giz-ladder-level-row__chip--next">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_USER_LADDER_NEXT))</span>
    }
    else if (Item.IsLocked)
    {
        <span class="giz-ladder-level-row__chip giz-ladder-level-row__chip--locked">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_USER_LADDER_LOCKED))</span>
    }
    @if (!string.IsNullOrEmpty(MetaText))
    {
        <span class="giz-ladder-level-row__meta">@MetaText</span>
    }
</div>
