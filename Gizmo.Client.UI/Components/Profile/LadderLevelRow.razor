@namespace Gizmo.Client.UI.Components
@inherits CustomDOMComponentBase
@using Gizmo.Client.UI.View.States

<div class="@RowClass" style="--giz-i: @Item.Ordinal" @onclick="OnClick" @onclick:stopPropagation="true">
    <div class="giz-ladder-level-row__head">
        <LadderLevelBadge Ordinal="@Item.Ordinal" EmblemUrl="@Item.EmblemUrl" />
        @if (StateText is not null)
        {
            <span class="@StateClass">@StateText</span>
        }
        @if (Item.HasInfo)
        {
            <LadderLevelInfo Item="@Item" />
        }
    </div>
    <span class="giz-ladder-level-row__name">@Item.Name</span>
    @if (!string.IsNullOrEmpty(Item.MetaText))
    {
        <span class="giz-ladder-level-row__meta">@Item.MetaText</span>
    }
</div>
