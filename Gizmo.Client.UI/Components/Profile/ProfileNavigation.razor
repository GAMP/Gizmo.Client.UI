@namespace Gizmo.Client.UI.Components
@inherits CustomDOMComponentBase

<div class="giz-profile-navigation">
    
    @if (!ViewState.IsGuest)
    {
        <div class="giz-profile-navigation-item">
            <NavLink href="@ClientRoutes.UserProfileRoute" Match="NavLinkMatch.All">
                <Icon SVGIcon="Icons.User_Client" />
                @LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_USER_DETAILS))
            </NavLink>
        </div>
    }

    <div class="giz-profile-navigation-item">
        <NavLink href="@ClientRoutes.UserProductsRoute" Match="NavLinkMatch.All">
            <Icon SVGIcon="Icons.WorkHistory_Client" />
            @LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_USER_AVAILABLE_TIME))
        </NavLink>
    </div>

    @if (!ClientInterfaceOptions.CurrentValue.DisableUserPurchaseHistory)
    {
        <div class="giz-profile-navigation-item">
            <NavLink href="@ClientRoutes.UserPurchasesRoute" Match="NavLinkMatch.All">
                <Icon SVGIcon="Icons.ShoppingCart_Client" />
                @LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_USER_PURCHASES))
            </NavLink>
        </div>
    }

    @if (!ViewState.IsGuest)
    {
        <div class="giz-profile-navigation-item">
            <NavLink href="@ClientRoutes.UserLadderRoute" Match="NavLinkMatch.All">
                <Icon SVGIcon="Icons.Ladder_Client" />
                @LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_USER_LADDER))
            </NavLink>
        </div>
        <div class="giz-profile-navigation-item">
            <NavLink href="@ClientRoutes.UserAchievementsRoute" Match="NavLinkMatch.All">
                <Icon SVGIcon="Icons.Trophy_Client" />
                @LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_USER_ACHIEVEMENTS))
            </NavLink>
        </div>
        <div class="giz-profile-navigation-item">
            <NavLink href="@ClientRoutes.UserChallengesRoute" Match="NavLinkMatch.All">
                <Icon SVGIcon="Icons.Challenges_Client" />
                @LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_USER_CHALLENGES))
            </NavLink>
        </div>
    }

    @*<div class="giz-profile-navigation-item">
        <NavLink href="@ClientRoutes.UserDepositsRoute" Match="NavLinkMatch.All">
            <Icon SVGIcon="Icons.WiFi_Client" />
            @LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_USER_TRANSACTIONS))
        </NavLink>
    </div>*@
    
</div>
