@namespace Gizmo.Client.UI.Components
@inherits CustomDOMComponentBase
@using Microsoft.AspNetCore.Components.Forms

<HostedDialog>
    <div class="@DialogClass">
        @if (DisplayOptions.Closable)
        {
            <button type="button" class="giz-tile-dialog__close" aria-label="@CloseLabel" @onclick="CloseDialog">
                <i class="ph-bold ph-x"></i>
            </button>
        }
        <i class="@IconClass giz-tile-dialog__icon"></i>
        <h2 class="giz-tile-dialog__title">@Title</h2>

        @if (!ViewState.IsComplete)
        {
            <EditForm EditContext="@UserChangePasswordService.EditContext" class="giz-tile-dialog__form">
                @if (ViewState.ShowOldPassword)
                {
                    <div class="giz-tile-dialog__field">
                        <span class="giz-tile-dialog__label">@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_CHANGE_PASSWORD_CURRENT_PASSWORD))</span>
                        <div class="giz-tile-dialog__well">
                            <PasswordInput UpdateOnInput="true"
                                           ShowRevealButton="true"
                                           IsTransparent="true"
                                           Value="@ViewState.OldPassword"
                                           ValueChanged="@((string value) => UserChangePasswordService.SetOldPassword(value))"
                                           ValueExpression="@(() => ViewState.OldPassword)"
                                           IsDisabled="@ViewState.IsLoading"
                                           Size="InputSizes.Small"
                                           IsFullWidth="true" />
                        </div>
                    </div>
                }
                <div class="giz-tile-dialog__field">
                    <span class="giz-tile-dialog__label">@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_CHANGE_PASSWORD_NEW_PASSWORD))</span>
                    @if (ViewState.PasswordTooltip.TotalRules > 0)
                    {
                        <ClientTooltip OpenDirection="TooltipOpenDirections.Left" Class="giz-password-tooltip-root">
                            <ChildContent>
                                <div class="giz-tile-dialog__well">
                                    <PasswordInput UpdateOnInput="true"
                                           ShowRevealButton="true"
                                           IsTransparent="true"
                                           Value="@ViewState.NewPassword"
                                           ValueChanged="@((string value) => UserChangePasswordService.SetNewPassword(value))"
                                           ValueExpression="@(() => ViewState.NewPassword)"
                                           IsDisabled="@ViewState.IsLoading"
                                           Size="InputSizes.Small"
                                           IsFullWidth="true" />
                                </div>
                            </ChildContent>
                            <TooltipContent>
                                <PasswordTooltip PasswordTooltipViewState="@ViewState.PasswordTooltip" />
                            </TooltipContent>
                        </ClientTooltip>
                    }
                    else
                    {
                        <div class="giz-tile-dialog__well">
                            <PasswordInput UpdateOnInput="true"
                                           ShowRevealButton="true"
                                           IsTransparent="true"
                                           Value="@ViewState.NewPassword"
                                           ValueChanged="@((string value) => UserChangePasswordService.SetNewPassword(value))"
                                           ValueExpression="@(() => ViewState.NewPassword)"
                                           IsDisabled="@ViewState.IsLoading"
                                           Size="InputSizes.Small"
                                           IsFullWidth="true" />
                        </div>
                    }
                </div>
                <div class="giz-tile-dialog__field">
                    <span class="giz-tile-dialog__label">@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_CHANGE_PASSWORD_CONFIRM_PASSWORD))</span>
                    <div class="giz-tile-dialog__well">
                        <PasswordInput UpdateOnInput="true"
                                           ShowRevealButton="true"
                                           IsTransparent="true"
                                           Value="@ViewState.RepeatPassword"
                                           ValueChanged="@((string value) => UserChangePasswordService.SetRepeatPassword(value))"
                                           ValueExpression="@(() => ViewState.RepeatPassword)"
                                           IsDisabled="@ViewState.IsLoading"
                                           Size="InputSizes.Small"
                                           IsFullWidth="true" />
                    </div>
                </div>
            </EditForm>
            <div class="giz-tile-dialog__actions">
                @if (DisplayOptions.Closable)
                {
                    <button type="button" class="giz-tile-dialog__button" @onclick="CloseDialog">@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_CANCEL))</button>
                }
                <button type="button" class="giz-tile-dialog__button giz-tile-dialog__button--primary" disabled="@IsSaveDisabled" @onclick="@(() => UserChangePasswordService.SubmitAsync())">
                    @if (ViewState.IsLoading)
                    {
                        <span class="giz-loader giz-loader--small"></span>
                    }
                    else
                    {
                        <span>@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_SAVE))</span>
                    }
                </button>
            </div>
        }
        else
        {
            @if (ViewState.HasError)
            {
                <p class="giz-tile-dialog__text">@ViewState.ErrorMessage</p>
            }
            <div class="giz-tile-dialog__actions">
                <button type="button" class="giz-tile-dialog__button giz-tile-dialog__button--primary" @onclick="CloseDialog">@CloseLabel</button>
            </div>
        }
    </div>
</HostedDialog>
