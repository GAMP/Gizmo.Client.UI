@namespace Gizmo.Client.UI.Components
@inherits CustomDOMComponentBase

<span class="giz-ladder-level__score-info" @onclick="OnToggle" @onclick:stopPropagation="true">
    <Icon SVGIcon="Icons.Info2_Client" Size="IconSizes.Small" />
</span>
<ProfileCardPopup WrapperClass="giz-ladder-score-popup-wrapper" ContentClass="giz-ladder-level-popup" IsOpen="@IsOpen" IsOpenChanged="@IsOpenChanged">
    <div class="giz-ladder-level-popup__perks">
        <div class="giz-ladder-level-popup__label">@ViewState.BreakdownLabelText</div>
        @foreach (var text in ViewState.BreakdownTexts)
        {
            <div class="giz-ladder-level-popup__perk">@text</div>
        }
    </div>
</ProfileCardPopup>
