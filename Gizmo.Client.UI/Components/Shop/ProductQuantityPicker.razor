@namespace Gizmo.Client.UI.Components
@inherits ShellComponentBase

@if (!IsShopEnabled)
{
}
else if (_product.DisallowPurchase)
{
    <ClientTooltip Text="@_product.DisallowPurchaseReason" Class="giz-product-host-groups-tooltip">
        <ChildContent>
            <Button IsDisabled="true"
                    Color="ButtonColors.Accent"
                    Size="@Size"
                    IsFullWidth="@IsFullWidth"
                    Text="@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_ADD_TO_CART))" />
        </ChildContent>
    </ClientTooltip>
}
else if (IsTimePackage)
{
    <Button Color="ButtonColors.Accent"
            Class="giz-product-card-primary-button"
            Size="@Size"
            IsFullWidth="@IsFullWidth"
            IsDisabled="@_buying"
            Text="@GrafitLocalization.GetString(_buying ? GrafitResourceKeys.SHELL_GEN_WORKING : GrafitResourceKeys.SHELL_GEN_BUY)"
            @onclick="OnBuyPackageClickHandler" />
}
else
{
    if (_userCartProductViewState == null || _userCartProductViewState.Quantity == 0)
    {
        <Button Color="ButtonColors.Accent"
                Class="giz-product-card-primary-button"
                Size="@Size"
                IsFullWidth="@IsFullWidth"
                LeftSVGIcon="Icons.Plus"
                Text="@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_ADD_TO_CART))"
                @onclick="OnAddProductButtonClickHandler" />
    }
    else
    {
        <QuantityPicker Maximum="@(_product.ProductType == ProductType.ProductTime ? 1 : int.MaxValue)"
                        Size="@Size"
                        Quantity="@_userCartProductViewState.Quantity"
                        OnAddQuantityButtonClick="OnAddQuantityButtonClickHandlerAsync"
                        OnRemoveQuantityButtonClick="OnRemoveQuantityButtonClickHandler"
                        OnClick="@((args) => OnClick.InvokeAsync(args))" />
    }
}