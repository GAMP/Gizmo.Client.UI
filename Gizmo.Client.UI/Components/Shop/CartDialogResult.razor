@namespace Gizmo.Client.UI.Components
@inherits ComponentBase

<div class="@ResultClass">
    <div class="giz-buy__result-icon">
        <i class="@IconClass"></i>
    </div>
    <div class="giz-buy__result-title">@Title</div>
    @if (Ok)
    {
        @if (Name is { Length: > 0 })
        {
            <div class="giz-buy__result-name">@Name</div>
        }
        @if (Note is { Length: > 0 })
        {
            <div class="giz-buy__result-note">@Note</div>
        }
    }
    else if (Error is { Length: > 0 })
    {
        <div class="giz-buy__result-note giz-buy__result-note--error">@((MarkupString)Error)</div>
    }
    <div class="giz-buy__actions giz-buy__actions--center">
        <button type="button" class="giz-buy__btn giz-buy__btn--primary" @onclick="@(() => OnClose.InvokeAsync())">@ActionLabel</button>
    </div>
</div>
