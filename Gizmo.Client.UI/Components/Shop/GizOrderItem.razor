@namespace Gizmo.Client.UI.Components
@inherits CustomDOMComponentBase
@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms

<div class="giz-order-item">
    <div class="giz-order-item__thumb">
        <GizImage @key="UserCartProductViewState.ProductId" ImageType="Gizmo.UI.ImageType.ProductDefault" ImageId="@_product?.DefaultImageId" ImageFitType="ImageFitType.Cover">
            <EmptyResultPlaceholder>
                <i class="ph-fill ph-package"></i>
            </EmptyResultPlaceholder>
            <ErrorPlaceholder>
                <i class="ph-fill ph-package"></i>
            </ErrorPlaceholder>
        </GizImage>
    </div>
    <div class="giz-order-item__description">
        @_product?.Name
    </div>
    <ICartViewStateLoader ViewState="@ClientServerCartViewService.ViewState" MinimumHeight="6.8rem">
        <div class="giz-order-item__details">
            @if (_product?.PurchaseOptions.HasFlag(PurchaseOptionType.Or) == true)
            {
                @* A real either/or choice - each radio sits with the value
                   it selects, instead of two radios floating to the side of
                   a shared price/points pair (which read as "pick one of
                   these two unlabeled dots" on its own). *@
                @* Not <label> - RadioButton already renders its own
                   internal <input>+<label for>, so an outer label here would
                   nest labels (invalid HTML, double-toggle risk). *@
                <div class="giz-order-item__details__option">
                    <RadioButton @key="Guid.NewGuid()" GroupName="@GetPurchaseOptionsGroup()" IsChecked="@(UserCartProductViewState.PayType == OrderLinePayType.Cash)" IsCheckedChanged="@((isChecked) => SetPayType(isChecked, OrderLinePayType.Cash))" />
                    <span class="giz-order-item__details__price">@UserCartProductViewState.TotalPrice.ToString("C", CultureInfo.CurrentCulture)</span>
                </div>
                <div class="giz-order-item__details__option">
                    <RadioButton @key="Guid.NewGuid()" GroupName="@GetPurchaseOptionsGroup()" IsChecked="@(UserCartProductViewState.PayType == OrderLinePayType.Points)" IsCheckedChanged="@((isChecked) => SetPayType(isChecked, OrderLinePayType.Points))" />
                    <span class="giz-order-item__details__points"><Points2Icon />@UserCartProductViewState.TotalPointsPrice.GetValueOrDefault().ToString("N0")</span>
                </div>
            }
            else
            {
                <div class="giz-order-item__details__price">@UserCartProductViewState.TotalPrice.ToString("C", CultureInfo.CurrentCulture)</div>
                @* Points only shown when this item actually earns some -
                   every line displaying "& 0" regardless was pure noise. *@
                @if (UserCartProductViewState.TotalPointsPrice.GetValueOrDefault() > 0)
                {
                    <div class="giz-order-item__details__points"><Points2Icon />@UserCartProductViewState.TotalPointsPrice.GetValueOrDefault().ToString("N0")</div>
                }
            }
        </div>
    </ICartViewStateLoader>
    <div class="giz-order-item__remove">
        <IconButton Variant="ButtonVariants.Text" Size="ButtonSizes.Small" SVGIcon="Icons.Trash3_Client" @onclick="@(() => ClientServerCartViewService.RemoveEntry(UserCartProductViewState.Guid))" />
    </div>
    <div class="giz-order-item__quantity">
        <QuantityPicker Minimum="1" Maximum="@(_product.ProductType == ProductType.ProductTime ? 1 : int.MaxValue)" Size="ButtonSizes.Small" Quantity="@UserCartProductViewState.Quantity" OnAddQuantityButtonClick="OnAddQuantityButtonClickHandlerAsync" OnRemoveQuantityButtonClick="OnRemoveQuantityButtonClickHandler" />
    </div>
</div>
