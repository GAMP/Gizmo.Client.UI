@namespace Gizmo.Client.UI.Components
@inherits CustomDOMComponentBase
@using Microsoft.AspNetCore.Components.Forms

<div class="@ClassName">
    <div class="giz-cart-line__row" role="button" tabindex="0" aria-expanded="@IsOpen"
         @onclick="@Toggle" @onkeydown="@OnRowKey">
        <span class="giz-cart-line__thumb">
            <GizImage @key="UserCartProductViewState.ProductId" ImageType="Gizmo.UI.ImageType.ProductDefault" ImageId="@_product?.DefaultImageId" ImageFitType="ImageFitType.Cover">
                <EmptyResultPlaceholder>
                    <i class="@PlaceholderIcon"></i>
                </EmptyResultPlaceholder>
                <ErrorPlaceholder>
                    <i class="@PlaceholderIcon"></i>
                </ErrorPlaceholder>
            </GizImage>
        </span>
        <span class="giz-cart-line__qty">@QuantityText</span>
        <span class="giz-cart-line__name">@_product?.Name</span>
        <ICartViewStateLoader ViewState="@ClientServerCartViewService.ViewState" MinimumHeight="2.2rem">
            <span class="giz-cart-line__sum">
                @if (ShowsMoney)
                {
                    <span>@PriceText</span>
                }
                @if (ShowsPoints)
                {
                    <span class="giz-cart-line__points">@PointsPriceText<i class="ph-fill ph-coins"></i></span>
                }
            </span>
        </ICartViewStateLoader>
    </div>

    @if (IsOpen)
    {
        <div class="giz-cart-line__more">
            <div class="giz-cart-line__stepper">
                <button type="button" class="@LessClass" title="@LessTitle" @onclick="@OnLessAsync">
                    <i class="@LessIcon"></i>
                </button>
                <span class="giz-cart-line__count">@UserCartProductViewState.Quantity</span>
                <button type="button" class="giz-cart-line__step" disabled="@IsAtMaximum" @onclick="@OnAddQuantityButtonClickHandlerAsync">
                    <i class="ph-bold ph-plus"></i>
                </button>
            </div>

            @if (HasPayChoice)
            {
                <div class="giz-cart-line__pay">
                    <span class="giz-cart-line__pay-label">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_CART_PAY_WITH)</span>
                    <div class="giz-cart-line__pay-ways">
                        <button type="button" class="@PayClass(OrderLinePayType.Cash)" @onclick="@(() => SetPayType(true, OrderLinePayType.Cash))">@CashPriceText</button>
                        <button type="button" class="@PayClass(OrderLinePayType.Points)" @onclick="@(() => SetPayType(true, OrderLinePayType.Points))">
                            <i class="ph-fill ph-coins"></i>
                            <span>@PointsWayText</span>
                        </button>
                    </div>
                </div>
            }
            else if (UnitPriceText is { Length: > 0 } unitPrice)
            {
                <span class="giz-cart-line__unit">@unitPrice</span>
            }
        </div>
    }
</div>
