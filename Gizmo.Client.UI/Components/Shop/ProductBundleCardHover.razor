@namespace Gizmo.Client.UI.Components
@inherits CustomDOMComponentBase

@if (Product != null)
{
    <div class="giz-peek giz-peek--bundle">
        <div class="giz-peek__name">@Product.Name</div>
        <div class="giz-peek__block">
            <div class="giz-peek__cap giz-peek__cap--center"><span>@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_PEEK_CONTENTS)</span></div>
            <div class="giz-peek__items">
                @foreach (var bundledProduct in Product.BundledProducts)
                {
                    <ProductBundleCardBundledProduct @key="bundledProduct" ProductId="@bundledProduct.Id" Quantity="@bundledProduct.Quantity" />
                }
            </div>
        </div>
        @if (BuyWeek.Count > 0)
        {
            <div class="giz-peek__block">
                <div class="giz-peek__cap"><span>@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_PEEK_BUY)</span>@if (BuyWindow is { Length: > 0 } buyWindow){<b>@buyWindow</b>}</div>
                <div class="giz-peek__week">
                    @foreach (var day in BuyWeek)
                    {
                        <span class="@DayClass(day)">@day.Name</span>
                    }
                </div>
            </div>
        }
    </div>
}
