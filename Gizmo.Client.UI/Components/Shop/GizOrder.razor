@namespace Gizmo.Client.UI.Components
@inherits CustomDOMComponentBase
@using System.Globalization

<div class="giz-order">
    <div class="giz-order__items">
        <div class="giz-order__items__header">@LocalizationService.GetString("GIZ_SHOP_ORDER_TITLE")</div>
        <div class="giz-order__items__body giz-scrollbar--v">
            @if (ClientServerCartViewService.ViewState.Products.Count() > 0)
            {
                <div class="giz-order__items-wrapper">
                    @foreach (var orderLine in ClientServerCartViewService.ViewState.Products)
                    {
                        <GizOrderItem @key="orderLine" UserCartProductViewState="@orderLine" />
                    }
                </div>
            }
            else
            {
                <div class="giz-no-order-wrapper">
                    <div class="giz-empty-state">
                        <div class="giz-empty-state__title">@LocalizationService.GetString("GIZ_SHOP_NO_PRODUCTS_MESSAGE")</div>
                        <div class="giz-empty-state__text">@LocalizationService.GetString("GIZ_SHOP_NO_PRODUCTS_RETRY_MESSAGE")</div>
                    </div>
                </div>
            }
        </div>
        <div class="giz-order__items__footer">
            <Button IsDisabled="@(ClientServerCartViewService.ViewState.Products.Count() == 0)"
                    Variant="ButtonVariants.Text"
                    Size="ButtonSizes.Small"
                    LeftSVGIcon="Icons.Trash3_Client"
                    Text="@LocalizationService.GetString("GIZ_GEN_CLEAR")"
                    @onclick="@(() => Service.ClearUserCartProductsAsync())" />
        </div>
    </div>

    <div class="giz-order__notes">
        <div class="giz-order__notes__header">@LocalizationService.GetString("GIZ_SHOP_ORDER_NOTE")</div>
        <div class="giz-order__notes__body">
            <TextInput IsTransparent="true"
                       ValidationErrorStyle="ValidationErrorStyles.BorderOnly"
                       Value="@Service.ViewState.Notes"
                       ValueChanged="@((string value) => Service.SetNotes(value))"
                       ValueExpression="@(() => Service.ViewState.Notes)"
                       IsMultiLine="true"
                       IsFullWidth="true"
                       Placeholder="@LocalizationService.GetString("GIZ_SHOP_ORDER_NOTE_PLACEHOLDER")"
                       Class="giz-order-notes" />
        </div>
    </div>

    <div class="giz-order__totals">
        <div class="giz-order-promocode">
            <TextInput IsTransparent="true"
                       ValidationErrorStyle="ValidationErrorStyles.BorderOnly"
                       Value="@ClientServerCartViewService.ViewState.PromoCodeViewState.InputPromoCode"
                       ValueChanged="@((string value) => ClientServerCartViewService.SetInputPromoCode(value))"
                       IsReadOnly="@(ClientServerCartViewService.ViewState.PromoCodeStatus != Web.Api.Models.PromoCodeApplyStatus.None)"
                       UpdateOnInput="true"
                       IsFullWidth="true"
                       Placeholder="@LocalizationService.GetString("GIZ_SHOP_ORDER_PROMOCODE_PLACEHOLDER")" />
            @if (string.IsNullOrEmpty(ClientServerCartViewService.ViewState.PromoCodeViewState.PromoCode))
            {
                <Button Size="ButtonSizes.ExtraLarge"
                        IsDisabled="@(ClientServerCartViewService.ViewState.IsStateUpdateRequired || ClientServerCartViewService.ViewState.IsStateUpdating || ClientServerCartViewService.ViewState.PromoCodeViewState.IsLoading)"
                        Text="@LocalizationService.GetString("GIZ_SHOP_APPLY_PROMOCODE")"
                        @onclick="@(() => ClientServerCartViewService.AddPromoCode(ClientServerCartViewService.ViewState.PromoCodeViewState.InputPromoCode))" />
            }
            else
            {
                <Button Size="ButtonSizes.ExtraLarge"
                        IsDisabled="@(ClientServerCartViewService.ViewState.IsStateUpdateRequired || ClientServerCartViewService.ViewState.IsStateUpdating || ClientServerCartViewService.ViewState.PromoCodeViewState.IsLoading)"
                        LeftSVGIcon="Icons.Trash3_Client"
                        @onclick="@(() => ClientServerCartViewService.RemovePromoCode())" />
            }
            @if (ClientServerCartViewService.ViewState.PromoCodeStatus != Web.Api.Models.PromoCodeApplyStatus.None)
            {
                <div class="@GetPromocodeStatusClass(ClientServerCartViewService.ViewState.PromoCodeStatus)">@ClientServerCartViewService.ViewState.PromoCodeStatus.ToString()</div>
            }
        </div>
        <div class="giz-order-summary">
            <div class="giz-order-summary-text-bold">@LocalizationService.GetString("GIZ_SHOP_SUBTOTAL")</div>

            <div class="giz-order-summary-total">
                <ICartViewStateLoader ViewState="@ClientServerCartViewService.ViewState" MinimumHeight="3.0rem">
                    <div class="giz-order-summary-total-content">
                        <span>@ClientServerCartViewService.ViewState.Total.ToString("C", CultureInfo.CurrentCulture)</span>
                        @if (ClientServerCartViewService.ViewState.PointsTotal > 0)
                        {
                            <span class="giz-order-summary-number-separator">&amp;</span>
                            <span>@(ClientServerCartViewService.ViewState.PointsTotal)</span>
                            <Points2Icon />
                        }
                    </div>
                </ICartViewStateLoader>
            </div>

            <div class="giz-order-summary-text">@LocalizationService.GetString("GIZ_SHOP_EARNED_POINTS")</div>
            <div class="giz-order-summary-points-award">
                <ICartViewStateLoader ViewState="@ClientServerCartViewService.ViewState" MinimumHeight="2.2rem">
                    <div class="giz-order-summary-points-award-content">
                        <span>@ClientServerCartViewService.ViewState.PointsAward</span>
                        <PointsAward2Icon />
                    </div>
                </ICartViewStateLoader>
            </div>
        </div>
        <div>
            <Button Color="ButtonColors.Accent"
                    Size="ButtonSizes.Large"
                    IsFullWidth="true"
                    IsDisabled="@(ClientServerCartViewService.ViewState.IsStateUpdateRequired || ClientServerCartViewService.ViewState.IsStateUpdating || ClientServerCartViewService.ViewState.Products.Count() == 0)"
                    Text="@LocalizationService.GetString("GIZ_SHOP_PLACE_ORDER")"
                    @onclick="@(() => Service.SubmitAsync())" />
        </div>
    </div>
</div>
