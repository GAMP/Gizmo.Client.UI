@namespace Gizmo.Client.UI.Components
@inherits CustomDOMComponentBase
@using System.Globalization

<div class="giz-product-card product"
     @onclick="OpenDetails">
    <div class="giz-product-card__content">

        @* Wrapper establishes the positioning context for the hover overlay
           below, so it covers exactly the image+details area (whatever
           height that naturally is) without contributing to grid track
           sizing (position:absolute is excluded from sizing entirely,
           unlike a plain grid item, which was the previous approach and
           inflated the card height with the hidden panel's own content
           size). The footer/button sits outside this wrapper and stays
           untouched. *@
        <div class="giz-product-card__content__top">
            <div class="giz-product-card__content__image" @onmouseover="OnVisibleImageContent">
                <GizImage @key="Product.Id" ImageType="Gizmo.UI.ImageType.ProductDefault" ImageId="@Product.DefaultImageId" ImageFitType="ImageFitType.Cover">
                    <EmptyResultPlaceholder>
                        <div class="giz-default-image">
                            <img src="_content/Gizmo.Client.UI/img/no-product-image.svg" alt='loading' />
                        </div>
                    </EmptyResultPlaceholder>
                    <ErrorPlaceholder>
                        <div class="giz-default-image">
                            <img src="_content/Gizmo.Client.UI/img/broken-image.svg" alt='loading' />
                        </div>
                    </ErrorPlaceholder>
                </GizImage>

            </div>

            <div class="giz-product-card__content__details">
                <div class="giz-product-card__price">
                    <ProductCardPrice @key="Product.Id" Product="@Product" />
                </div>
                <div class="giz-product-card__title">
                    @Product.Name
                </div>
                <div class="giz-product-card__host-group">
                </div>
            </div>

            <div class="giz-product-card__hover-overlay">
                <div class="giz-product-card__content--hovered">
                    <ProductSimpleCardHover @key="Product.Id" Product="@Product" />
                </div>

                <div class="giz-product-card-award-indicator">
                    @if (Product.UnitPointsAward > 0)
                    {
                        <PointsAward2Icon />
                    }
                </div>
            </div>
        </div>

        <div class="giz-product-card__content__footer">
            <ProductQuantityPicker @key="Product.Id" ProductId="@Product.Id" OnClick="@Ignore" />
        </div>
    </div>
</div>