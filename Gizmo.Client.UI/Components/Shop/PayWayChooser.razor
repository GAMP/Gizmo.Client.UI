@namespace Gizmo.Client.UI.Components
@inherits ComponentBase

@* The pay chooser shared by the purchase and checkout dialogs: one control with two or
   three cells, chips under it when several counter methods share a cell, and a plain
   line when there is only one way to pay. Styling is in _package-purchase-dialog.scss;
   the markup is mirrored by visual/templates/purchase.js. *@

@if (Single is not null)
{
    <div class="giz-buy__way-line">
        <span class="giz-buy__cap">@Caption</span>
        <span class="giz-buy__way-line-name">@Single.Name</span>
        <span class="giz-buy__way-line-note">@SingleNote</span>
    </div>
}
else if (Segments is { Count: > 0 })
{
    <section class="giz-buy__ways" aria-label="@Caption">
        <div class="giz-buy__cap">@Caption</div>
        <div class="giz-buy__seg">
            @foreach (var segment in Segments)
            {
                <button type="button" @key="segment.Kind"
                        class="giz-buy__seg-item @(segment.IsOn ? "is-on" : null) @(segment.IsShort ? "is-short" : null)"
                        disabled="@Disabled"
                        @onclick="@(() => OnSegment.InvokeAsync(segment))">
                    <span class="giz-buy__seg-name">@segment.Name</span>
                    <span class="giz-buy__seg-note">
                        @segment.Note
                        @if (segment.NoteIsPoints)
                        {
                            <i class="ph-fill ph-coins"></i>
                        }
                    </span>
                </button>
            }
        </div>
        @if (ShowChips)
        {
            @* Which of the counter methods: the club's own names, as chips. *@
            <div class="giz-buy__chips">
                @foreach (var way in Chips)
                {
                    <button type="button" @key="way"
                            class="giz-buy__chip @(way == Selected ? "is-on" : null)"
                            disabled="@Disabled"
                            @onclick="@(() => OnWay.InvokeAsync(way))">@way.Name</button>
                }
            </div>
        }
    </section>
}

@code {
    [Parameter] public string Caption { get; set; }
    [Parameter] public IReadOnlyList<PaySegment> Segments { get; set; }
    [Parameter] public IEnumerable<PayWay> Chips { get; set; } = System.Array.Empty<PayWay>();
    [Parameter] public bool ShowChips { get; set; }
    [Parameter] public PayWay Selected { get; set; }
    [Parameter] public PayWay Single { get; set; }
    [Parameter] public string SingleNote { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<PaySegment> OnSegment { get; set; }
    [Parameter] public EventCallback<PayWay> OnWay { get; set; }
}
