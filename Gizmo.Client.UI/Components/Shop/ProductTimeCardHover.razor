@namespace Gizmo.Client.UI.Components
@inherits CustomDOMComponentBase

@if (Product != null)
{
    <div class="giz-peek giz-peek--time">
        <div class="giz-peek__name">@Product.Name</div>
        <div class="giz-peek__amount">
            <b>@TimeNumber</b>
            <span>@TimeUnit</span>
        </div>
        @if (PlaySegments.Count > 0)
        {
            <div class="giz-peek__block">
                <div class="giz-peek__cap"><span>@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_PEEK_PLAY)</span>@if (PlayWindow is { Length: > 0 } playWindow){<b>@playWindow</b>}</div>
                <div class="giz-peek__day">
                    @foreach (var segment in PlaySegments)
                    {
                        <span class="giz-peek__day-on" style="--giz-peek-from: @segment.Left; --giz-peek-span: @segment.Width"></span>
                    }
                </div>
            </div>
        }
        @if (BuyWeek.Count > 0)
        {
            <div class="giz-peek__block">
                <div class="giz-peek__cap"><span>@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_PEEK_BUY)</span>@if (BuyWindow is { Length: > 0 } buyWindow){<b>@buyWindow</b>}</div>
                <div class="giz-peek__week">
                    @foreach (var day in BuyWeek)
                    {
                        <span class="@DayClass(day)">@day.Name</span>
                    }
                </div>
            </div>
        }
        <div class="giz-peek__facts">
            @if (ExpiryText is { Length: > 0 } expiry)
            {
                <div class="giz-peek__fact">
                    <i class="ph-bold ph-hourglass-medium"></i>
                    <span>@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_PEEK_EXPIRES)</span>
                    <b>@expiry</b>
                </div>
            }
            <div class="giz-peek__fact giz-peek__fact--groups">
                <i class="ph-bold ph-desktop"></i>
                <ProductTimeHostGroups @key="Product.Id" Product="@Product" />
            </div>
        </div>
    </div>
}
