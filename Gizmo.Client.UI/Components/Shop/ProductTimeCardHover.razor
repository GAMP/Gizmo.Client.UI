@namespace Gizmo.Client.UI.Components
@inherits CustomDOMComponentBase

@if (Product != null)
{
    <div class="giz-peek">
        <div class="giz-peek__name">@Product.Name</div>
        @if (HasDescription)
        {
            <p class="giz-peek__about">@Product.Description</p>
        }
        <div class="giz-peek__facts">
            <div class="giz-peek__fact">
                <i class="ph-bold ph-timer"></i>
                <span class="giz-peek__text">
                    <small>@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_PEEK_DURATION)</small>
                    <b>@GetTimeText()</b>
                </span>
            </div>
            @if (BuyWindow is { Length: > 0 } buyWindow)
            {
                <div class="giz-peek__fact">
                    <i class="ph-bold ph-shopping-bag"></i>
                    <span class="giz-peek__text">
                        <small>@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_PEEK_BUY)</small>
                        <b>@buyWindow</b>
                    </span>
                </div>
            }
            @if (PlayWindow is { Length: > 0 } playWindow)
            {
                <div class="giz-peek__fact">
                    <i class="ph-bold ph-game-controller"></i>
                    <span class="giz-peek__text">
                        <small>@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_PEEK_PLAY)</small>
                        <b>@playWindow</b>
                    </span>
                </div>
            }
            @if (ExpiryText is { Length: > 0 } expiry)
            {
                <div class="giz-peek__fact">
                    <i class="ph-bold ph-hourglass-medium"></i>
                    <span class="giz-peek__text">
                        <small>@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_PEEK_EXPIRES)</small>
                        <b>@expiry</b>
                    </span>
                </div>
            }
        </div>
    </div>
}
