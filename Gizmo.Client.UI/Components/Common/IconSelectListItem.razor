@namespace Gizmo.Client.UI.Components
@inherits CustomDOMComponentBase

<ListItem OnClick="@((args) => OnClick.InvokeAsync(args))">
    <div class="giz-icon-select-item">
        <div class="giz-icon-select-item__icon">
            @if (!string.IsNullOrEmpty(Item.Icon) && (Item.Icon.StartsWith("http") || Item.Icon.StartsWith("/") || Item.Icon.StartsWith("_content")))
            {
                <img src="@Item.Icon" />
            }
            else if (!string.IsNullOrEmpty(Item.Icon))
            {
                <span class="giz-icon-select-flag">@Item.Icon</span>
            }
        </div>
        <div class="giz-icon-select-item__display">@($"{Item.Display}")</div>
    </div>
</ListItem>