@namespace Gizmo.Client.UI.Components
@inherits CustomDOMComponentBase
@using Gizmo.Client.UI.View;

<div class="giz-dock-item-tooltip">
    <div class="giz-dock-item-tooltip__cover">
        <GizImage @key="CoverKey" ImageType="Gizmo.UI.ImageType.Application" ImageId="@CoverImageId" ImageFitType="ImageFitType.Cover">
            <EmptyResultPlaceholder>
                <div class="giz-default-image">
                    <GizCoverPlaceholder />
                </div>
            </EmptyResultPlaceholder>
            <ErrorPlaceholder>
                <div class="giz-default-image">
                    <GizCoverPlaceholder />
                </div>
            </ErrorPlaceholder>
        </GizImage>
    </div>
    <div class="giz-dock-item-tooltip__body">
        <div class="giz-dock-item-tooltip__name">@Executable?.Caption</div>
        <button type="button" class="giz-dock-item-tooltip__details" @onclick="OnClickDetailsButtonHandle">
            <span>@DetailsLabel</span>
            <i class="ph-bold ph-arrow-right"></i>
        </button>
    </div>
</div>
