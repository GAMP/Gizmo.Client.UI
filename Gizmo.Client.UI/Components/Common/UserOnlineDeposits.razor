@namespace Gizmo.Client.UI.Components
@inherits ShellComponentBase
@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms

<div class="giz-user-online-deposit">
    @if (_paymentSucceeded)
    {
        <div class="giz-user-online-deposit__success">
            <div class="giz-user-online-deposit__success__countdown">
                <div class="giz-user-online-deposit__success__countdown__fill"></div>
            </div>
            <div class="giz-user-online-deposit__success__icon">
                <i class="ph-fill ph-check-circle"></i>
            </div>
            <div class="giz-user-online-deposit__success__title">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_DEPOSIT_SUCCESS_TITLE)</div>
            <div class="giz-user-online-deposit__success__text">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_DEPOSIT_SUCCESS_TEXT, SucceededAmountFormatted)</div>
            <div class="giz-user-online-deposit__success__hint">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_DEPOSIT_SUCCESS_HINT)</div>
        </div>
    }
    else if (ViewState.PageIndex == 0)
    {
        <div class="giz-user-online-deposit__body">
            <div class="giz-user-online-deposit__amount">
                <span class="giz-user-online-deposit__amount-value">@AmountText</span>
                <span class="giz-user-online-deposit__amount-note">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_TOPUP_CREDIT)</span>
            </div>
            @if (ViewState.Presets.Any())
            {
                <div class="giz-user-online-deposit__presets">
                    @foreach (var preset in ViewState.Presets)
                    {
                        <button type="button" class="@PresetClass(preset)" aria-pressed="@PresetPressed(preset)" @onclick="@(() => UserOnlineDepositViewStateService.SelectPreset(preset))">@Money(preset)</button>
                    }
                </div>
            }
            @if (ViewState.AllowCustomValue)
            {
                <EditForm EditContext="@UserOnlineDepositViewStateService.EditContext">
                    <div class="giz-user-online-deposit__custom">
                        <i class="ph-bold ph-pencil-simple"></i>
                        <TextInput IsTransparent="true"
                                   Size="InputSizes.Small"
                                   IsFullWidth="true"
                                   UpdateOnInput="true"
                                   TValue="decimal?"
                                   Value="@ViewState.Amount"
                                   ValueChanged="@((value) => UserOnlineDepositViewStateService.SetAmount(value))"
                                   ValueExpression="@(() => ViewState.Amount)"
                                   Placeholder="@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_ONLINE_DEPOSIT_OR_ENTER_AMOUNT))" />
                    </div>
                </EditForm>
            }
        </div>
        <div class="giz-user-online-deposit__footer">
            <button type="button" class="giz-user-online-deposit__primary" disabled="@IsSubmitDisabled" @onclick="@(() => UserOnlineDepositViewStateService.SubmitAsync())">
                @if (ViewState.IsLoading)
                {
                    <span class="giz-loader giz-loader--small"></span>
                }
                else
                {
                    <span>@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_ONLINE_DEPOSIT_TITLE))</span>
                }
            </button>
        </div>
    }
    else if (_paymentFailed)
    {
        <div class="giz-user-online-deposit__failed">
            <div class="giz-user-online-deposit__failed__icon">
                <i class="ph-fill ph-x-circle"></i>
            </div>
            <div class="giz-user-online-deposit__failed__title">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_DEPOSIT_FAILED_TITLE)</div>
            <div class="giz-user-online-deposit__failed__text">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_DEPOSIT_FAILED_TEXT)</div>
        </div>
        <div class="giz-user-online-deposit__footer">
            <button type="button" class="giz-user-online-deposit__primary" @onclick="OnClickClearHandler">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_DEPOSIT_RETRY)</button>
        </div>
    }
    else
    {
        <div class="giz-user-online-deposit__body">
            <div class="giz-user-online-deposit__amount">
                <span class="giz-user-online-deposit__amount-value">@AmountText</span>
                <span class="giz-user-online-deposit__amount-note">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_TOPUP_TO_PAY)</span>
            </div>
            <div class="giz-user-online-deposit__qr">
                <div class="giz-user-online-deposit__qr-code">@((MarkupString)ViewState.QrImage)</div>
                <span class="giz-user-online-deposit__qr-hint">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_TOPUP_QR_HINT)</span>
            </div>
        </div>
        <div class="giz-user-online-deposit__footer">
            <button type="button" class="giz-user-online-deposit__secondary" @onclick="OnClickPayFromPCHandler">@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_ONLINE_DEPOSIT_PAY_FROM_PC))</button>
            <button type="button" class="giz-user-online-deposit__quiet" @onclick="OnClickClearHandler">@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_ONLINE_DEPOSIT_CLEAR))</button>
        </div>
    }
</div>