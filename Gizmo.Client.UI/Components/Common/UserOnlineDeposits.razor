@namespace Gizmo.Client.UI.Components
@inherits CustomDOMComponentBase
@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms

<div class="giz-user-online-deposit">
    @if (_paymentSucceeded)
    {
        @* Detected by watching the live balance figure catch up to what
           was submitted - see UserOnlineDeposits.razor.cs. Self-closing:
           the host is told via OnPaymentSucceeded once this has been on
           screen long enough to read. *@
        <div class="giz-user-online-deposit__success">
            <div class="giz-user-online-deposit__success__countdown">
                <div class="giz-user-online-deposit__success__countdown__fill"></div>
            </div>
            <div class="giz-user-online-deposit__success__icon">
                <i class="ph-fill ph-check-circle"></i>
            </div>
            <div class="giz-user-online-deposit__success__title">Успешно</div>
            <div class="giz-user-online-deposit__success__text">Счёт пополнен на @SucceededAmountFormatted</div>
            <div class="giz-user-online-deposit__success__hint">Окно закроется автоматически через 5 секунд</div>
        </div>
    }
    else if (ViewState.PageIndex == 0)
    {
        @* Russian written inline - see the note in
           MenuActiveApplicationsContainer.razor for why not resource keys. *@
        <div class="giz-user-online-deposit__body">
            <div class="giz-user-online-deposit__label">Выберите сумму</div>
            <div>
                <ButtonGroup>
                    @foreach (var preset in ViewState.Presets)
                    {
                        <Button Size="ButtonSizes.Large" Name="@preset.ToString()" IsSelected="@(@preset == ViewState.Amount)" @onclick="@(() => UserOnlineDepositViewStateService.SelectPreset(@preset))">@preset.ToString("C", CultureInfo.CurrentCulture)</Button>
                    }
                </ButtonGroup>
            </div>
            @if (ViewState.AllowCustomValue)
            {
                <EditForm EditContext="@UserOnlineDepositViewStateService.EditContext">
                    <div>
                        <TextInput IsTransparent="true"
                                    Size="InputSizes.Small"
                                    IsFullWidth="true"
                                    UpdateOnInput="true"
                                    TValue="decimal?"
                                    Value="@ViewState.Amount"
                                    ValueChanged="@((value) => UserOnlineDepositViewStateService.SetAmount(value))"
                                    ValueExpression="@(() => ViewState.Amount)"
                                    Label="Или впишите свою" />
                    </div>
                </EditForm>
            }
            <div class="giz-user-online-deposit__summary">Зачислим на счёт <span class="giz-user-online-deposit__summary__amount">@((ViewState.Amount ?? 0).ToString("C", CultureInfo.CurrentCulture))</span></div>
        </div>
        <div class="giz-user-online-deposit__footer">
            <Button IsDisabled="@(ViewState.IsValid == false || ViewState.IsLoading)"
                    Color="ButtonColors.Accent"
                    Size="ButtonSizes.ExtraLarge"
                    IsFullWidth="true"
                    @onclick="@(() => UserOnlineDepositViewStateService.SubmitAsync())">
                <ChildContent>
                    @if (ViewState.IsLoading)
                    {
                        <Spinner />
                    }
                    else
                    {
                        <div>Пополнить</div>
                    }
                </ChildContent>
            </Button>
        </div>
    }
    else
    {
        <div class="giz-user-online-deposit__body">
            <div class="giz-user-online-deposit__submitted__summary">К оплате <span class="giz-user-online-deposit__submitted__summary__amount">@((ViewState.Amount ?? 0).ToString("C", CultureInfo.CurrentCulture))</span></div>
            <div class="giz-user-online-deposit__submitted__qr">
                <div class="giz-user-online-deposit__submitted__qr__label">Наведите камеру телефона</div>
                <div class="giz-user-online-deposit__submitted__qr__image">
                    @((MarkupString)ViewState.QrImage)
                </div>
            </div>
        </div>
        <div class="giz-user-online-deposit__footer">
            <div class="giz-user-online-deposit__submitted__action">
                <div class="giz-user-online-deposit__submitted__action__label">или</div>
                <Button Color="ButtonColors.Accent" Size="ButtonSizes.ExtraLarge" IsFullWidth="true" @onclick="OnClickPayFromPCHandler">Открыть в браузере</Button>
            </div>
            <div class="giz-user-online-deposit-clear-button">
                <Button Variant="ButtonVariants.Outline" Size="ButtonSizes.ExtraLarge" IsFullWidth="true" @onclick="OnClickClearHandler">Сбросить QR</Button>
            </div>
        </div>
    }
</div>