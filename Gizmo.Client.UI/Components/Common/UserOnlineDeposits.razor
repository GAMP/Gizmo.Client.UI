@namespace Gizmo.Client.UI.Components
@inherits ShellComponentBase
@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms

<div class="@ClassName">
    @if (_paymentSucceeded)
    {
        <span class="giz-user-online-deposit__countdown"><span class="giz-user-online-deposit__countdown-fill"></span></span>
        <CartDialogResult Ok="true"
                          Title="@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_DEPOSIT_SUCCESS_TEXT, SucceededAmountFormatted)"
                          OnClose="@FinishNowAsync" />
    }
    else if (_paymentFailed)
    {
        <CartDialogResult Ok="false"
                          Title="@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_DEPOSIT_FAILED_TITLE)"
                          ActionText="@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_DEPOSIT_RETRY)"
                          OnClose="@RetryAsync" />
    }
    else if (ViewState.PageIndex == 0)
    {
        @Head
        <div class="giz-user-online-deposit__step" @key="@("amount")">
            <div class="giz-user-online-deposit__field">
                <div class="giz-buy__cap">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_TOPUP_AMOUNT_LABEL)</div>
                @if (ViewState.AllowCustomValue)
                {
                    <EditForm EditContext="@UserOnlineDepositViewStateService.EditContext">
                        <label class="giz-user-online-deposit__amount">
                            @if (CurrencyFirst)
                            {
                                <span class="giz-user-online-deposit__currency">@CurrencySymbol</span>
                            }
                            <TextInput IsTransparent="true"
                                       Size="InputSizes.Small"
                                       UpdateOnInput="true"
                                       TValue="decimal?"
                                       Value="@ViewState.Amount"
                                       ValueChanged="@((value) => UserOnlineDepositViewStateService.SetAmount(value))"
                                       ValueExpression="@(() => ViewState.Amount)"
                                       Placeholder="0" />
                            @if (!CurrencyFirst)
                            {
                                <span class="giz-user-online-deposit__currency">@CurrencySymbol</span>
                            }
                        </label>
                    </EditForm>
                }
                else
                {
                    <div class="giz-user-online-deposit__amount giz-user-online-deposit__amount--fixed">@AmountText</div>
                }
                @if (AmountNote is { Length: > 0 } note)
                {
                    <div class="giz-user-online-deposit__note">@note</div>
                }
            </div>
            @if (ViewState.Presets.Any())
            {
                <div class="giz-user-online-deposit__presets">
                    @foreach (var preset in ViewState.Presets)
                    {
                        <button type="button" class="@PresetClass(preset)" aria-pressed="@PresetPressed(preset)" @onclick="@(() => UserOnlineDepositViewStateService.SelectPreset(preset))">@Money(preset)</button>
                    }
                </div>
            }
            @if (ViewState.HasError)
            {
                <div class="giz-user-online-deposit__error"><i class="ph-bold ph-warning-circle"></i><span>@ViewState.ErrorMessage</span></div>
            }
            <button type="button" class="@PayClass" disabled="@IsSubmitDisabled" @onclick="@(() => UserOnlineDepositViewStateService.SubmitAsync())">
                @if (ViewState.IsLoading)
                {
                    <span class="giz-loader giz-loader--small"></span>
                }
                else
                {
                    <span>@PayLabel</span>
                }
            </button>
        </div>
    }
    else
    {
        @Head
        <div class="giz-user-online-deposit__step" @key="@("pay")">
            <div class="giz-user-online-deposit__pay">
                <div class="giz-user-online-deposit__qr">@((MarkupString)ViewState.QrImage)</div>
                <div class="giz-user-online-deposit__pay-info">
                    <span class="giz-buy__cap">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_TOPUP_TO_PAY)</span>
                    <span class="giz-user-online-deposit__pay-sum">@AmountText</span>
                    <span class="giz-user-online-deposit__waiting">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_TOPUP_WAITING)</span>
                </div>
            </div>
            <div class="giz-buy__actions">
                <button type="button" class="giz-buy__btn giz-user-online-deposit__quiet" @onclick="OnClickClearHandler">@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_ONLINE_DEPOSIT_CLEAR))</button>
                <button type="button" class="giz-buy__btn" @onclick="OnClickPayFromPCHandler">
                    <i class="ph-bold ph-desktop"></i>
                    <span>@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_ONLINE_DEPOSIT_PAY_FROM_PC))</span>
                </button>
            </div>
        </div>
    }
</div>
