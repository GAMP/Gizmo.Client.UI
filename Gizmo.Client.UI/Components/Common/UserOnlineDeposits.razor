@namespace Gizmo.Client.UI.Components
@inherits ShellComponentBase
@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms

<div class="@ClassName">
    @if (_paymentSucceeded)
    {
        <span class="giz-user-online-deposit__countdown"><span class="giz-user-online-deposit__countdown-fill"></span></span>
        <div class="giz-user-online-deposit__done">
            <div class="giz-user-online-deposit__done-sum">@SucceededSum</div>
            <div class="giz-user-online-deposit__done-title">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_DEPOSIT_DONE_TITLE)</div>
            <button type="button" class="giz-buy__btn giz-buy__btn--primary" @onclick="FinishNowAsync">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_GEN_DONE)</button>
        </div>
    }
    else if (_paymentFailed)
    {
        <CartDialogResult Ok="false"
                          Title="@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_DEPOSIT_FAILED_TITLE)"
                          ActionText="@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_DEPOSIT_RETRY)"
                          OnClose="@RetryAsync" />
    }
    else if (ViewState.PageIndex == 0)
    {
        @Head
        <div class="giz-user-online-deposit__step" @key="@("amount")">
            <div class="giz-user-online-deposit__figure">
                @if (HasPresets)
                {
                    <button type="button" class="giz-user-online-deposit__nudge" aria-label="@LessLabel" disabled="@StepDownDisabled" @onclick="StepDown">
                        <i class="ph-bold ph-minus"></i>
                    </button>
                }
                @if (ViewState.AllowCustomValue)
                {
                    <EditForm class="giz-user-online-deposit__form" EditContext="@UserOnlineDepositViewStateService.EditContext">
                        <label class="giz-user-online-deposit__amount">
                            @if (CurrencyFirst)
                            {
                                <span class="giz-user-online-deposit__currency">@CurrencySymbol</span>
                            }
                            <TextInput @ref="_amountInput"
                                       IsTransparent="true"
                                       Size="InputSizes.Small"
                                       UpdateOnInput="true"
                                       TValue="decimal?"
                                       Value="@ViewState.Amount"
                                       ValueChanged="@((value) => UserOnlineDepositViewStateService.SetAmount(value))"
                                       ValueExpression="@(() => ViewState.Amount)"
                                       Placeholder="0" />
                            @if (!CurrencyFirst)
                            {
                                <span class="giz-user-online-deposit__currency">@CurrencySymbol</span>
                            }
                        </label>
                    </EditForm>
                }
                else
                {
                    <div class="giz-user-online-deposit__amount giz-user-online-deposit__amount--fixed">@AmountText</div>
                }
                @if (HasPresets)
                {
                    <button type="button" class="giz-user-online-deposit__nudge" aria-label="@MoreLabel" disabled="@StepUpDisabled" @onclick="StepUp">
                        <i class="ph-bold ph-plus"></i>
                    </button>
                }
            </div>
            @if (AmountNote is { Length: > 0 } note)
            {
                <div class="@NoteClass">@note</div>
            }
            @if (HasPresets)
            {
                <div class="giz-user-online-deposit__rail" style="--giz-topup-fill: @FillText">
                    <span class="giz-user-online-deposit__track"><span class="giz-user-online-deposit__fill"></span></span>
                    @foreach (var stop in Stops)
                    {
                        <button type="button" class="@stop.ClassName" style="--giz-topup-stop: @stop.At" aria-pressed="@stop.Pressed" @onclick="@(() => UserOnlineDepositViewStateService.SelectPreset(stop.Value))">
                            <span class="giz-user-online-deposit__dot"></span>
                            <span class="giz-user-online-deposit__stop-label">@stop.Label</span>
                        </button>
                    }
                </div>
            }
            @if (ViewState.HasError)
            {
                <div class="giz-user-online-deposit__error"><i class="ph-bold ph-warning-circle"></i><span>@ViewState.ErrorMessage</span></div>
            }
            <button type="button" class="@PayClass" disabled="@IsSubmitDisabled" @onclick="@(() => UserOnlineDepositViewStateService.SubmitAsync())">
                @if (ViewState.IsLoading)
                {
                    <span class="giz-loader giz-loader--small"></span>
                }
                else
                {
                    <span>@PayLabel</span>
                }
            </button>
        </div>
    }
    else
    {
        @Head
        <div class="giz-user-online-deposit__step giz-user-online-deposit__step--pay" @key="@("pay")">
            <div class="giz-user-online-deposit__pay-sum">@AmountText</div>
            <button type="button" class="giz-user-online-deposit__change" @onclick="OnClickClearHandler">
                <i class="ph-bold ph-pencil-simple"></i>
                <span>@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_TOPUP_CHANGE_AMOUNT)</span>
            </button>
            <div class="giz-user-online-deposit__qr">@((MarkupString)ViewState.QrImage)</div>
            <button type="button" class="giz-buy__btn giz-user-online-deposit__from-pc" @onclick="OnClickPayFromPCHandler">
                <i class="ph-bold ph-arrow-square-out"></i>
                <span>@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_TOPUP_OPEN_BROWSER)</span>
            </button>
        </div>
    }
</div>
