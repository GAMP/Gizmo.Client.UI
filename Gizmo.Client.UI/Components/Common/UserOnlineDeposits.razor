@namespace Gizmo.Client.UI.Components
@inherits ShellComponentBase
@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms

<div class="giz-user-online-deposit">
    @if (_paymentSucceeded)
    {
        <div class="giz-user-online-deposit__success">
            <div class="giz-user-online-deposit__success__countdown">
                <div class="giz-user-online-deposit__success__countdown__fill"></div>
            </div>
            <div class="giz-user-online-deposit__success__icon">
                <i class="ph-fill ph-check-circle"></i>
            </div>
            <div class="giz-user-online-deposit__success__title">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_DEPOSIT_SUCCESS_TITLE)</div>
            <div class="giz-user-online-deposit__success__text">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_DEPOSIT_SUCCESS_TEXT, SucceededAmountFormatted)</div>
            <div class="giz-user-online-deposit__success__hint">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_DEPOSIT_SUCCESS_HINT)</div>
        </div>
    }
    else if (ViewState.PageIndex == 0)
    {
        <div class="giz-user-online-deposit__body">
            <div class="giz-user-online-deposit__label">@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_ONLINE_DEPOSIT_QUICK_SELECT))</div>
            <div>
                <ButtonGroup>
                    @foreach (var preset in ViewState.Presets)
                    {
                        <Button Size="ButtonSizes.Large" Name="@preset.ToString()" IsSelected="@(@preset == ViewState.Amount)" @onclick="@(() => UserOnlineDepositViewStateService.SelectPreset(@preset))">@preset.ToString("C", CultureInfo.CurrentCulture)</Button>
                    }
                </ButtonGroup>
            </div>
            @if (ViewState.AllowCustomValue)
            {
                <EditForm EditContext="@UserOnlineDepositViewStateService.EditContext">
                    <div>
                        <TextInput IsTransparent="true"
                                    Size="InputSizes.Small"
                                    IsFullWidth="true"
                                    UpdateOnInput="true"
                                    TValue="decimal?"
                                    Value="@ViewState.Amount"
                                    ValueChanged="@((value) => UserOnlineDepositViewStateService.SetAmount(value))"
                                    ValueExpression="@(() => ViewState.Amount)"
                                    Label="@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_ONLINE_DEPOSIT_OR_ENTER_AMOUNT))" />
                    </div>
                </EditForm>
            }
            <div class="giz-user-online-deposit__summary">@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_ONLINE_DEPOSIT_WILL_BE_CREDITED)) <span class="giz-user-online-deposit__summary__amount">@((ViewState.Amount ?? 0).ToString("C", CultureInfo.CurrentCulture))</span></div>
        </div>
        <div class="giz-user-online-deposit__footer">
            <Button IsDisabled="@(ViewState.IsValid == false || ViewState.IsLoading)"
                    Color="ButtonColors.Accent"
                    Size="ButtonSizes.ExtraLarge"
                    IsFullWidth="true"
                    @onclick="@(() => UserOnlineDepositViewStateService.SubmitAsync())">
                <ChildContent>
                    @if (ViewState.IsLoading)
                    {
                        <Spinner />
                    }
                    else
                    {
                        <div>@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_ONLINE_DEPOSIT_TITLE))</div>
                    }
                </ChildContent>
            </Button>
        </div>
    }
    else if (_paymentFailed)
    {
        <div class="giz-user-online-deposit__failed">
            <div class="giz-user-online-deposit__failed__icon">
                <i class="ph-fill ph-x-circle"></i>
            </div>
            <div class="giz-user-online-deposit__failed__title">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_DEPOSIT_FAILED_TITLE)</div>
            <div class="giz-user-online-deposit__failed__text">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_DEPOSIT_FAILED_TEXT)</div>
        </div>
        <div class="giz-user-online-deposit__footer">
            <Button Color="ButtonColors.Accent" Size="ButtonSizes.ExtraLarge" IsFullWidth="true" @onclick="OnClickClearHandler">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_DEPOSIT_RETRY)</Button>
        </div>
    }
    else
    {
        <div class="giz-user-online-deposit__body">
            <div class="giz-user-online-deposit__submitted__summary">@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_ONLINE_DEPOSIT_TO_BE_PAID)) <span class="giz-user-online-deposit__submitted__summary__amount">@((ViewState.Amount ?? 0).ToString("C", CultureInfo.CurrentCulture))</span></div>
            <div class="giz-user-online-deposit__submitted__qr">
                <div class="giz-user-online-deposit__submitted__qr__label">@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_ONLINE_DEPOSIT_QR_CODE))</div>
                <div class="giz-user-online-deposit__submitted__qr__image">
                    @((MarkupString)ViewState.QrImage)
                </div>
            </div>
        </div>
        <div class="giz-user-online-deposit__footer">
            <div class="giz-user-online-deposit__submitted__action">
                <div class="giz-user-online-deposit__submitted__action__label">@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_ONLINE_DEPOSIT_OR))</div>
                <Button Color="ButtonColors.Accent" Size="ButtonSizes.ExtraLarge" IsFullWidth="true" @onclick="OnClickPayFromPCHandler">@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_ONLINE_DEPOSIT_PAY_FROM_PC))</Button>
            </div>
            <div class="giz-user-online-deposit-clear-button">
                <Button Variant="ButtonVariants.Outline" Size="ButtonSizes.ExtraLarge" IsFullWidth="true" @onclick="OnClickClearHandler">@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_ONLINE_DEPOSIT_CLEAR))</Button>
            </div>
        </div>
    }
</div>