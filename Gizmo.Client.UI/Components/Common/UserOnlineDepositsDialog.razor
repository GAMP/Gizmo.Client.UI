@namespace Gizmo.Client.UI.Components
@inherits CustomDOMComponentBase

<HostedDialog>
    <div class="giz-buy giz-buy--topup" role="dialog" aria-label="@Title">
        <UserOnlineDeposits FocusAmount="true" OnClickPayFromPC="@OnClickPayFromPCHandler" OnClickClear="@OnClickClearHandler" OnPaymentSucceeded="@OnPaymentSucceededHandler">
            <Head>
                @if (DisplayOptions.Closable)
                {
                    <button type="button" class="giz-buy__close" aria-label="@CloseLabel" @onclick="@OnDismissHandler">
                        <i class="ph-bold ph-x"></i>
                    </button>
                }
            </Head>
        </UserOnlineDeposits>
    </div>
</HostedDialog>
