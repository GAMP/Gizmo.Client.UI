@namespace Gizmo.Client.UI.Components
@inherits CustomDOMComponentBase

<HostedDialog>
    <div class="giz-buy giz-buy--topup">
        <UserOnlineDeposits OnClickPayFromPC="@OnClickPayFromPCHandler" OnClickClear="@OnClickClearHandler" OnPaymentSucceeded="@OnPaymentSucceededHandler">
            <Head>
                <header class="giz-buy__head">
                    @if (DisplayOptions.Closable)
                    {
                        <button type="button" class="giz-buy__close" aria-label="@CloseLabel" @onclick="@OnDismissHandler">
                            <i class="ph-bold ph-x"></i>
                        </button>
                    }
                    <h2 class="giz-buy__title">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_TOPUP_TITLE)</h2>
                </header>
            </Head>
        </UserOnlineDeposits>
    </div>
</HostedDialog>
