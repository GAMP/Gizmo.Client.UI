@namespace Gizmo.Client.UI.Components
@inherits CustomDOMComponentBase

<HostedDialog>
    <div class="giz-tile-dialog giz-tile-dialog--topup">
        @if (DisplayOptions.Closable)
        {
            <button type="button" class="giz-tile-dialog__close" aria-label="@CloseLabel" @onclick="@OnDismissHandler">
                <i class="ph-bold ph-x"></i>
            </button>
        }
        <i class="ph-bold ph-wallet giz-tile-dialog__icon"></i>
        <h2 class="giz-tile-dialog__title">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_TOPUP_TITLE)</h2>
        <p class="giz-tile-dialog__text">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_TOPUP_HINT)</p>
        <div class="giz-tile-dialog__form">
            <UserOnlineDeposits OnClickPayFromPC="@OnClickPayFromPCHandler" OnClickClear="@OnClickClearHandler" OnPaymentSucceeded="@OnPaymentSucceededHandler" />
        </div>
    </div>
</HostedDialog>
