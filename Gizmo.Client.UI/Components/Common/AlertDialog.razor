@namespace Gizmo.Client.UI.Components
@inherits CustomDOMComponentBase

<HostedDialog>
    <div class="@DialogClass">
        @if (DisplayOptions.Closable)
        {
            <button type="button" class="giz-tile-dialog__close" aria-label="@CloseLabel" @onclick="@(() => CloseDialog(AlertDialogResultButton.None))">
                <i class="ph-bold ph-x"></i>
            </button>
        }
        <i class="@IconClass giz-tile-dialog__icon"></i>
        <h2 class="giz-tile-dialog__title">@((MarkupString)ShownTitle)</h2>
        @if (HasMessage)
        {
            <div class="giz-tile-dialog__text giz-scrollbar--v">@((MarkupString)ShownMessage)</div>
        }
        @if (Actions.Count > 0)
        {
            <div class="giz-tile-dialog__actions">
                @foreach (var action in Actions)
                {
                    <button type="button" class="@ActionClass(action)" @onclick="@(() => CloseDialog(action.Result))">@action.Text</button>
                }
            </div>
        }
    </div>
</HostedDialog>
