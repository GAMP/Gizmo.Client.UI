@namespace Gizmo.Client.UI.Components
@inherits CustomDOMComponentBase
@using Microsoft.AspNetCore.Components.Forms

<HostedDialog>
    <div class="@DialogClass">
        @if (CanIgnore)
        {
            <button type="button" class="giz-tile-dialog__close" aria-label="@CloseLabel" @onclick="Ignore">
                <i class="ph-bold ph-x"></i>
            </button>
        }
        <i class="@IconClass giz-tile-dialog__icon"></i>
        <h2 class="giz-tile-dialog__title">@Title</h2>

        <EditForm EditContext="@ConfirmReservationDialogViewService.EditContext">
            @if (Step == 0)
            {
                <p class="giz-tile-dialog__text">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_RESERVE_TEXT)</p>
                <div class="giz-tile-dialog__form">
                    <div class="giz-tile-dialog__field">
                        <span class="giz-tile-dialog__label">@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_RESERVATION_PIN_INPUT_LABEL))</span>
                        <div class="giz-tile-dialog__well giz-tile-dialog__well--code">
                            <PasswordInput UpdateOnInput="true"
                                           Value="@State.Pin"
                                           ValueChanged="@((string value) => ConfirmReservationDialogViewService.SetPin(value))"
                                           ValueExpression="@(() => State.Pin)"
                                           ValidateFunction="@SetInputPasswordCharacterIsValid"
                                           IsPasswordVisible="true"
                                           ShowRevealButton="false"
                                           IsDisabled="@State.IsLoading"
                                           Size="InputSizes.Medium"
                                           IsFullWidth="true"
                                           IsTransparent="true" />
                        </div>
                    </div>
                </div>
                @if (HasError)
                {
                    <p class="giz-tile-dialog__error"><i class="ph-bold ph-warning-circle"></i><span>@State.ErrorMessage</span></p>
                }
                <div class="giz-tile-dialog__actions">
                    <button type="button" class="giz-tile-dialog__button giz-tile-dialog__button--primary" disabled="@IsConfirmDisabled" @onclick="ConfirmReservationDialogViewService.ConfirmAsync">
                        @if (State.IsLoading)
                        {
                            <span class="giz-loader giz-loader--small"></span>
                        }
                        else
                        {
                            <span>@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_CONFIRM))</span>
                        }
                    </button>
                </div>
            }
            else if (Step == 1)
            {
                <div class="giz-tile-dialog__facts">
                    @if (HasReservationTime)
                    {
                        <div class="giz-tile-dialog__fact"><i class="ph-bold ph-clock"></i><span>@ReservationTime</span></div>
                    }
                    @foreach (var host in HostReservationViewState.Hosts)
                    {
                        <div class="giz-tile-dialog__fact"><i class="ph-bold ph-desktop"></i><span>@HostLabel(host)</span></div>
                    }
                </div>
                <div class="giz-tile-dialog__sum">
                    <div class="giz-tile-dialog__row"><span>@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_CONFIRM_RESERVATION_DIALOG_PAYMENT_STEP_TOTAL_LABEL))</span><b>@TotalText</b></div>
                    <div class="giz-tile-dialog__row"><span>@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_CONFIRM_RESERVATION_DIALOG_PAYMENT_STEP_PAID_LABEL))</span><b>@PaidText</b></div>
                    <div class="giz-tile-dialog__row giz-tile-dialog__row--due"><span>@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_CONFIRM_RESERVATION_DIALOG_PAYMENT_STEP_TO_BE_PAID_LABEL))</span><b>@OutstandingText</b></div>
                </div>
                @if (!HasPaymentMethods)
                {
                    <p class="giz-tile-dialog__text">@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_CONFIRM_RESERVATION_DIALOG_PAYMENT_STEP_NO_PAYMENT_METHODS_MESSAGE))</p>
                }
                else
                {
                    <div class="giz-tile-dialog__form">
                        <div class="giz-tile-dialog__field">
                            <span class="giz-tile-dialog__label">@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_CONFIRM_RESERVATION_DIALOG_PAYMENT_STEP_PAYMENT_METHOD_INPUT_LABEL))</span>
                            <div class="giz-tile-dialog__well">
                                <Select IsDisabled="@IsMethodLocked"
                                        IsTransparent="true"
                                        HandleSVGIcon="Icons.Select_Client"
                                        TValue="int?"
                                        Value="@State.PaymentMethodId"
                                        ValueChanged="@ConfirmReservationDialogViewService.SetPaymentMethodId"
                                        ValueExpression="@(() => State.PaymentMethodId)"
                                        Size="InputSizes.Small"
                                        IsFullWidth="true"
                                        OpenDirection="PopupOpenDirections.Cursor"
                                        PopupClass="giz-scrollbar--v">
                                    @foreach (var paymentMethod in State.AvailablePaymentMethods)
                                    {
                                        <SelectItem TValue="int?" Value="@paymentMethod.Id">@paymentMethod.Name</SelectItem>
                                    }
                                </Select>
                            </div>
                        </div>
                    </div>
                    @if (IsDepositMethod)
                    {
                        <div class="giz-tile-dialog__sum">
                            <div class="giz-tile-dialog__row"><span>@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_RESERVATION_AVAILABLE_DEPOSITS_LABEL))</span><b>@BalanceText</b></div>
                        </div>
                        @if (IsBalanceShort)
                        {
                            <p class="giz-tile-dialog__error"><i class="ph-bold ph-warning-circle"></i><span>@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_CONFIRM_RESERVATION_DIALOG_DEPOSITS_NOT_ENOUGH_MESSAGE))</span></p>
                        }
                    }
                    else if (State.HasQr)
                    {
                        <div class="giz-tile-dialog__qr">
                            <div class="giz-tile-dialog__qr-code">@((MarkupString)State.QRCode)</div>
                            <p class="giz-tile-dialog__text">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_RESERVE_QR)</p>
                        </div>
                    }
                    @if (HasError)
                    {
                        <p class="giz-tile-dialog__error"><i class="ph-bold ph-warning-circle"></i><span>@State.ErrorMessage</span></p>
                    }
                    <div class="giz-tile-dialog__actions">
                        <button type="button" class="giz-tile-dialog__button giz-tile-dialog__button--primary" disabled="@IsPayDisabled" @onclick="ConfirmReservationDialogViewService.PayAsync">
                            @if (State.IsLoading)
                            {
                                <span class="giz-loader giz-loader--small"></span>
                            }
                            else
                            {
                                <span>@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_CONFIRM_RESERVATION_DIALOG_PAY_BUTTON))</span>
                            }
                        </button>
                    </div>
                }
                <p class="giz-tile-dialog__note">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_RESERVE_AT_DESK)</p>
            }
            else
            {
                <div class="giz-tile-dialog__actions">
                    <button type="button" class="giz-tile-dialog__button giz-tile-dialog__button--primary" @onclick="Close">@CloseLabel</button>
                </div>
            }
        </EditForm>
    </div>
</HostedDialog>
