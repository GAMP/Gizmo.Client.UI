@namespace Gizmo.Client.UI.Components
@inherits CustomDOMComponentBase

<div class="giz-app-filters">
    <div class="giz-app-filters__top">
        @if (HasSearch)
        {
            <div class="giz-app-filters__search">
                <span class="giz-app-filters__search-label">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_RESULTS_FOR))</span>
                <button type="button" class="giz-app-filters__search-chip" @onclick="@(() => AppsPageService.ClearSearchPattern())">
                    <span>@ViewState.SearchPattern</span>
                    <i class="ph-bold ph-x"></i>
                </button>
            </div>
        }
        else
        {
            <div class="giz-app-filters__title">@Heading</div>
        }

        <div class="giz-app-filters__sort">
            @foreach (var option in ViewState.SortingOptions)
            {
                <button type="button" class="@SortClass(option.Value)" @onclick="@(() => AppsPageService.SetSelectedSortingOption(option.Value))">@option.DisplayName</button>
            }
        </div>
    </div>

    @if (HasRow)
    {
        <div class="giz-app-filters__row">
            @if (ViewState.AppCategories.Any())
            {
                <button type="button" class="@CategoryClass(null)" @onclick="@(() => AppsPageService.SetSelectedApplicationCategory(null))">@AllText</button>
                @foreach (var category in ViewState.AppCategories)
                {
                    <button type="button" class="@CategoryClass(category.AppCategoryId)" @onclick="@(() => AppsPageService.SetSelectedApplicationCategory(category.AppCategoryId))">@category.Name</button>
                }
            }

            @if (ViewState.ExecutableModes.Any())
            {
                <span class="giz-app-filters__divider"></span>
                @foreach (var mode in ViewState.ExecutableModes)
                {
                    <button type="button" class="@ModeClass(mode.Value)" aria-pressed="@ModePressed(mode.Value)" @onclick="@(() => ToggleMode(mode.Value))">
                        <i class="@ModeIcon(mode.Value)"></i>
                        <span>@mode.DisplayName</span>
                    </button>
                }
            }

            @if (ViewState.TotalFilters > 0)
            {
                <button type="button" class="giz-app-filters__reset" @onclick="@(() => AppsPageService.ClearAllFilters())">
                    <i class="ph-bold ph-arrow-counter-clockwise"></i>
                    <span>@ResetText</span>
                </button>
            }
        </div>
    }
</div>
