@namespace Gizmo.Client.UI.Components
@inherits CustomDOMComponentBase
@using Gizmo.Client.UI.View;

<div class="giz-universal-executable-progress-bar">
    @if (_appExeExecutionViewState.IsActive)
    {
        @if (_appExeExecutionViewState.IsIndeterminate)
        {
            <svg class="giz-universal-executable-progress-bar__ring giz-universal-executable-progress-bar__ring--spin" viewBox="0 0 48 48" role="progressbar">
                <circle class="giz-universal-executable-progress-bar__track" cx="24" cy="24" r="22" />
                <circle class="giz-universal-executable-progress-bar__arc" cx="24" cy="24" r="22" pathLength="100" />
            </svg>
        }
        else
        {
            <svg class="giz-universal-executable-progress-bar__ring" viewBox="0 0 48 48" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@ProgressValue" style="--giz-ring-progress: @ProgressValue">
                <circle class="giz-universal-executable-progress-bar__track" cx="24" cy="24" r="22" />
                <circle class="giz-universal-executable-progress-bar__arc" cx="24" cy="24" r="22" pathLength="100" />
            </svg>
        }
    }
    else if (_appExeExecutionViewState.IsRunning)
    {
        <svg class="running giz-universal-executable-progress-bar__ring giz-universal-executable-progress-bar__ring--running" viewBox="0 0 48 48">
            <circle class="giz-universal-executable-progress-bar__arc" cx="24" cy="24" r="22" pathLength="100" />
        </svg>
    }
</div>
