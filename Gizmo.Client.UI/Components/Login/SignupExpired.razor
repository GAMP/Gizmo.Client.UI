@namespace Gizmo.Client.UI.Components
@inherits CustomDOMComponentBase

<div class="giz-signin__note giz-signin__note--error">
    <i class="ph-bold ph-clock-countdown"></i>
    <span>@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_SIGNUP_EXPIRED)</span>
</div>
<div class="giz-signin__actions">
    <button type="button" class="giz-signin__button giz-signin__button--primary" @onclick="OnVerifyAgain">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_SIGNUP_VERIFY_AGAIN)</button>
</div>
