@namespace Gizmo.Client.UI.Components
@inherits ShellComponentBase

<div class="@ClassName">
    @if (Aside is not null)
    {
        <aside class="giz-login-card__stage">
            @Aside
        </aside>
    }
    <div class="giz-login-card__panel">
        <div class="giz-login-card__header">
            @CardHeader
        </div>
        <div class="giz-login-card__body">
            @CardBody
        </div>
        <div class="giz-login-card__footer">
            @CardFooter
        </div>
    </div>
</div>
