@namespace Gizmo.Client.UI.Components
@inherits CustomDOMComponentBase

<div class="@ClassName">
    <i class="ph-fill ph-calendar-check giz-login-reserved__icon"></i>
    <div class="giz-login-reserved__text">
        <div class="giz-login-reserved__title">
            <span>@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_RESV_DEVICE_RESERVED)</span>
            @if (!string.IsNullOrWhiteSpace(Time))
            {
                <span class="giz-login-reserved__time">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_RESV_FROM, Time)</span>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <div class="giz-login-reserved__note">@Message</div>
        }
    </div>
</div>
