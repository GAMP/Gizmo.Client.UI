@namespace Gizmo.Client.UI.Components
@inherits CustomDOMComponentBase

<div class="@ClassName">
    <div class="giz-password-tooltip__head">
        <span class="giz-password-tooltip__title">@Title</span>
        <span class="giz-password-tooltip__count">@CountText</span>
    </div>
    <div class="giz-password-tooltip__meter">
        @foreach (var passed in Segments)
        {
            <span class="@SegmentClass(passed)"></span>
        }
    </div>
    <ul class="giz-password-tooltip__rules">
        @foreach (var rule in Rules)
        {
            <li class="@RuleClass(rule)">
                <i class="@RuleIcon(rule)"></i>
                <span>@rule.Text</span>
            </li>
        }
    </ul>
</div>
