@namespace Gizmo.Client.UI.Shared
@inherits ShellComponentBase

@if (ViewState.IsInGracePeriod)
{
    @if (IsReservationLock)
    {
        <div class="giz-handover @HandoverModifier" style="@ProgressStyle">
            <div class="giz-handover__veil"></div>
            <div class="giz-handover__stage">
                <header class="giz-handover__head">
                    <div class="giz-handover__title">@HandoverTitle</div>
                    <div class="giz-handover__sub">@HandoverHint</div>
                </header>

                <div class="giz-handover__row">
                    <section class="giz-handover__tile giz-handover__tile--player">
                        <div class="giz-handover__top">
                            <span class="giz-handover__disc"><i class="ph ph-user"></i></span>
                            <div class="giz-handover__names">
                                <div class="giz-handover__who">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_HANDOVER_NOW_PLAYING)</div>
                                <div class="giz-handover__what">@Username</div>
                            </div>
                        </div>
                        @if (TimeKeptText is { Length: > 0 })
                        {
                            <div class="giz-handover__keep">
                                <i class="ph-bold ph-hourglass-medium"></i>
                                <span>@TimeKeptText</span>
                            </div>
                        }
                        <button type="button" class="giz-handover__out" @onclick="@(() => UserService.LogoutAsync())">
                            <i class="ph-bold ph-sign-out"></i>
                            <span>@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_HANDOVER_LOGOUT)</span>
                        </button>
                    </section>

                    <div class="giz-handover__link">
                        <div class="giz-handover__count">
                            @if (_reservationConfirmed)
                            {
                                <i class="ph-bold ph-check"></i>
                            }
                            else
                            {
                                @CountdownText
                            }
                        </div>
                        <div class="giz-handover__line">
                            <span class="giz-handover__track">
                                <i class="giz-handover__fill"></i>
                                <i class="giz-handover__pulse"></i>
                            </span>
                            <b class="giz-handover__port"></b>
                            <b class="giz-handover__port giz-handover__port--end"></b>
                        </div>
                        <div class="giz-handover__cap">@HandoverCaption</div>
                    </div>

                    <section class="giz-handover__tile giz-handover__tile--reservation">
                        <div class="giz-handover__top">
                            <span class="giz-handover__disc giz-handover__disc--reservation">
                                <i class="@ReservationIcon"></i>
                            </span>
                            <div class="giz-handover__names">
                                <div class="giz-handover__who">@ReservationLabel</div>
                                <div class="giz-handover__what">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_RESV_FROM, ReservationTimeText)</div>
                            </div>
                        </div>

                        @if (_reservationConfirmed)
                        {
                            <div class="giz-handover__done">
                                <i class="ph-bold ph-check-circle"></i>
                                <span>@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_GRACE_CONFIRMED)</span>
                            </div>
                        }
                        else if (ReservationNeedsPayment)
                        {
                            <div class="giz-handover__act">
                                @if (DueText is { Length: > 0 })
                                {
                                    <div class="giz-handover__due">
                                        <span>@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_HANDOVER_DUE)</span>
                                        <b>@DueText</b>
                                    </div>
                                }
                                <button type="button" class="giz-handover__go" @onclick="@OnOpenReservationPaymentAsync">
                                    <i class="ph-bold ph-credit-card"></i>
                                    <span>@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_CONFIRM_RESERVATION_NOTIFICATION_PAYMENT_GO_TO_PAYMENT_BUTTON))</span>
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="giz-handover__act">
                                <label class="giz-handover__field">
                                    <span class="giz-handover__label">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_GRACE_PIN_LABEL)</span>
                                    <input type="text"
                                           class="@PinInputClass"
                                           autocomplete="off"
                                           spellcheck="false"
                                           value="@_pin"
                                           disabled="@_pinBusy"
                                           @oninput="@((ChangeEventArgs e) => OnPinInput(e))"
                                           @onkeydown="@OnPinKeyDown" />
                                </label>
                                @if (!string.IsNullOrEmpty(_pinError))
                                {
                                    <div class="giz-handover__error">
                                        <i class="ph-bold ph-warning-circle"></i>
                                        <span>@_pinError</span>
                                    </div>
                                }
                                <button type="button" class="giz-handover__go" disabled="@IsConfirmDisabled" @onclick="@OnConfirmPinAsync">
                                    <i class="ph-bold ph-check"></i>
                                    <span>@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_GEN_CONFIRM)</span>
                                </button>
                            </div>
                        }
                    </section>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="giz-login-overlay">
            <div class="giz-grace-period-wrapper">
                <div class="giz-grace-period">
                    @if (!_showDeposit)
                    {
                        <div class="giz-grace-period__badge">
                            <i class="ph-fill ph-hourglass-high giz-ph-icon"></i>
                        </div>
                        <div class="giz-grace-period__title">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_GRACE_TIME_UP)</div>
                        <div class="giz-grace-period__message">
                            @GrafitLocalization.GetString(GrafitResourceKeys.SHELL_GRACE_TIME_UP_MESSAGE)
                        </div>
                        <div class="giz-grace-period__timer">
                            <div class="giz-grace-period__timer__label">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_GRACE_TIME_LEFT)</div>
                            <div class="giz-grace-period__time">@CountdownText</div>
                        </div>
                        <div class="giz-grace-period__actions">
                            @if (UserOnlineDepositViewState.IsEnabled)
                            {
                                <Button Color="ButtonColors.Accent"
                                        Size="ButtonSizes.ExtraLarge"
                                        Text="@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_GRACE_TOP_UP_ACCOUNT)"
                                        @onclick="@(() => _showDeposit = true)" />
                            }
                            <Button Variant="ButtonVariants.Outline"
                                    Size="ButtonSizes.ExtraLarge"
                                    Text="@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GRACE_PERIOD_LOGOUT))"
                                    @onclick="@(() => UserService.LogoutAsync())" />
                        </div>
                    }
                    else
                    {
                        <div class="giz-grace-period__deposit">
                            <div class="giz-grace-period__deposit__head">
                                <div class="giz-grace-period__title">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_DEPOSIT_PAGE_TITLE)</div>
                                <div class="giz-grace-period__time giz-grace-period__time--small">@CountdownText</div>
                            </div>
                            <UserOnlineDeposits OnClickPayFromPC="@OnClickPayFromPCHandler" OnClickClear="@OnClickClearHandler" OnPaymentSucceeded="@OnPaymentSucceededHandler" />
                            <div class="giz-grace-period__back" @onclick="@(() => _showDeposit = false)">@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_BACK))</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
}
