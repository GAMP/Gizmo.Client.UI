@namespace Gizmo.Client.UI.Shared
@inherits CustomDOMComponentBase

@* Copy is written in Russian directly rather than through resource keys -
   see the note in MenuActiveApplicationsContainer.razor for why. *@
@if (ViewState.IsInGracePeriod)
{
    <div class="giz-login-overlay">
        <div class="giz-grace-period-wrapper">
            <div class="giz-grace-period">
                @if (IsReservationLock)
                {
                    @* Тот же льготный период, но причина у него другая: не «деньги
                       кончились», а «на этот компьютер бронь». Предлагать здесь
                       пополнение — врать: сколько ни клади на счёт, сессия всё
                       равно закроется. Поэтому — что происходит, код брони и выход. *@
                    <div class="giz-grace-period__badge giz-grace-period__badge--lock">
                        <i class="ph-fill ph-calendar-check giz-ph-icon"></i>
                    </div>
                    <div class="giz-grace-period__title">Компьютер забронирован</div>
                    <div class="giz-grace-period__message">
                        @if (ReservationTimeText is { Length: > 0 })
                        {
                            @($"Это устройство забронировано на {ReservationTimeText}. ")
                        }
                        Если бронь ваша — введите код бронирования. Если нет, обратитесь к администратору.
                    </div>

                    @if (_reservationConfirmed)
                    {
                        <div class="giz-reserve-pin__ok">
                            <i class="ph-fill ph-check-circle"></i>
                            <span>Бронирование подтверждено</span>
                        </div>
                    }
                    else if (ReservationNeedsPayment)
                    {
                        <div class="giz-grace-period__message">
                            Бронирование подтверждено, но требует оплаты.
                        </div>
                        <div class="giz-grace-period__actions">
                            <Button Color="ButtonColors.Accent"
                                    Size="ButtonSizes.ExtraLarge"
                                    Text="Перейти к оплате"
                                    @onclick="@OnOpenReservationPaymentAsync" />
                            <Button Variant="ButtonVariants.Outline"
                                    Size="ButtonSizes.ExtraLarge"
                                    Text="Выйти"
                                    @onclick="@(() => UserService.LogoutAsync())" />
                        </div>
                    }
                    else
                    {
                        <div class="giz-reserve-pin">
                            <div class="giz-reserve-pin__label">Код бронирования</div>
                            <div class="giz-reserve-pin__row">
                                <input type="text"
                                       class="giz-reserve-pin__input"
                                       inputmode="latin"
                                       autocomplete="off"
                                       spellcheck="false"
                                       placeholder="код из подтверждения"
                                       value="@_pin"
                                       disabled="@_pinBusy"
                                       @oninput="@((ChangeEventArgs e) => OnPinInput(e))"
                                       @onkeydown="@OnPinKeyDown" />
                                <Button Color="ButtonColors.Accent"
                                        Size="ButtonSizes.Large"
                                        Text="Подтвердить"
                                        IsDisabled="@(_pinBusy || string.IsNullOrWhiteSpace(_pin))"
                                        @onclick="@OnConfirmPinAsync" />
                            </div>
                            @if (!string.IsNullOrEmpty(_pinError))
                            {
                                <div class="giz-reserve-pin__error">@_pinError</div>
                            }
                        </div>
                    }

                    <div class="giz-grace-period__timer">
                        <div class="giz-grace-period__timer__label">До выхода осталось</div>
                        <div class="giz-grace-period__time">@ViewState.Time.ToString(@"mm\:ss")</div>
                    </div>

                    @if (!ReservationNeedsPayment && !_reservationConfirmed)
                    {
                        <div class="giz-grace-period__actions">
                            <Button Variant="ButtonVariants.Outline"
                                    Size="ButtonSizes.ExtraLarge"
                                    Text="Выйти"
                                    @onclick="@(() => UserService.LogoutAsync())" />
                        </div>
                    }
                }
                else if (!_showDeposit)
                {
                    <div class="giz-grace-period__badge">
                        <i class="ph-fill ph-hourglass-high giz-ph-icon"></i>
                    </div>
                    <div class="giz-grace-period__title">Время вышло</div>
                    <div class="giz-grace-period__message">
                        Сессия ещё активна. Пополните счёт, чтобы продолжить
                        с того же места — ничего не потеряется.
                    </div>
                    <div class="giz-grace-period__timer">
                        <div class="giz-grace-period__timer__label">До выхода осталось</div>
                        <div class="giz-grace-period__time">@string.Format("{0:mm\\:ss}", ViewState.Time)</div>
                    </div>
                    <div class="giz-grace-period__actions">
                        @* The top-up form is embedded rather than opened as a
                           dialog: this overlay sits at z-index 3000 and the
                           dialog host at 1001, so a dialog raised from here
                           would render behind the overlay. *@
                        @if (UserOnlineDepositViewState.IsEnabled)
                        {
                            <Button Color="ButtonColors.Accent"
                                    Size="ButtonSizes.ExtraLarge"
                                    Text="Пополнить счёт"
                                    @onclick="@(() => _showDeposit = true)" />
                        }
                        <Button Variant="ButtonVariants.Outline"
                                Size="ButtonSizes.ExtraLarge"
                                Text="Выйти"
                                @onclick="@(() => UserService.LogoutAsync())" />
                    </div>
                }
                else
                {
                    <div class="giz-grace-period__deposit">
                        <div class="giz-grace-period__deposit__head">
                            <div class="giz-grace-period__title">Пополнение</div>
                            <div class="giz-grace-period__time giz-grace-period__time--small">@string.Format("{0:mm\\:ss}", ViewState.Time)</div>
                        </div>
                        <UserOnlineDeposits OnClickPayFromPC="@OnClickPayFromPCHandler" OnClickClear="@OnClickClearHandler" OnPaymentSucceeded="@OnPaymentSucceededHandler" />
                        <div class="giz-grace-period__back" @onclick="@(() => _showDeposit = false)">Назад</div>
                    </div>
                }
            </div>
        </div>
    </div>
}
