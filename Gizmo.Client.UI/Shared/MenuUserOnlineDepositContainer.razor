@namespace Gizmo.Client.UI
@inherits CustomDOMComponentBase
@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms

<div class="giz-dropdown-menu @(UserMenuViewState.UserOnlineDepositIsVisible ? "open" : "")"
     id="@Id"
     @ref="@Ref">
    <div class="giz-dropdown-menu__content giz-user-online-deposit-menu">
        <div class="giz-panel-head">
            <div class="giz-panel-head__title">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_TOPUP_TITLE)</div>
            <div class="giz-panel-head__hint">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_TOPUP_HINT)</div>
        </div>
        <UserOnlineDeposits OnClickPayFromPC="@OnClickPayFromPCHandler" OnClickClear="@OnClickClearHandler" OnPaymentSucceeded="@OnPaymentSucceededHandler" />
    </div>
</div>