@namespace Gizmo.Client.UI.Shared
@inherits CustomDOMComponentBase

@* Sits between the topbar's action icons and the account avatar. At rest
   it's width:0/invisible and takes no space; when the proxy's cadence
   check says "nudge this login", it grows in - pushing the icon cluster
   left via normal flex reflow, no fake position:absolute needed - pointing
   an arrow at the avatar right next to it.

   Unlike every other top-bar pill this one is deliberately NOT neutral
   glass: it is an ad, and a quiet grey pill sitting among other quiet grey
   pills is one nobody reads. Accent fill, two lines, its own glow. *@
<div class="giz-avatar-nudge @(IsVisible ? "open" : "")">
    <i class="ph-fill ph-user-circle-plus giz-avatar-nudge__badge"></i>
    <div class="giz-avatar-nudge__text">
        <div class="giz-avatar-nudge__text__title">Сделай свой профиль уникальнее</div>
        <div class="giz-avatar-nudge__text__sub">Добавь фото</div>
    </div>
    <i class="ph-bold ph-caret-right giz-avatar-nudge__arrow"></i>
</div>
