@namespace Gizmo.Client.UI
@inherits CustomDOMComponentBase
@using System.Globalization

<div class="giz-header-user-balance"
     @onmouseover="OnMouseOverHandler"
     @onmouseout="OnMouseOutHandler">
    <i class="ph-fill ph-lightning giz-ph-icon"></i>
    <div>@UsageSessionViewState.CurrentTimeProductName</div>

    <div class="giz-user-balance-tooltip-wrapper @(_isOpen ? "giz-user-balance-tooltip-wrapper--visible" : "")"
         @onmouseover="OnMouseOverTooltipHandler"
         @onmouseout="OnMouseOutTooltipHandler">

        <HeaderUserBalanceCurrentTimeProductTooltip OnClickAction="@OnClickActionHandler" />

    </div>
</div>