@namespace Gizmo.Client.UI
@inherits CustomDOMComponentBase

@* A person's picture when the account has one, otherwise a quiet glyph. There is no
   way to set a picture from the shell (the change-picture dialog is not wired
   anywhere), so the glyph is a plain placeholder rather than an invitation. *@
@if (!string.IsNullOrEmpty(Picture))
{
    <Avatar Image="@Picture" Variant="AvatarVariants.Circle" Class="@("giz-user-avatar " + Class)" />
}
else
{
    <span class="@("giz-user-avatar giz-user-avatar--glyph " + Class)"><i class="ph ph-user"></i></span>
}

@code {
    [Parameter]
    public string Picture { get; set; }
}
