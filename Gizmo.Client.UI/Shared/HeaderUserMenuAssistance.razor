@namespace Gizmo.Client.UI
@inherits CustomDOMComponentBase
@inject Gizmo.UI.Services.ILocalizationService LocalizationService

<div class="giz-header__user-menu-item giz-assistance-dropdown @(UserMenuViewState.AssistanceRequestsIsVisible ? "open" : "")" data-tooltip="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_ASSISTANCE_REQUEST_SEND))">
    <button class="user-menu-item-button--box" @onclick="(args) => OnClick.InvokeAsync(args)" @onclick:stopPropagation="true">
