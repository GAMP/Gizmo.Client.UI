@namespace Gizmo.Client.UI.Shared
@inherits CustomDOMComponentBase

<div class="giz-dropdown-menu @(UserMenuViewState.NotificationsIsVisible ? "open" : "")"
     id="@Id"
     @ref="@Ref">
    <div class="giz-dropdown-menu__content giz-menu-notifications">
        @* Russian written inline - see the note in
           MenuActiveApplicationsContainer.razor for why not resource keys. *@
        <div class="giz-menu-notifications__header">
            <div class="giz-heading">@ShellText.Get(ShellText.NOTIFICATIONS_TITLE)</div>
            <div class="giz-menu-notifications__header__hint">@ShellText.Get(ShellText.NOTIFICATIONS_HINT)</div>
        </div>
        <div class="giz-menu-notifications__body giz-scrollbar--v">

            @if (ViewState.Dismissed != null && ViewState.Dismissed.Count() > 0)
            {
                @foreach (var controller in ViewState.Dismissed)
                {
                    <div class="giz-notification-wrapper">
                        <DynamicComponent Parameters="controller.Parameters" Type="controller.ComponentType" @key=controller.Identifier></DynamicComponent>
                    </div>
                }
            }
            else
            {
                <div class="giz-menu-notification-default-item-wrapper">
                    <div class="giz-empty-state">
                        <i class="ph-fill ph-bell-slash giz-ph-icon"></i>
                        <div class="giz-empty-state__title">@ShellText.Get(ShellText.NOTIFICATIONS_EMPTY_TITLE)</div>
                        <div class="giz-empty-state__text">@ShellText.Get(ShellText.NOTIFICATIONS_EMPTY)</div>
                    </div>
                </div>
            }

        </div>
        @if (ViewState.Dismissed != null && ViewState.Dismissed.Any())
        {
            <div class="giz-menu-notifications__footer">
                <div class="giz-menu-notifications__footer__action" @onclick="AcknowledgeAll">@ShellText.Get(ShellText.NOTIFICATIONS_CLEAR)</div>
            </div>
        }
    </div>
</div>