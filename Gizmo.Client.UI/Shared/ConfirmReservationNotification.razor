@namespace Gizmo.Client.UI
@using Gizmo.UI;
@using Microsoft.AspNetCore.Components.Forms
@inherits CustomDOMComponentBase

@* Тексты написаны по-русски прямо здесь, а не через ресурсы: строки живут в
   Gizmo.Client.UI.Resources.dll, которую сервер грузит свою, и правки туда до
   реального клиента не доезжают. Заодно они стали короче — штатное
   «Подтвердить бронирование» не влезало в кнопку и переносилось поверх соседней.

   Формулировки развожу по шагам: на первом человек ещё не понимает, почему у
   него что-то просят, на втором он уже подтвердил бронь и ждёт оплаты. *@
<div class="giz-reservation-notification">

    <div class="giz-reservation-notification__body">
        <div class="giz-reservation-notification__body__title">
            @(IsPaymentStep ? "Бронь ждёт оплаты" : "Этот компьютер забронирован")
        </div>
        <div class="giz-reservation-notification__body__message">
            @(IsPaymentStep
                ? "Бронирование подтверждено. Осталось оплатить — иначе сеанс закроется."
                : "Если бронировали вы, введите код бронирования, чтобы продолжить сеанс.")
        </div>
        <div class="giz-reservation-notification__body__actions">
            <Button Color="ButtonColors.Accent"
                    Size="ButtonSizes.Medium"
                    Text="@(IsPaymentStep ? "Оплатить" : "Ввести код")"
                    IsDisabled="@ConfirmReservationNotificationViewService.ViewState.IsLoading"
                    @onclick="OpenPaymentDialogAsync" />
            <Button Variant="ButtonVariants.Outline"
                    Size="ButtonSizes.Medium"
                    Text="Позже"
                    IsDisabled="@ConfirmReservationNotificationViewService.ViewState.IsLoading"
                    @onclick="Ignore" />
        </div>
    </div>

    <div class="giz-reservation-notification__close-button">
        <IconButton SVGIcon="Icons.Close" Variant="ButtonVariants.Text" Size="ButtonSizes.Small" Class="close-btn" @onclick="() => CloseNotification()" />
    </div>
</div>
