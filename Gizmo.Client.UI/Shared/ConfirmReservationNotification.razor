@namespace Gizmo.Client.UI
@using Gizmo.UI;
@using Microsoft.AspNetCore.Components.Forms
@inherits CustomDOMComponentBase

<div class="giz-reservation-notification">
    <div class="giz-reservation-notification__icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <mask id="mask0_8458_8936" style="mask-type:alpha" maskUnits="userSpaceOnUse" x="0" y="0" width="24" height="24">
                <rect width="24" height="24" fill="#D9D9D9" />
            </mask>
            <g mask="url(#mask0_8458_8936)">
                <path d="M2.72505 21C2.34172 21 2.05838 20.8333 1.87505 20.5C1.69172 20.1667 1.69172 19.8333 1.87505 19.5L11.125 3.5C11.3084 3.16667 11.6 3 12 3C12.4 3 12.6917 3.16667 12.875 3.5L22.125 19.5C22.3084 19.8333 22.3084 20.1667 22.125 20.5C21.9417 20.8333 21.6584 21 21.275 21H2.72505ZM12 10C11.7167 10 11.4794 10.0957 11.288 10.287C11.096 10.479 11 10.7167 11 11V14C11 14.2833 11.096 14.5207 11.288 14.712C11.4794 14.904 11.7167 15 12 15C12.2834 15 12.521 14.904 12.713 14.712C12.9044 14.5207 13 14.2833 13 14V11C13 10.7167 12.9044 10.479 12.713 10.287C12.521 10.0957 12.2834 10 12 10ZM12 18C12.2834 18 12.521 17.904 12.713 17.712C12.9044 17.5207 13 17.2833 13 17C13 16.7167 12.9044 16.4793 12.713 16.288C12.521 16.096 12.2834 16 12 16C11.7167 16 11.4794 16.096 11.288 16.288C11.096 16.4793 11 16.7167 11 17C11 17.2833 11.096 17.5207 11.288 17.712C11.4794 17.904 11.7167 18 12 18Z" fill="#F8C735" />
            </g>
        </svg>
    </div>
    @if (ConfirmReservationNotificationViewService.ViewState.Step == 0)
    {
        <EditForm EditContext="@ConfirmReservationNotificationViewService.EditContext">
            <div class="giz-reservation-notification__body">
                <div class="giz-reservation-notification__body__title">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_CONFIRM_RESERVATION_NOTIFICATON_CONFIRMATION_STEP_TITLE))</div>
                <div class="giz-reservation-notification__body__message">
                    @((MarkupString)LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_CONFIRM_RESERVATION_NOTIFICATON_CONFIRMATION_STEP_MESSAGE)))
                </div>
                <div class="giz-reservation-notification__body__input">
                    <PasswordInput UpdateOnInput="true"
                                   Value="@ConfirmReservationNotificationViewService.ViewState.Pin"
                                   ValueChanged="@((string value) => ConfirmReservationNotificationViewService.SetPin(value))"
                                   ValueExpression="@(() => ConfirmReservationNotificationViewService.ViewState.Pin)"
                                   IsDisabled="@ConfirmReservationNotificationViewService.ViewState.IsLoading"
                                   Size="InputSizes.Medium"
                                   IsFullWidth="true"
                                   IsTransparent="true"
                                   Label="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_RESERVATION_PIN_INPUT_LABEL))" />
                </div>
                @if (!string.IsNullOrEmpty(ConfirmReservationNotificationViewService.ViewState.ErrorMessage))
                {
                    <div class="giz-reservation-notification__body__error">
                        @ConfirmReservationNotificationViewService.ViewState.ErrorMessage
                    </div>
                }
                <div class="giz-reservation-notification__body__actions">
                    <Button IsDisabled="@(ConfirmReservationNotificationViewService.ViewState.IsValid == false || ConfirmReservationNotificationViewService.ViewState.IsLoading)"
                            @onclick="ConfirmAsync">
                        @if (ConfirmReservationNotificationViewService.ViewState.IsLoading)
                        {
                            <div style="visibility: hidden">
                                @LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_CONFIRM_RESERVATION_NOTIFICATON_CONFIRMATION_STEP_CONFIRM_BUTTON))
                            </div>
                            <div class="giz-button-spinner-wrapper">
                                <Spinner />
                            </div>
                        }
                        else
                        {
                            <div>@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_CONFIRM_RESERVATION_NOTIFICATON_CONFIRMATION_STEP_CONFIRM_BUTTON))</div>
                        }
                    </Button>
                    <Button Text="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_CONFIRM_RESERVATION_NOTIFICATON_IGNORE_BUTTON))"
                            IsDisabled="@ConfirmReservationNotificationViewService.ViewState.IsLoading"
                            @onclick="Ignore" />
                </div>
            </div>
        </EditForm>
    }
    else
    {
        <div class="giz-reservation-notification__body">
            <div class="giz-reservation-notification__body__title">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_CONFIRM_RESERVATION_NOTIFICATON_PAYMENT_STEP_TITLE))</div>
            <div class="giz-reservation-notification__body__message">
                @((MarkupString)LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_CONFIRM_RESERVATION_NOTIFICATON_PAYMENT_STEP_MESSAGE)))
            </div>
            <div class="giz-reservation-notification__body__actions">
                <Button Text="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_CONFIRM_RESERVATION_NOTIFICATON_PAYMENT_GO_TO_PAYMENT_BUTTON))"
                        IsDisabled="@ConfirmReservationNotificationViewService.ViewState.IsLoading"
                        @onclick="OpenPaymentDialogAsync" />
                <Button Text="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_CONFIRM_RESERVATION_NOTIFICATON_IGNORE_BUTTON))"
                        IsDisabled="@ConfirmReservationNotificationViewService.ViewState.IsLoading"
                        @onclick="Ignore" />
            </div>
        </div>
    }
    <div class="giz-reservation-notification__close-button">
        <IconButton SVGIcon="Icons.Close" Variant="ButtonVariants.Text" Size="ButtonSizes.Small" Class="close-btn" @onclick="() => CloseNotification()" />
    </div>
</div>
