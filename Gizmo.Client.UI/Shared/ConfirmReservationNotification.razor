@namespace Gizmo.Client.UI
@using Gizmo.UI;
@using Microsoft.AspNetCore.Components.Forms
@inherits CustomDOMComponentBase

<div class="giz-reservation-notification">
    <div class="giz-reservation-notification__icon"><i class="ph-fill ph-calendar-check"></i></div>

    <div class="giz-reservation-notification__body">
        <div class="giz-reservation-notification__body__title">
            @GrafitLocalization.GetString(IsPaymentStep ? GrafitResourceKeys.SHELL_RESV_NOTIF_TITLE_PAY : GrafitResourceKeys.SHELL_RESV_NOTIF_TITLE_CODE)
        </div>
        <div class="giz-reservation-notification__body__message">
            @(IsPaymentStep
                ? GrafitLocalization.GetString(GrafitResourceKeys.SHELL_RESV_NOTIF_MSG_PAY)
                : GrafitLocalization.GetString(GrafitResourceKeys.SHELL_RESV_NOTIF_MSG_CODE))
        </div>
        <div class="giz-reservation-notification__body__actions">
            <button type="button" class="giz-notification__btn giz-notification__btn--primary"
                    disabled="@ConfirmReservationNotificationViewService.ViewState.IsLoading"
                    @onclick="OpenPaymentDialogAsync">
                @GrafitLocalization.GetString(IsPaymentStep ? nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_CONFIRM_RESERVATION_DIALOG_PAY_BUTTON) : GrafitResourceKeys.SHELL_RESV_ENTER_CODE)
            </button>
            <button type="button" class="giz-notification__btn"
                    disabled="@ConfirmReservationNotificationViewService.ViewState.IsLoading"
                    @onclick="Ignore">
                @GrafitLocalization.GetString(GrafitResourceKeys.SHELL_GEN_LATER)
            </button>
        </div>
    </div>

    <button type="button" class="giz-notification__close" @onclick="CloseNotification" aria-label="@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_CLOSE))">
        <i class="ph-bold ph-x"></i>
    </button>
</div>
