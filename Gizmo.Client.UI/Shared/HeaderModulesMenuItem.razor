@namespace Gizmo.Client.UI
@inherits ComponentBase

<NavLink href="@MetaData.DefaultRoute"
         Match=@((NavLinkMatch)MetaData.DefaultRouteMatch)>

    @switch (MetaData.Guid)
    {
        case KnownModules.MODULE_PROFILE:

            <i class="ph-bold ph-user giz-ph-icon giz-nav-icon--bold"></i>
            <i class="ph-fill ph-user giz-ph-icon giz-nav-icon--fill"></i>

            break;

        case KnownModules.MODULE_APPS:

            <i class="ph-bold ph-game-controller giz-ph-icon giz-nav-icon--bold"></i>
            <i class="ph-fill ph-game-controller giz-ph-icon giz-nav-icon--fill"></i>

            break;

        case KnownModules.MODULE_HOME:

            <i class="ph-bold ph-house giz-ph-icon giz-nav-icon--bold"></i>
            <i class="ph-fill ph-house giz-ph-icon giz-nav-icon--fill"></i>

            break;

        case KnownModules.MODULE_SHOP:

            <i class="ph-bold ph-shopping-cart-simple giz-ph-icon giz-nav-icon--bold"></i>
            <i class="ph-fill ph-shopping-cart-simple giz-ph-icon giz-nav-icon--fill"></i>

            break;

        @* GGBook mapped icons for their own Cases and Tasks page modules here.
           Neither module ships with V3, so both cases are dropped; the default
           branch already handles any module by its own metadata icon. *@

        default:

            @if (!string.IsNullOrEmpty(MetaData.Icon))
            {
                <img src="@MetaData.Icon" alt='loading' class="giz-module-icon" />
            }

            break;
    }

    @if (!string.IsNullOrWhiteSpace(MetaData.TitleLocalizationKey))
    {
        <span>@LocalizationService.GetStringUpper(MetaData.TitleLocalizationKey)</span>
    }
    else
    {
        <span>@(MetaData.Title ?? LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_UNSET_STRING_VALUE)))</span>
    }

</NavLink>