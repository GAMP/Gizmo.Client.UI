@namespace Gizmo.Client.UI
@inherits CustomDOMComponentBase

<div class="giz-actions-bar">
    @if (UserOnlineDepositViewState.IsEnabled)
    {
        <HeaderUserMenuUserOnlineDeposit @onclick="ShowOnlineDeposits" />
    }
    <HeaderUserMenuActiveApps @onclick="UserMenuViewService.ToggleActiveApps" />
    <HeaderUserMenuNotifications @onclick="UserMenuViewService.ToggleNotifications" />
    @if (AssistanceRequestViewState.IsEnabled)
    {
        <HeaderUserMenuAssistance @onclick="UserMenuViewService.ToggleAssistanceRequests" />
    }
</div>
