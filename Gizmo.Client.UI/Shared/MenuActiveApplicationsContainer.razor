@namespace Gizmo.Client.UI.Shared
@inherits CustomDOMComponentBase
@using System.Linq

<div class="giz-dropdown-menu @(UserMenuViewState.ActiveAppsIsVisible ? "open" : "")"
     id="@Id"
     @ref="@Ref">
    <div class="giz-dropdown-menu__content giz-active-apps">
        <div class="giz-active-apps__header">
            <div class="giz-heading">@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_ACTIVE_APPS_TITLE))</div>
            <div class="giz-active-apps__header__hint">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_ACTIVE_APPS_HINT)</div>
        </div>
        <div class="giz-active-apps__body giz-scrollbar--v">
            @if (ViewState.Executables.Any())
            {
                @foreach (var executable in ViewState.Executables)
                {
                    <MenuActiveApplicationCard Executable="@executable" />
                }
            }
            else
            {
                <div class="giz-active-apps__empty">
                    <i class="ph-fill ph-game-controller giz-ph-icon"></i>
                    <div class="giz-active-apps__empty__title">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_GEN_EMPTY)</div>
                    <div class="giz-active-apps__empty__text">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_ACTIVE_APPS_EMPTY_HINT)</div>
                </div>
            }
        </div>
    </div>
</div>
