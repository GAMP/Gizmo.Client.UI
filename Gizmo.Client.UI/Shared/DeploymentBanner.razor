@namespace Gizmo.Client.UI.Shared
@inherits ShellComponentBase

<div class="giz-deploy @(IsOpen ? "open" : null) @(IsDone ? "giz-deploy--done" : null) @(IsIndeterminate && !IsDone ? "giz-deploy--waiting" : null)">

    <span class="giz-deploy__fill" style="--giz-deploy-progress: @ProgressWidth"></span>

    <div class="giz-deploy__badge">
        <svg class="giz-deploy__ring" viewBox="0 0 40 40" aria-hidden="true">
            <circle class="giz-deploy__ring-track" cx="20" cy="20" r="17.5"></circle>
            <circle class="giz-deploy__ring-bar" cx="20" cy="20" r="17.5" style="--giz-deploy-ring-offset: @RingOffset"></circle>
        </svg>
        @if (IsDone)
        {
            <i class="ph-bold ph-check"></i>
        }
        else
        {
            <i class="ph-fill ph-cloud-arrow-down"></i>
        }
    </div>

    <button type="button" class="giz-deploy__body" @onclick="OpenManager" title="@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_DEPLOY_OPEN_APPS)">
        <span class="giz-deploy__title">@Title</span>
        <span class="giz-deploy__sub">@Subtitle</span>
    </button>

    @if (!IsDone)
    {
        <div class="giz-deploy__pct">@PercentLabel</div>
    }

    <button type="button" class="giz-deploy__close" @onclick="Dismiss" aria-label="@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_GEN_HIDE)">
        <i class="ph-bold ph-x"></i>
    </button>

</div>
