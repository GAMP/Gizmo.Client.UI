@inherits LayoutComponentBase
@using Gizmo.UI;
@using Microsoft.Extensions.Options

@if (!string.IsNullOrEmpty(ClientUIOptions.Value.StyleSheet))
{
    <HeadContent>
        <link href="style.css" rel="stylesheet" />
    </HeadContent>
}

<main client-theme="true">
    <div class="giz-main-container">
        <div class="giz-login-content @ClassName">
            @if (LoginRotatorViewState.IsEnabled)
            {
                <Layout_LoginRotator />
            }
            else
            {
                <Layout_LoginWallpaper />
            }

            @* <Layout_LoginCarousel /> *@

            @if (HostNumberViewState.HostNumberIsEnabled)
            {
                <div class="giz-host-number @(UserIdleViewState.IsIdle ? HostNumberViewState.CurrentPosition : "")"
                     style="--transition-duration: @(HostNumberViewState.AnimationDuration)s">
                    <HostNumber />
                </div>
            }

            @* <div class="giz-login-logotype">
                <div class="giz-login-logotype__icon">
                    <Icon SVGIcon="Icons.Passport_Client" Size="IconSizes.Large" />
                </div>
                <div class="giz-login-logotype__text">
                    <span>2 line</span>
                    <span>logotype</span>
                </div>
            </div> *@

            @if (!string.IsNullOrEmpty(LogoViewState.Logo))
            {
                <div class="giz-login-logo">
                    <img src="@LogoViewState.Logo" alt='loading' />
                </div>
            }

            <div class="giz-login-warnings">
                @if (_previousIsIdle || _slideOut)
                {
                    @if (HostReservationViewState.ReservationBlockTimeReached)
                    {
                        <Alert AlertType="AlertTypes.Info"
                               Title="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_LOGIN_RESERVATION_WARNING_TITLE), HostReservationViewState.Time.Value.ToShortTimeString())"
                               Text="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_HOST_RESERVATION_LOGIN_BLOCK_TIME_REACHED_MESSAGE))" />

                    }
                    else if (HostReservationViewState.ReservationNotificationTimeReached)
                    {
                        <Alert AlertType="AlertTypes.Warning"
                               Title="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_LOGIN_RESERVATION_WARNING_TITLE), HostReservationViewState.Time.Value.ToShortTimeString())"
                               Text="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_HOST_RESERVATION_LOGIN_NOTIFICATION_TIME_REACHED_MESSAGE))" />
                    }
                }
            </div>

            <div class="giz-client-status" @onclick="test">
                <ClientLanguageMenu />

                <div class="giz-server">
                    <Layout_LoginServerConnection />
                    <div class="giz-version">
                        <div class="giz-version__title">Gizmo @LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_SYSTEM_VERSION))</div>
                        <div class="giz-version__version">@ClientVersionViewState.Version</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="giz-login__login @ClassName">
            @Body
            <DialogHost />
        </div>
    </div>

    @if (HostOutOfOrderViewState.IsOutOfOrder)
    {
        <Layout_LoginOutOfOrder />
    }
    else
    {
        <Layout_LoginLock />        
    }

</main>
