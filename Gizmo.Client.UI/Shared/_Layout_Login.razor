@inherits LayoutComponentBase
@using Gizmo.UI;
@using Microsoft.Extensions.Options

@if (!string.IsNullOrEmpty(ClientUIOptions.Value.StyleSheet))
{
    <HeadContent>
        <link href="style.css" rel="stylesheet" />
    </HeadContent>
}

<main client-theme="true">
    <div class="giz-main-container">
        <div class="giz-login-content @ClassName">
            @* Base layer: the club's configured wallpaper (skin config). Shown
               when the station is idle (no login window). *@
            @if (LoginRotatorViewState.IsEnabled)
            {
                <Layout_LoginRotator />
            }
            else
            {
                <Layout_LoginWallpaper />
            }

            @* Overlay layer: a fixed, hard-coded background shown while the
               login / registration window is active. It sits on top of the
               configured wallpaper and crossfades in/out with the window
               (opacity + scale, driven by the .collapsed state on the parent),
               so idle shows the club wallpaper and active shows this one. *@
            <div class="giz-login-hardcoded-bg"></div>
            <div class="giz-login-hardcoded-bg__icons">
                <i class="ph-fill ph-game-controller"></i>
                <i class="ph-fill ph-desktop-tower"></i>
                <i class="ph-fill ph-headset"></i>
            </div>

            @if (HostNumberViewState.HostNumberIsEnabled)
            {
                <div class="giz-host-number @(UserIdleViewState.IsIdle ? HostNumberViewState.CurrentPosition : "")"
                     style="--transition-duration: @(HostNumberViewState.AnimationDuration)s">
                    <HostNumber />
                </div>
            }

            @* <div class="giz-login-logotype">
                <div class="giz-login-logotype__icon">
                    <Icon SVGIcon="Icons.Passport_Client" Size="IconSizes.Large" />
                </div>
                <div class="giz-login-logotype__text">
                    <span>2 line</span>
                    <span>logotype</span>
                </div>
            </div> *@

            @if (!string.IsNullOrEmpty(LogoViewState.Logo))
            {
                <div class="giz-login-logo">
                    <img src="@LogoViewState.Logo" alt='loading' />
                </div>
            }

            @* Та же плитка, что и над карточкой входа: пока станция простаивает,
               карточки на экране нет, и о брони сообщает этот экземпляр. Вид
               один и тот же, чтобы одно и то же сообщение не выглядело двумя
               разными. *@
            <div class="giz-login-warnings">
                @if (_previousIsIdle || _slideOut)
                {
                    @if (HostReservationViewState.ReservationBlockTimeReached)
                    {
                        <ReservationNotice Time="@HostReservationViewState.Time.Value.ToShortTimeString()"
                                           Message="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_HOST_RESERVATION_LOGIN_BLOCK_TIME_REACHED_MESSAGE))" />
                    }
                    else if (HostReservationViewState.ReservationNotificationTimeReached)
                    {
                        <ReservationNotice Time="@HostReservationViewState.Time.Value.ToShortTimeString()"
                                           Message="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_HOST_RESERVATION_LOGIN_NOTIFICATION_TIME_REACHED_MESSAGE))" />
                    }
                }
            </div>

            <div class="giz-client-status" @onclick="test">
                <ClientLanguageMenu />

                <div class="giz-server">
                    <Layout_LoginServerConnection />
                    <div class="giz-version">
                        <div class="giz-version__title">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_SYSTEM_VERSION))</div>
                        <div class="giz-version__version">@ClientVersionViewState.Version</div>
                    </div>
                </div>
            </div>

        </div>
        <div class="giz-login__login @ClassName">
            @Body
            <DialogHost />
        </div>
    </div>

    @if (HostOutOfOrderViewState.IsOutOfOrder)
    {
        <Layout_LoginOutOfOrder />
    }
    else
    {
        <Layout_LoginLock />        
    }

</main>
