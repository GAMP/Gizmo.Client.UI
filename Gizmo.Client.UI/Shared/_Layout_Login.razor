@inherits LayoutComponentBase
@using Gizmo.UI;
@using Microsoft.Extensions.Options

@if (!string.IsNullOrEmpty(ClientUIOptions.CurrentValue.StyleSheet))
{
    <HeadContent>
        <link href="style.css" rel="stylesheet" />
    </HeadContent>
}

<main client-theme="true">
    <div class="giz-main-container">
        <div class="giz-login-content @ClassName">
            @if (LoginRotatorViewState.IsEnabled)
            {
                <Layout_LoginRotator />
            }
            else if (HasClubBackground)
            {
                <Layout_LoginWallpaper />
            }

            <div class="giz-login-hardcoded-bg">
                <div class="giz-flow" aria-hidden="true">
                    <span class="giz-flow__sheet giz-flow__sheet--1"></span>
                    <span class="giz-flow__sheet giz-flow__sheet--2"></span>
                </div>
                <div class="giz-login-art" aria-hidden="true">
                    <img class="giz-login-art__image" src="_content/Gizmo.Client.UI/img/idle-ribbons.webp" alt="" />
                    <span class="giz-login-art__tint"></span>
                    <span class="giz-login-art__lift"></span>
                </div>
            </div>

            @if (HostNumberViewState.HostNumberIsEnabled)
            {
                <div class="giz-host-number @(UserIdleViewState.IsIdle ? HostNumberViewState.CurrentPosition : "")"
                     style="--transition-duration: @(HostNumberViewState.AnimationDuration)s">
                    <HostNumber />
                </div>
            }


            @if (!string.IsNullOrEmpty(LogoViewState.Logo))
            {
                <div class="giz-login-logo">
                    <img src="@LogoViewState.Logo" alt='loading' />
                </div>
            }

            <div class="giz-login-warnings">
                @if (HostReservationViewState.ReservationBlockTimeReached)
                {
                    <ReservationNotice Time="@HostReservationViewState.Time.Value.ToShortTimeString()"
                                       IsBlocking="true"
                                       Message="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_HOST_RESERVATION_LOGIN_BLOCK_TIME_REACHED_MESSAGE))" />
                }
                else if (HostReservationViewState.ReservationNotificationTimeReached)
                {
                    <ReservationNotice Time="@HostReservationViewState.Time.Value.ToShortTimeString()"
                                       Message="@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_HOST_RESERVATION_LOGIN_NOTIFICATION_TIME_REACHED_MESSAGE))" />
                }
            </div>

            <div class="giz-client-status" @onclick="test">
                <ClientLanguageMenu />
                <div class="giz-version">
                    <Layout_LoginServerConnection />
                    <span>Gizmo @ClientVersionViewState.Version</span>
                </div>
            </div>

        </div>
        <div class="giz-login__login @ClassName">
            @if (_card.Welcome is { } welcome)
            {
                <RegistrationWelcome Card="@welcome" OnDone="@CloseWelcome" />
            }
            else if (CurrentSignupStage == SignupStage.Rules)
            {
                <div class="giz-signup giz-signup--rules">
                    <CascadingValue Value="@_card" IsFixed="true">
                        @Body
                    </CascadingValue>
                </div>
            }
            else if (CurrentSignupStage is { } signupStage)
            {
                <div class="giz-signup">
                    <div class="giz-signup__bar">
                        @if (_card.Back is { } back)
                        {
                            <button type="button" class="giz-signup__back" @onclick="@(() => back())">
                                <i class="ph-bold ph-arrow-left"></i>
                                <span>@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_BACK))</span>
                            </button>
                        }
                        <div class="giz-signup__signin">
                            <span>@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_LOGIN_ALREADY_A_MEMBER))</span>
                            <Gizmo.Client.UI.Pages.Registration.RegistrationSignInLink>@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_REGISTRATION_SIGN_IN))</Gizmo.Client.UI.Pages.Registration.RegistrationSignInLink>
                        </div>
                    </div>
                    <div class="giz-signup__main">
                        <div class="giz-signup__card">
                            <div class="giz-signup-card-stack">
                                <div class="giz-signup-card-stack__back"></div>
                                <PlayerCard Data="@_card.Draft" />
                            </div>
                        </div>
                        <div class="giz-signup__form">
                            <CascadingValue Value="@_card" IsFixed="true">
                                @Body
                            </CascadingValue>
                        </div>
                    </div>
                    <SignupRoad Stages="@RoadStages" Current="@signupStage" />
                </div>
            }
            else
            {
                <CascadingValue Value="@_card" IsFixed="true">
                    <CascadingValue Value="@_recovery" IsFixed="true">
                        @Body
                    </CascadingValue>
                </CascadingValue>
            }
            <DialogHost />
        </div>
    </div>

    @if (HostOutOfOrderViewState.IsOutOfOrder)
    {
        <Layout_LoginOutOfOrder />
    }
    else
    {
        <Layout_LoginLock />
    }

</main>
