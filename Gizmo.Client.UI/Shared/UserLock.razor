@inherits CustomDOMComponentBase
@using Microsoft.AspNetCore.Components.Forms

@if (IsShown)
{
    <EditForm EditContext="@UserLockService.EditContext">
        <div class="giz-lock @LockModifier" tabindex="0" @ref="_root" @onkeydown="@OnKeyDown">
            <div class="giz-lock__veil"></div>
            <div class="giz-lock__stage">
                @if (HasTimeLeft)
                {
                    <section class="giz-lock__time">
                        <div class="giz-lock__label">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_LOCK_TIME_LEFT)</div>
                        <div class="giz-lock__left">
                            @if (HoursLeft > 0)
                            {
                                <b>@HoursLeft</b>
                                <span>@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_UNIT_HOURS)</span>
                            }
                            <b>@MinutesLeft</b>
                            <span>@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_UNIT_MINUTES)</span>
                        </div>
                        <div class="giz-lock__until">@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_LOCK_ENOUGH_UNTIL, EnoughUntilText)</div>
                    </section>
                }

                <section class="giz-lock__pin">
                    <header class="giz-lock__head">
                        <div class="giz-lock__name">@HeadTitle</div>
                        <div class="giz-lock__sub">@HeadSubtitle</div>
                    </header>

                    <div class="giz-lock__code">
                        <div class="giz-lock__dots">
                            @for (int i = 0; i < PIN_LENGTH; i++)
                            {
                                <span class="@DotClass(i)"></span>
                            }
                        </div>
                        <div class="giz-lock__msg">
                            @if (IsErrorShown)
                            {
                                <i class="ph-bold ph-warning-circle"></i>
                                <span>@ViewState.Error</span>
                            }
                        </div>
                    </div>

                    <div class="giz-lock__pad">
                        @for (int i = 1; i <= 9; i++)
                        {
                            int digit = i;
                            <button type="button" class="giz-lock__key" @onclick="@(() => PressDigitAsync(digit))">@digit</button>
                        }
                        <span></span>
                        <button type="button" class="giz-lock__key" @onclick="@(() => PressDigitAsync(0))">0</button>
                        <button type="button" class="giz-lock__key giz-lock__key--quiet" aria-label="@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_LOCK_ERASE)" @onclick="@(() => UserLockService.DeleteDigitAsync())"><i class="ph-bold ph-backspace"></i></button>
                    </div>

                    @if (ViewState.IsLocking)
                    {
                        <div class="giz-lock__actions giz-lock__actions--two">
                            <button type="button" class="giz-lock__ghost" @onclick="@(() => UserLockService.CancelLockAsync())">@GrafitLocalization.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_GEN_CANCEL))</button>
                            <button type="button" class="giz-lock__go" disabled="@IsPinIncomplete" @onclick="@(() => UserLockService.SetPasswordAsync())">
                                <i class="ph-bold ph-lock-simple"></i>
                                <span>@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_LOCK_LOCK)</span>
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="giz-lock__actions">
                            <button type="button" class="giz-lock__go" @onclick="@(() => UserLockService.UnlockAsync())">
                                <i class="ph-bold ph-lock-simple-open"></i>
                                <span>@GrafitLocalization.GetString(GrafitResourceKeys.SHELL_LOCK_UNLOCK)</span>
                            </button>
                        </div>
                    }
                </section>
            </div>
        </div>
    </EditForm>
}
