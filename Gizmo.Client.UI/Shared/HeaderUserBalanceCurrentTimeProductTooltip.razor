@namespace Gizmo.Client.UI.Components
@inherits CustomDOMComponentBase
@using Gizmo.Client.UI.View.States

<div class="gg-tt">
    <div class="gg-tt__head">
        <div class="gg-tt__title">@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_MENU_BALANCE_TOOLTIP_TITLE))</div>
        <button type="button" class="gg-tt__link" @onclick="OpenDetails">
            <span>@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_MENU_BALANCE_TOOLTIP_SEE_ALL_AVAILABLE_TIME))</span>
            <i class="ph-bold ph-arrow-right"></i>
        </button>
    </div>

    @if (TimeProductsViewState.IsInitializing)
    {
        <div class="gg-tt__wait"><Spinner /></div>
    }
    else if (ActiveProducts.Count == 0)
    {
        <div class="gg-tt__empty">@ShellText.Get(ShellText.TIME_TOOLTIP_EMPTY)</div>
    }
    else
    {
        <div class="gg-tt__list">
            @foreach (var product in ActiveProducts)
            {
                <div class="@RowClass(product)">
                    <span class="gg-tt__order">@product.ActivationOrder</span>
                    <span class="gg-tt__type"><i class="ph-fill @TimeProductText.Icon(product.TimeProductType)"></i></span>
                    <div class="gg-tt__name">
                        <b>@TimeProductText.Name(product)</b>
                        <small>
                            @ShellText.Get(TimeProductText.TypeKey(product.TimeProductType))
                            @if (product.InCredit)
                            {
                                <span class="gg-tt__credit-mark">@ShellText.Get(ShellText.TIME_IN_CREDIT)</span>
                            }
                        </small>
                    </div>
                    <div class="gg-tt__stat">
                        <small>@ShellText.Get(ShellText.TIME_TOOLTIP_LEFT)</small>
                        <b>@TimeProductText.Span(product.RemainingTime)</b>
                    </div>
                    <div class="gg-tt__stat">
                        <small>@ShellText.Get(ShellText.TIME_TOOLTIP_SPENDABLE)</small>
                        <b>@TimeProductText.Span(product.UsableTime)</b>
                    </div>
                </div>
            }
        </div>
    }

    @if (SessionWillNotExpire)
    {
        <div class="gg-tt__foot">
            <div class="gg-tt__note">
                <i class="ph-fill ph-infinity"></i>
                <div>
                    <b>@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_MENU_BALANCE_TOOLTIP_SESSION_WILL_NOT_EXPIRE_MESSAGE))</b>
                    <span>@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_MENU_BALANCE_TOOLTIP_CLOSE_BALANCE_MESSAGE))</span>
                </div>
            </div>
            @if (HasActions)
            {
                <div class="gg-tt__actions">
                    @if (CanTopUp)
                    {
                        <button type="button" class="@TopUpButtonClass" @onclick="OpenUserOnlineDeposit" @onclick:stopPropagation="true">
                            <i class="ph-fill ph-wallet"></i>
                            <span>@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_MENU_BALANCE_TOOLTIP_TOP_UP))</span>
                        </button>
                    }
                    @if (CanShop)
                    {
                        <button type="button" class="gg-tt__btn gg-tt__btn--primary" @onclick="OpenShop">
                            <i class="ph-fill ph-package"></i>
                            <span>@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_MENU_BALANCE_TOOLTIP_GO_TO_SHOP))</span>
                        </button>
                    }
                </div>
            }
        </div>
    }
    else if (SessionWillExpire)
    {
        <div class="gg-tt__foot">
            <div class="@ExpireNoteClass">
                <i class="ph-fill @ExpireNoteIcon"></i>
                <div>
                    <b>@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_MENU_BALANCE_TOOLTIP_SESSION_WILL_EXPIRE_MESSAGE))</b>
                    @if (ContinueMessageKey is not null)
                    {
                        <span>@LocalizationService.GetString(ContinueMessageKey)</span>
                    }
                </div>
            </div>
            @if (HasActions)
            {
                <div class="gg-tt__actions">
                    @if (CanTopUp)
                    {
                        <button type="button" class="@TopUpButtonClass" @onclick="OpenUserOnlineDeposit" @onclick:stopPropagation="true">
                            <i class="ph-fill ph-wallet"></i>
                            <span>@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_MENU_BALANCE_TOOLTIP_TOP_UP))</span>
                        </button>
                    }
                    @if (CanShop)
                    {
                        <button type="button" class="gg-tt__btn gg-tt__btn--primary" @onclick="OpenShop">
                            <i class="ph-fill ph-package"></i>
                            <span>@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_MENU_BALANCE_TOOLTIP_GO_TO_SHOP))</span>
                        </button>
                    }
                </div>
            }
        </div>
    }
    else if (ShowCreditNote)
    {
        <div class="gg-tt__foot">
            <div class="gg-tt__note">
                <i class="ph-fill ph-hand-coins"></i>
                <div><b>@LocalizationService.GetString(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_MENU_BALANCE_TOOLTIP_CREDIT))</b></div>
            </div>
        </div>
    }
</div>
