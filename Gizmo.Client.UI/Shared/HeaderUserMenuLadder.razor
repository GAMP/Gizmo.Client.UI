@namespace Gizmo.Client.UI
@inherits CustomDOMComponentBase
@using Gizmo.Client.UI.Services

@if (ViewState.HasLevel)
{
    <button type="button" class="giz-header-ladder" @onclick="Service.OpenLadder">
        <LadderLevelBadge Ordinal="@ViewState.Ordinal" EmblemUrl="@ViewState.EmblemUrl" Class="giz-ladder-badge--topbar" />
        <span class="giz-header-ladder__text">
            <span class="giz-header-ladder__name">@ViewState.LevelName</span>
            @if (ViewState.ShowTopBarProgress)
            {
                <span class="giz-header-ladder__progress">
                    <span class="giz-header-ladder__progress-fill @(ViewState.TopBarProgressIsFull ? "giz-header-ladder__progress-fill--full" : "")" style="width: @AchievementValueFormat.Percent(ViewState.TopBarProgressPercent)"></span>
                </span>
            }
        </span>
    </button>
    <span class="giz-header-ladder-divider"></span>
}
