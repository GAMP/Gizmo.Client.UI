@namespace Gizmo.Client.UI
@using Gizmo.UI;
@inherits CustomDOMComponentBase

@* The type used to be readable only from a nested <svg> wrapper's class,
   which is why the old styling reached for :has(). Now that the icon is
   gone the type goes straight on the card - it is the card's own colour. *@
<div class="giz-notification @TypeModifier">
    <div class="giz-notification__body">
        <div class="giz-notification__body__title">@Title</div>
        <div class="giz-notification__body__message">@Message</div>
    </div>
    <div class="giz-notification__close-button">
        <IconButton SVGIcon="Icons.Close" Variant="ButtonVariants.Text" Size="ButtonSizes.Small" Class="close-btn" @onclick="() => CloseNotification()" />
    </div>
</div>
