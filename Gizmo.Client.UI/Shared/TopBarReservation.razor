@namespace Gizmo.Client.UI.Shared
@inherits ShellComponentBase

@if (HasReservation)
{
    <div class="@ClassName"
         role="@(IsIgnored ? "button" : null)"
         tabindex="@(IsIgnored ? "0" : null)"
         @onclick="OpenReservation"
         @onkeydown="OnReservationKey">
        <i class="ph-fill ph-calendar-check giz-resv__icon"></i>
        <span class="giz-resv__lead">@LeadText</span>
        <b class="giz-resv__at">@FromText</b>
        @if (CountdownText is string countdown)
        {
            <span class="giz-resv__count">@countdown</span>
        }
        @if (IsIgnored)
        {
            <i class="ph-bold ph-caret-right giz-resv__go"></i>
        }
    </div>
}
