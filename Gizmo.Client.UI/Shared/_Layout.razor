@inherits LayoutComponentBase
@using Microsoft.Extensions.Options
@using System.Globalization
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject Gizmo.UI.Services.ILocalizationService LocalizationService
@implements IDisposable

<style>
    /* ── Page transition ── */
    @@keyframes gg-page-in {
        from { opacity: 0; transform: translateY(7px); }
        to   { opacity: 1; transform: none; }
    }
    .giz-app__body > * {
        animation: gg-page-in 0.22s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
    }

    /* ── Phosphor Icons (brief section 9/0): every shell icon renders as a
       webfont glyph now, not the old inline-SVG set. Size is font-size
       (there's no width/height on a character), colour inherits by default
       so the existing text-colour rules on each context keep working. This
       base rule is display/alignment only - per-icon size lives on the
       specific selector that used to size the SVG version. ── */
    .giz-ph-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
        flex-shrink: 0;
    }
    /* Sidebar nav: bold (outline) glyph at rest, fill glyph swaps in on the
       active route - only one of the pair is ever visible. */
    .giz-nav-icon--fill { display: none; }
    a.active .giz-nav-icon--bold { display: none; }
    a.active .giz-nav-icon--fill { display: inline-flex; }

    /* ── Wallpaper — the "Liquid Glass" atmosphere from the Nexus Play brief
       (section 2). This is the single most important surface in the whole
       shell: every glass panel only reads as glass because there is a rich,
       lit, coloured field behind it. The previous version collapsed to
       height:0 (the hidden <img> was the only thing giving it size), so all
       that showed was the near-black body colour and every panel looked like
       a flat grey box. It now fills the viewport as a fixed layer.

       Base: a deep purple-charcoal gradient (var(--gg-bg-2) → var(--gg-bg-1) → var(--gg-bg-3)).
       Clouds: three big, soft, coloured blobs — purple top-left, indigo
       bottom-right, magenta centre. Static, not drifting: an earlier version
       animated these with translate3d/scale, which read as the whole
       background "riding"/shifting rather than a calm atmosphere - a plain
       fixed gradient matches the reference design and the panels floating
       on top of it don't move relative to it either, so drift never actually
       added anything. ── */
    /* The picture is the club's own wallpaper, and it is shown only when the club has
       set one (.giz-background--club); with nothing configured the vendor falls back
       to a stock photograph, and this shell shows its atmosphere instead. */
    .giz-background img { display: none; }
    .giz-background--club { background: var(--gg-bg-0); }
    .giz-background--club img {
        display: block;
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    /* The atmosphere is defined once and painted TWICE: on .giz-background and
       on html/body. That redundancy is the actual fix for the dark band that
       showed above the taskbar.

       The band was never "the shell failing to draw". It was the seam between
       two differently coloured layers: body's own near black (var(--gg-bg-0)) showing
       wherever the atmosphere layer did not land on exactly the same device
       pixel. Any of these opens such a seam, and all of them move with display
       scaling, which is why it looked scaling dependent:
         - 100vh resolves against a viewport whose CSS pixel height is
           fractional at 125%/150% scaling, so the box lands a fraction short;
         - the host sizing the WebView a hair under the window;
         - sub-pixel rounding of a fixed element's bottom edge.

       Chasing each of those separately is whack-a-mole. Painting body with the
       identical background instead makes the seam the same colour as the shell,
       so it cannot be seen at any scale even if it still exists geometrically.
       background-attachment:fixed makes body's copy resolve against the
       viewport, so the two are pixel aligned rather than merely similar. */
    /* The atmosphere itself is a palette token (--gg-atmosphere, _palette.scss): its
       clouds and its base are the accent's own hues, so a club that picks another
       accent gets a background in that colour without touching this file. */
    :root {
        --giz-atmosphere: var(--gg-atmosphere);
    }

    /* #app MUST be in this chain. It is the div the Blazor root component is
       mounted into (the id="app" div in wwwroot/index.html), and it sits
       between body and main. A percentage height resolves against the parent's
       height, so leaving #app at auto broke the chain: main, and therefore
       .giz-root, fell back to auto and the whole shell grew to the height of
       its content. On a long list (Apps, Shop) that stretched the window to the
       full length of the list and dragged the nav rail and cart along with it. */
    html, body, #app {
        height: 100%;
    }

    html, body {
        background: var(--giz-atmosphere);
        background-attachment: fixed;
    }

    .giz-background {
        position: fixed;
        inset: 0;
        z-index: 0;
        overflow: hidden;
        background: var(--giz-atmosphere);
    }

    /* ── Root wrapper: top bar + main row ──
       Panels float: the root carries the outer inset and the gap between
       islands, so the bar and the rail are detached from the window edges
       and from each other rather than docked flush. */
    /* main has to carry the height for .giz-root's percentage to resolve -
       a percentage height against an auto height parent computes to auto. */
    main[client-theme] {
        height: 100%;
    }

    .giz-root {
        display: flex;
        flex-direction: column;
        /* 100% of the real client box, not 100vh. vh is resolved against the
           initial containing block and lands on a fractional device pixel under
           non-integer display scaling; the percentage chain from html/body
           cannot drift that way. */
        height: 100%;
        overflow: hidden;
        position: relative;
        z-index: 1; /* sits above the fixed .giz-background atmosphere */
        /* The bottom inset is the same hair the top has: the content column runs to
           the screen's edge instead of stopping a hand's width above it, which read
           as a strip cut off the shell (the home board adds nothing of its own at the
           bottom either - see .gg-board). */
        padding: 0.8rem 1.4rem 0.8rem;
        gap: 1.4rem;
        box-sizing: border-box;
    }

    /* ── Top bar ── per the Nexus Play brief (section 6.1): three floating
       glass pills - search (left), a session HUD capsule (centre), and an
       icon-actions + profile group (right). The HUD is taken out of normal
       flow entirely (position:absolute, centred via left:50%+transform)
       instead of trying to balance it between search and the right group -
       a `1fr auto 1fr` grid looked like the right tool but isn't: with
       default auto track minimums, CSS Grid gives a track *at least* its
       content's min-size before applying the fr ratio, and search (fixed
       36rem) vs the icon/profile group (much narrower) don't need the same
       minimum, so the two "equal" 1fr tracks came out ~180px apart in
       practice - the HUD centre was still tracking side content width, just
       less obviously than before. Absolute positioning has no such
       dependency: the HUD's centre is exactly 50% of the bar, full stop,
       regardless of what's on either side. */
    /* Three tracks: search and reservation on the left, the session tile in the middle,
       icons and profile on the right.

       The centre tile used to be absolutely positioned in the middle with flex sides. The
       centre then depended on nothing - but the tile took no room in the flow, so anything
       to its left slid underneath it, and the gap up to it had to be guessed as a number.

       minmax(0, 1fr) on both sides is the exact centre: the side tracks are equal by
       definition, because their lower bound is zero and their content cannot inflate them.
       The gaps are now computed by the grid from a single gap value. */
    .giz-top-bar {
        flex-shrink: 0;
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
        align-items: center;
        gap: 1.2rem;
        height: 7.2rem;
        z-index: 500;
    }
    /* Stretched across its track and aligned inside it, not justify-self: end: an item
       aligned at the end is sized to its content, and content wider than the track then
       runs over the session tile in the middle. */
    .giz-top-bar__right-group { justify-self: stretch; justify-content: flex-end; }
    /* Left track: search and the reservation tile. The tile takes the rest of the track,
       so the gap between it and the centre tile is exactly the gap between the search and
       the tile - both come from the bar's own gap. */
    .giz-top-bar__left {
        display: flex;
        align-items: center;
        gap: 1.2rem;
        min-width: 0;
    }
    /* When the bar is short of room the search yields, not the tile: a narrower search is
       still a search, while a tile clipped to "This mach..." says nothing. */
    .giz-top-bar__left .giz-top-bar__search,
    .giz-top-bar__left .giz-header__global-search {
        min-width: 22rem;
        flex-shrink: 1;
    }
    .giz-top-bar__left .giz-resv {
        flex: 1 1 auto;
        min-width: 0;
        overflow: hidden;
    }
    /* The countdown tail goes first - the start time matters more. */
    .giz-top-bar__left .giz-resv__lead { flex: none; }
    .giz-top-bar__left .giz-resv__count {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    /* min-width: 0 so the group can be narrower than its content wants: on a 1366 panel
       the right track is about 40rem and the icon pill, an open deployment banner and
       the profile pill ask for 60. Without it the group kept its full width and slid
       over the session tile. The banner is what gives way - see .giz-deploy. */
    .giz-top-bar__right-group {
        display: flex;
        align-items: center;
        gap: 1.2rem;
        min-width: 0;
    }
    /* Shared glass surface for every top-bar pill: a clear wash over the blur. The
       panels that OPEN from these pills are a different material - see "DROPDOWN
       PANEL" below - because they sit over content and must hide it. */
    .giz-top-bar__search .giz-global-search,
    .giz-top-bar__hud,
    .giz-top-bar__icons,
    .giz-avatar-nudge,
    .giz-deploy,
    .giz-resv,
    .giz-top-bar .giz-user-menu-button {
        background: linear-gradient(180deg, rgba(255,255,255,0.08), rgba(255,255,255,0.03));
        backdrop-filter: blur(4rem) saturate(1.6);
        -webkit-backdrop-filter: blur(4rem) saturate(1.6);
        border: 1px solid rgba(255,255,255,0.10);
        border-radius: 1.6rem;
        box-shadow:
            inset 0 1px 0 rgba(255,255,255,0.16),
            0 2.4rem 6rem -3.4rem rgba(0,0,0,0.7);
    }
    /* Session HUD capsule — sequential segments, hairline dividers between
       them, sized to its own content (no flex-grow) so it reads as a snug
       pill instead of a stretched empty bar. */
    .giz-top-bar__hud {
        position: relative;
        display: flex;
        align-items: center;
        min-width: 0;
        height: 5.8rem;
        padding: 0 2rem;
        gap: 2rem;
        overflow: visible;
        /* The glass lives on ::before, not on the capsule itself: an element with
           backdrop-filter is a "backdrop root", and any backdrop-filter inside it can
           only see what is painted inside it. The tariff tooltip opens from within
           this capsule, and with the blur here it could not blur the page behind it -
           it came out see-through instead of frosted. Same trick as .giz-top-bar__icons. */
        background: none;
        backdrop-filter: none;
        -webkit-backdrop-filter: none;
    }
    .giz-top-bar__hud::before {
        content: '';
        position: absolute;
        inset: 0;
        z-index: -1;
        border-radius: inherit;
        background: linear-gradient(180deg, rgba(255,255,255,0.08), rgba(255,255,255,0.03));
        backdrop-filter: blur(4rem) saturate(1.6);
        -webkit-backdrop-filter: blur(4rem) saturate(1.6);
    }
    .giz-top-bar__divider {
        width: 1px;
        height: 2.2rem;
        background: rgba(255,255,255,0.10);
        flex-shrink: 0;
    }
    /* Icon-actions pill — its own surface, separate from the profile pill
       next to it (small fixed gap via .giz-top-bar's own gap, not a shared
       background).

       The blur is deliberately NOT on this element: it hosts the
       active-apps dropdown, and each app row's action menu is a
       position:fixed Popup whose wrapper is sized 100vw/100vh and whose
       inner panel is placed from getBoundingClientRect() viewport
       coordinates. backdrop-filter makes an element the containing block
       for fixed descendants, so that wrapper was being anchored to this
       pill's own box instead of the viewport - the menu opened roughly a
       screen-width off to the right and read as "the caret does nothing".
       Moving the surface to a ::before layer keeps the look and takes this
       element out of the popup's ancestor chain for containing-block
       purposes. Same fix already applied to .giz-login-card and
       .giz-active-apps. */
    .giz-top-bar__icons {
        position: relative;
        display: flex;
        align-items: center;
        height: 5.8rem;
        padding: 0 0.6rem;
        background: none;
        backdrop-filter: none;
        -webkit-backdrop-filter: none;
    }
    .giz-top-bar__icons::before {
        content: '';
        position: absolute;
        inset: 0;
        z-index: -1;
        border-radius: inherit;
        background: linear-gradient(180deg, rgba(255,255,255,0.08), rgba(255,255,255,0.03));
        backdrop-filter: blur(4rem) saturate(1.6);
        -webkit-backdrop-filter: blur(4rem) saturate(1.6);
    }
    .giz-actions-bar {
        display: flex;
        align-items: center;
        height: 100%;
        gap: 0.2rem;
    }
    /* Remaining time - the stat everything else is arranged around. No icon
       badge, no glow: just bold digits. Minimal on purpose - the size is
       what carries the emphasis, not decoration. */
    .giz-top-bar__time {
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }
    .giz-top-bar__time .giz-ph-icon {
        font-size: 1.7rem;
        color: rgba(255,255,255,0.4);
    }
    .giz-top-bar__time-value {
        font-family: 'Space Grotesk', 'Manrope', sans-serif;
        font-size: 1.5rem;
        font-weight: 700;
        color: #ffffff;
        letter-spacing: 0.01em;
        white-space: nowrap;
    }
    /* Profile pill - its own separate glass surface, not fused with the icon pill. */
    .giz-top-bar__account {
        flex-shrink: 0;
    }
    .giz-top-bar .giz-header__user-menu-item {
        height: 100% !important;
    }

    /* Deployment banner.
       Width 0 at rest, growing when it appears, pushing the icon pill left by ordinary
       flex reflow.

       Progress is a ring around the badge plus a feathered wash under the content. The
       first version was a hard-edged fill with a bright rim, and a segment sliding along
       the pill while the size was unknown - "a square moved along a strip". Nothing here
       has a moving edge any more: the wash fades out over its last 7rem, the ring turns
       in place, and the sheen is a pass of light over the whole pill. */
    /* ── The invitation to add a picture ──
       Same slot and same mechanics as the deployment pill: width 0 at rest, growing in
       when it has something to say, the icon cluster sliding left by ordinary reflow.
       Only ever shown when the club runs its own picture service (--gg-avatars), and it
       steps aside while the slot holds anything that matters more (TopBannerArbiter). */
    .giz-avatar-nudge {
        display: flex;
        align-items: center;
        height: 5.8rem;
        width: 0;
        padding: 0;
        gap: 0;
        overflow: hidden;
        opacity: 0;
        flex-shrink: 0;
        cursor: pointer;
        transition:
            width 0.5s cubic-bezier(0.19, 1, 0.22, 1),
            padding 0.5s cubic-bezier(0.19, 1, 0.22, 1),
            opacity 0.35s ease;
    }
    /* The accent, not the shared neutral glass: this one has to be seen. */
    .giz-avatar-nudge.open {
        width: 34rem;
        padding: 0 1.6rem 0 1.4rem;
        gap: 1.1rem;
        opacity: 1;
        background: linear-gradient(135deg, rgba(var(--gg-accent-rgb),0.95), rgba(var(--gg-accent-rgb),0.7)) !important;
        border-color: rgba(255,255,255,0.28) !important;
        animation: giz-avatar-nudge-pulse 3.2s ease-in-out 0.6s infinite;
    }
    .giz-avatar-nudge__badge {
        flex-shrink: 0;
        font-size: 2.6rem;
        color: var(--gg-on-accent);
        opacity: 0.95;
    }
    .giz-avatar-nudge__text {
        flex: 1 1 auto;
        min-width: 0;
    }
    /* One line each: two lines for the pill reads cleaner than three. */
    .giz-avatar-nudge__text__title {
        font-family: Rubik, sans-serif;
        font-size: 1.28rem;
        font-weight: 800;
        line-height: 1.6rem;
        color: var(--gg-on-accent);
        letter-spacing: 0.005em;
        white-space: nowrap;
    }
    .giz-avatar-nudge__text__sub {
        font-size: 1.2rem;
        font-weight: 500;
        line-height: 1.6rem;
        color: var(--gg-on-accent);
        opacity: 0.75;
        white-space: nowrap;
    }
    .giz-avatar-nudge__arrow {
        flex-shrink: 0;
        font-size: 1.8rem;
        color: var(--gg-on-accent);
        animation: giz-avatar-nudge-arrow 1.6s ease-in-out infinite;
    }
    /* A breathing glow rather than a blinking border: "look here" without flickering
       in the corner of the eye. */
    @@keyframes giz-avatar-nudge-pulse {
        0%, 100% {
            box-shadow:
                inset 0 1px 0 rgba(255,255,255,0.28),
                0 1.2rem 3rem -1rem rgba(var(--gg-accent-rgb),0.5);
            transform: scale(1);
        }
        50% {
            box-shadow:
                inset 0 1px 0 rgba(255,255,255,0.28),
                0 1.2rem 3rem -1rem rgba(var(--gg-accent-rgb),0.6);
            transform: scale(1.015);
        }
    }
    @@keyframes giz-avatar-nudge-arrow {
        0%, 100% { transform: translateX(0); opacity: 0.7; }
        50% { transform: translateX(4px); opacity: 1; }
    }

    /* Sized through flex-basis rather than width so the banner can shrink when the bar is
       short of room (a 1366 panel, or a reservation tile on the left): the text clips
       inside it and the badge, percentage and close button stay. The growth on
       appearance is the basis going from zero, the same motion as before. */
    .giz-deploy {
        position: relative;
        display: flex;
        align-items: center;
        height: 5.8rem;
        flex: 0 1 0rem;
        min-width: 0;
        padding: 0;
        gap: 0;
        overflow: hidden;
        opacity: 0;
        transition:
            flex-basis 0.5s cubic-bezier(0.19, 1, 0.22, 1),
            padding 0.5s cubic-bezier(0.19, 1, 0.22, 1),
            opacity 0.35s ease;
    }
    .giz-deploy.open {
        flex-basis: 34rem;
        /* Never less than the badge and the close button: a banner that cannot be
           dismissed is worse than one that overlaps by a few pixels. */
        min-width: 9rem;
        padding: 0 3.8rem 0 1.2rem;
        gap: 1.1rem;
        opacity: 1;
        border-color: rgba(var(--gg-accent-rgb), 0.45) !important;
        box-shadow:
            inset 0 1px 0 rgba(255,255,255,0.16),
            0 1.2rem 3rem -1.2rem rgba(var(--gg-accent-rgb), 0.55) !important;
    }
    .giz-deploy.open.is-done {
        border-color: rgba(94,216,148,0.5) !important;
        box-shadow:
            inset 0 1px 0 rgba(255,255,255,0.16),
            0 1.2rem 3rem -1.2rem rgba(94,216,148,0.45) !important;
    }
    /* The wash. Its edge is feathered by a mask over the last 7rem, so the width
       growing once a second reads as light spreading, not as a block moving. min-width
       keeps a whisper of it at 0%: the mask fades that whisper to nothing anyway. */
    .giz-deploy__fill {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        z-index: 0;
        min-width: 6rem;
        background: linear-gradient(90deg, rgba(var(--gg-accent-rgb), 0.3), rgba(var(--gg-accent-rgb), 0.14));
        mask-image: linear-gradient(90deg, #000, #000 calc(100% - 7rem), transparent);
        -webkit-mask-image: linear-gradient(90deg, #000, #000 calc(100% - 7rem), transparent);
        /* Progress arrives once a second - without this the fill would step. */
        transition: width 0.9s linear, opacity 0.4s ease;
    }
    .giz-deploy.is-done .giz-deploy__fill {
        background: linear-gradient(90deg, rgba(94,216,148,0.26), rgba(63,184,122,0.1));
        mask-image: none;
        -webkit-mask-image: none;
    }
    /* File sizes are not known yet: no percentage, no wash - the ring turns instead. */
    .giz-deploy.is-waiting .giz-deploy__fill {
        opacity: 0;
    }
    /* Sheen across the whole banner - a slow pass of light, the second sign of life.
       z-index: 1 rather than 0: ::before is the first child, and at equal z-index the
       fill (a real element, later in the DOM) would cover it. */
    .giz-deploy.open:not(.is-done)::before {
        content: '';
        position: absolute;
        inset: 0;
        z-index: 1;
        pointer-events: none;
        background: linear-gradient(100deg, transparent 24%, rgba(255,255,255,0.07) 48%, transparent 70%);
        background-size: 240% 100%;
        animation: giz-deploy-sheen 3.4s ease-in-out infinite;
    }
    /* The badge: the icon on a faint disc, with the progress ring drawn around it. */
    .giz-deploy__badge {
        position: relative;
        z-index: 1;
        flex-shrink: 0;
        width: 3.6rem;
        height: 3.6rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: rgba(var(--gg-accent-rgb), 0.14);
        color: var(--gg-accent-pale);
        font-size: 1.6rem;
    }
    .giz-deploy__ring {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        /* The bar starts at twelve o'clock. */
        transform: rotate(-90deg);
    }
    .giz-deploy__ring-track,
    .giz-deploy__ring-bar {
        fill: none;
        stroke-width: 2.6;
    }
    .giz-deploy__ring-track {
        stroke: rgba(255,255,255,0.12);
    }
    /* Circumference of the r=17.5 circle; the markup writes the offset. */
    .giz-deploy__ring-bar {
        stroke: var(--gg-accent-light);
        stroke-linecap: round;
        stroke-dasharray: 109.96;
        transition: stroke-dashoffset 0.9s linear;
    }
    /* Unknown size: a short arc going round. The markup writes offset 0 for this. */
    .giz-deploy.is-waiting .giz-deploy__ring {
        animation: giz-deploy-spin 1.4s linear infinite;
    }
    .giz-deploy.is-waiting .giz-deploy__ring-bar {
        stroke-dasharray: 26 83.96;
        transition: none;
    }
    .giz-deploy.is-done .giz-deploy__badge {
        background: rgba(94,216,148,0.16);
        color: #7ce8ad;
    }
    .giz-deploy.is-done .giz-deploy__ring-bar {
        stroke: #5ed894;
    }
    /* The banner body is a button into the application manager. */
    .giz-deploy__body {
        position: relative;
        z-index: 1;
        flex: 1 1 auto;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.1rem;
        padding: 0;
        border: 0;
        background: none;
        color: inherit;
        font-family: inherit;
        text-align: left;
        cursor: pointer;
    }
    .giz-deploy__title {
        font-family: Rubik, sans-serif;
        font-size: 1.16rem;
        font-weight: 800;
        line-height: 1.6rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #fff;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .giz-deploy__sub {
        font-size: 1.25rem;
        font-weight: 500;
        line-height: 1.7rem;
        color: rgba(255,255,255,0.78);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .giz-deploy__pct {
        position: relative;
        z-index: 1;
        flex: none;
        font-family: 'Space Grotesk', 'Manrope', sans-serif;
        font-size: 1.7rem;
        font-weight: 700;
        color: #fff;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }
    /* Pinned to the right edge rather than last in the row: when the banner has been
       squeezed, the row's tail is what gets clipped, and the close button must not be
       part of the tail. The banner's right padding keeps the text clear of it. */
    .giz-deploy__close {
        position: absolute;
        right: 0.7rem;
        top: 50%;
        transform: translateY(-50%);
        z-index: 1;
        flex-shrink: 0;
        width: 2.8rem;
        height: 2.8rem;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        border: 0;
        border-radius: 50%;
        background: transparent;
        color: rgba(255,255,255,0.5);
        font-size: 1.3rem;
        cursor: pointer;
        transition: background 0.16s, color 0.16s;
    }
    .giz-deploy__close:hover {
        background: rgba(255,255,255,0.1);
        color: #fff;
    }
    @@keyframes giz-deploy-sheen {
        0% { background-position: 130% 0; }
        100% { background-position: -30% 0; }
    }
    @@keyframes giz-deploy-spin {
        from { transform: rotate(-90deg); }
        to { transform: rotate(270deg); }
    }

    /* The top bar must not clip dropdown menus */
    .giz-top-bar { overflow: visible !important; }
    .giz-actions-bar { overflow: visible !important; }
    .giz-top-bar .giz-header__user-menu-item { overflow: visible !important; }
    /* Dropdowns: z-index inside the top bar's stacking context (z-index: 500).
       overflow and max-height are left alone - the skin drives them through inner
       elements that carry box-shadow/border-radius, which overflow:hidden would clip. */
    .giz-top-bar .giz-dropdown-menu {
        z-index: 9000 !important;
        position: absolute !important;
        top: 100% !important;
        right: 0 !important;
        overflow: visible !important;
    }

    /* ── Main row: nav panel + body ──
       align-items:center so the nav panel (sized to its own content, capped
       below) sits centered in the column instead of stretched top-to-bottom;
       the body opts back into full-height stretch explicitly since it still
       needs to fill the row. */
    .giz-container {
        display: flex !important;
        flex-direction: row !important;
        align-items: center !important;
        flex: 1 !important;
        height: auto !important;
        min-height: 0 !important;
        overflow: visible !important; /* floating rail casts a shadow outside the row */
        position: relative !important;
        gap: 1.4rem;
    }
    .giz-app__header { display: none !important; }
    .giz-app__body {
        flex: 1 !important;
        align-self: stretch !important;
        min-width: 0 !important;
        height: 100% !important;
        overflow: hidden !important;
        display: flex !important;
        flex-direction: column !important;
    }

    /* ── Left panel: nav on top, quick-launch below - one floating glass
       column, capped well under the row's full height and centred in it
       (.giz-container has align-items:center) so it grows from the middle
       as apps get pinned rather than being stretched or anchored to the
       top. Nav stays fixed size at the top; the quick-launch dock below it
       is what actually grows - pin more apps and the column gets taller
       (up to the cap, then the dock's own scroll takes over). */
    .giz-left-panel {
        width: 8.5rem;
        /* Grows with pinned apps up to the FULL height of the row, then the
           dock scrolls. Was capped at 90% (and 78% before that), which left
           ~10% of usable height unused - on shorter screens that was enough
           to force the dock to scroll while empty space sat below the rail.
           With a few apps the rail still sizes to its content and floats
           centred; only a genuinely full column reaches this cap. */
        max-height: 100%;
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        /* Same shared glass recipe as the top bar's pills (brief section 4)
           - one material system across the whole shell. */
        background: linear-gradient(180deg, rgba(255,255,255,0.08), rgba(255,255,255,0.03));
        backdrop-filter: blur(4rem) saturate(1.6);
        -webkit-backdrop-filter: blur(4rem) saturate(1.6);
        border: 1px solid rgba(255,255,255,0.10);
        border-radius: 2.6rem;
        box-shadow:
            inset 0 1px 0 rgba(255,255,255,0.16),
            0 2.4rem 6rem -3.4rem rgba(0,0,0,0.7);
        z-index: 100;
    }
    .giz-left-panel__divider {
        height: 1px;
        margin: 0 1rem;
        background: rgba(255,255,255,0.10);
        flex-shrink: 0;
    }
    /* The rail does not scroll. At all.

       This used to be overflow-y:auto with the scrollbar merely hidden
       (scrollbar-width:none + ::-webkit-scrollbar{display:none}), which looks
       identical to "no scrolling" but is not: the element was still a scroll
       container, so the wheel and touchpad still moved it. Combined with the
       0.8rem block padding inside .quick-launcher, content sat a few pixels
       taller than the box and the rail drifted up and down by that much.

       overflow:hidden makes it a genuine non-scroller. Trade-off, stated
       plainly: if more apps are pinned than the rail is tall, the extra ones
       are clipped rather than reachable by scrolling. That is the explicit
       ask - no scroll, ever - and the full list stays available on the Apps
       page. */
    .giz-left-panel__quicklaunch {
        /* flex-basis:auto, NOT the `flex: 1` shorthand. `flex: 1` means
           flex-basis:0, so this block contributed zero to the rail's
           hypothetical height; in a container sized by its content (the rail
           has max-height but no height, and .giz-container centres it) there
           is then no free space to grow back into, so the rail collapsed to
           just the nav block and stopped looking centred. Sizing from content
           lets the rail grow downward as apps are pinned, stay vertically
           centred, and only start clipping once it hits max-height:100%. */
        flex: 0 1 auto;
        min-height: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        overscroll-behavior: contain;
    }
    .giz-sidebar__inner {
        display: flex;
        flex-direction: column;
        padding: 1rem 0;
        align-items: center;
        flex-shrink: 0;
    }

    /* ── Brand ── */
    .giz-sidebar__brand {
        display: flex;
        align-items: center;
        gap: 1.2rem;
        padding: 0 2rem 1.8rem;
        border-bottom: 1px solid rgba(255,255,255,0.07);
        margin-bottom: 1.4rem;
        flex-shrink: 0;
    }
    .giz-sidebar__brand > span {
        font-size: 1.85rem;
        font-weight: 800;
        color: #FAFAFA;
        font-family: Rubik, sans-serif;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    /* ── Navigation ──
       Sizes to its handful of module icons (flex:0 0 auto), never grows or
       scrolls. It used to be flex:1, which split the capped rail 50/50 with
       the quick-launch dock below - so the dock got only half the column and
       started scrolling after a few pinned apps while the nav half sat empty.
       Now the nav takes exactly what it needs and the dock gets everything
       else. */
    .giz-sidebar__nav {
        flex: 0 0 auto;
        overflow: visible;
        padding: 1.2rem 0.8rem;
        display: flex;
        flex-direction: column;
        width: 100%;
    }
    .giz-sidebar__fill { display: none; }

    /* Override skin CSS: vertical icon-only nav. Items are a fixed ~52px square
       (icon 32px + 10px padding each side) with an 8px gap. */
    .giz-left-panel .giz-header__modules-menu {
        display: flex !important;
        flex-direction: column !important;
        gap: 0.8rem !important;
        padding: 0 !important;
        height: auto !important;
        width: 100% !important;
        flex-wrap: nowrap !important;
    }
    .giz-left-panel .giz-header__modules-menu-item {
        width: 100% !important;
        height: auto !important;
    }
    .giz-left-panel .giz-header__modules-menu-item > a {
        display: flex !important;
        flex-direction: row !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 0 !important;
        padding: 0.6rem !important;
        border-radius: 1.4rem !important;
        height: auto !important;
        width: 100% !important;
        box-sizing: border-box !important;
        /* No plate and no outline. Below this column stand bare coloured application
           icons, and boxes above them read as a different interface pasted on top.
           Prominence comes from the glyph's size and brightness, not from a frame. */
        color: rgba(255,255,255,0.66) !important;
        background: transparent !important;
        box-shadow: none !important;
        transition: color 0.15s, background 0.15s !important;
        text-decoration: none !important;
    }
    .giz-left-panel .giz-header__modules-menu-item > a:hover {
        background: rgba(255,255,255,0.07) !important;
        color: #ffffff !important;
    }
    /* Active item: a soft translucent purple squircle, not a solid fill
       (brief: explicitly calls out the old solid-fill treatment as wrong). */
    /* Active section: an accented glyph and a short marker at the rail's left edge rather
       than a filled box. The marker is out of flow, so the items themselves do not move
       when the section changes. */
    .giz-left-panel .giz-header__modules-menu-item > a.active {
        background: rgba(var(--gg-accent-rgb),0.10) !important;
        color: var(--gg-accent) !important;
        box-shadow: none !important;
    }
    .giz-left-panel .giz-header__modules-menu-item > a.active::before {
        content: '' !important;
        display: block !important;
        position: absolute !important;
        left: -0.8rem !important;
        top: 50% !important;
        transform: translateY(-50%) !important;
        width: 0.3rem !important;
        height: 2.2rem !important;
        border-radius: 99px !important;
        background: var(--gg-accent) !important;
    }
    .giz-left-panel .giz-header__modules-menu-item > a {
        position: relative !important;
    }
    /* Same size as the quick launch icons below: the glyph used to be 2.2rem against
       ~4rem, which made the main navigation look like something small and secondary. */
    .giz-left-panel .giz-header__modules-menu-item > a .giz-ph-icon {
        font-size: 3.2rem;
        flex-shrink: 0;
    }
    /* Hide text labels — icon-only mode */
    .giz-left-panel .giz-header__modules-menu-item > a > span {
        display: none !important;
    }

    /* ── Home dashboard ──
       .giz-app__body is a column flex container with a definite height, so the
       board takes the row it is given and never grows with its content. flex
       plus min-height:0 alongside the height:100% in _page-home.scss: the
       percentage covers the plain block case, the flex pair covers the case
       where the body's own height is still resolving. */
    .gg-board {
        flex: 1 !important;
        min-height: 0 !important;
        /* Fluid, like everything else on the board: a fixed 1.6rem gutter that
           reads as a comfortable margin on a 1080 panel leaves a tile pressed
           against the glass on a 1440 one. */
        padding: clamp(1.2rem, 1.5vh, 2.6rem) clamp(1.4rem, 1.4vw, 3.2rem) 0;
    }

    /* ── Reservation notice ──
       Lives in the top bar between the search field and the session HUD, so it
       is visible on every page rather than only on Home.

       Attention comes from a slow breath, not from brightness: the pill drifts
       between two close opacities over six seconds. The eye catches the motion
       in peripheral vision but it never reads as flashing, which is what a
       fast or high contrast pulse would look like on a screen someone sits in
       front of for hours. */
    /* The reservation tile is the same tile as the rest of the bar - same height, radius
       and glass (shared rule above) - only in a warm tone. The amber is not "warning" but
       "this machine is booked soon": the one thing in the bar that is about the machine
       rather than the session. */
    .giz-resv {
        display: flex;
        align-items: center;
        gap: 1rem;
        height: 5.8rem;
        padding: 0 1.8rem;
        white-space: nowrap;
        font-size: 1.3rem;
        color: var(--gg-ink);
        background:
            linear-gradient(180deg, rgba(251, 191, 36, 0.12), rgba(251, 191, 36, 0.05)),
            linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.02)) !important;
        border-color: rgba(251, 191, 36, 0.26) !important;
        animation: giz-resv-in 0.55s cubic-bezier(0.19, 1, 0.22, 1) both;
    }
    /* An icon rather than the previous dot, which named nothing. The same calendar as the
       reservation tile on sign-in and on the lock screen. The breathing moved onto the
       icon: the whole tile pulsing read as a fault in a row of still ones. */
    .giz-resv__icon {
        flex: none;
        font-size: 1.9rem;
        color: #fbbf24;
        animation: giz-resv-breathe 6s ease-in-out 0.6s infinite;
    }
    .giz-resv__lead { font-weight: 700; }
    .giz-resv__at {
        font-family: 'Space Grotesk', 'Manrope', sans-serif;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
        color: #fbbf24;
    }
    .giz-resv__count { color: rgba(var(--gg-ink-rgb), 0.5); }

    /* Time is up - same tile, more weight: a brighter outline and the icon stops
       breathing. Nothing new appears on screen. */
    .giz-resv--soon {
        border-color: rgba(251, 191, 36, 0.55) !important;
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.16),
            0 0 0 1px rgba(251, 191, 36, 0.16),
            0 2.4rem 6rem -3.4rem rgba(0, 0, 0, 0.7) !important;
    }
    .giz-resv--soon .giz-resv__icon { animation: none; }
    .giz-resv--soon .giz-resv__count { color: rgba(251, 191, 36, 0.75); }

    /* Entrance matches the deployment banner: the tile unrolls left to right rather than
       fading in place. The banner does it by growing from zero width; here the width comes
       from the grid track, so the same gesture is a clip-path on the same curve and
       duration. */
    @@keyframes giz-resv-in {
        from { opacity: 0; clip-path: inset(0 100% 0 0 round 1.6rem); }
        45%  { opacity: 1; }
        to   { opacity: 1; clip-path: inset(0 0 0 0 round 1.6rem); }
    }
    @@keyframes giz-resv-breathe {
        0%, 100% { opacity: 0.72; }
        50%      { opacity: 1; }
    }
    @@media (prefers-reduced-motion: reduce) {
        .giz-resv,
        .giz-resv__dot { animation: none; }
    }

    /* Search: always a wide pill with the icon and a placeholder visible, never
       collapsing to an icon. Background, border and shadow come from the shared
       .giz-top-bar__search .giz-global-search rule above. */
    .giz-top-bar .giz-header__global-search {
        width: auto;
        flex-shrink: 0;
    }
    .giz-top-bar .giz-global-search {
        display: grid !important;
        grid-template-columns: min-content 1fr min-content !important;
        width: 36rem !important;
        height: 5.8rem !important;
        border-radius: 1.6rem !important;
        overflow: visible !important;
        transition: border-color 0.2s, box-shadow 0.2s !important;
    }
    .giz-top-bar .giz-global-search:focus-within {
        border-color: rgba(var(--gg-accent-rgb),0.4) !important;
        box-shadow:
            inset 0 1px 0 rgba(255,255,255,0.16),
            0 0 0 1px rgba(var(--gg-accent-rgb),0.12),
            0 2.4rem 6rem -3.4rem rgba(0,0,0,0.7) !important;
    }
    /* The input and close-button are always rendered now (no collapsed
       state to hide them for) - the close-button itself still only shows
       once there's text to clear, which is the base component's own job. */
    .giz-top-bar .giz-global-search input {
        display: block !important;
        font-size: 1.35rem !important;
        color: rgba(255,255,255,0.9) !important;
        line-height: normal !important;
    }
    .giz-top-bar .giz-global-search input::placeholder {
        color: rgba(255,255,255,0.32) !important;
    }
    .giz-top-bar .giz-global-search > .giz-ph-icon {
        font-size: 1.9rem;
        color: rgba(255,255,255,0.38) !important;
        margin-left: 1.4rem;
        margin-right: 1rem;
    }
    .giz-top-bar .giz-global-search.open .giz-close-button,
    .giz-top-bar .giz-global-search.nonemtpy .giz-close-button,
    .giz-top-bar .giz-global-search:hover .giz-close-button,
    .giz-top-bar .giz-global-search:focus-within .giz-close-button {
        display: block !important;
    }
    .giz-top-bar .giz-global-search .giz-global-search-dropdown {
        background: linear-gradient(180deg, rgba(var(--gg-glass-rgb), 0.97), rgba(var(--gg-glass-2-rgb), 0.985)) !important;
        backdrop-filter: blur(5rem) saturate(1.7) !important;
        -webkit-backdrop-filter: blur(5rem) saturate(1.7) !important;
        border: 1px solid rgba(255,255,255,0.14) !important;
        border-radius: 2rem !important;
        box-shadow:
            inset 0 1px 0 rgba(255,255,255,0.2),
            0 4rem 9rem -2.6rem rgba(0,0,0,0.85) !important;
        width: 54rem !important;
        left: 0 !important;
        transform: none !important;
        z-index: 9001 !important;
        margin-top: 0.8rem !important;
        overflow: hidden !important;
    }
    /* Section rubrics in the results list read as the same small tracked
       uppercase label used for every other section title in the shell. */
    .giz-top-bar .giz-global-search-section__header {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1.6rem;
        padding: 1.6rem 1.8rem 0.8rem;
        font-family: Rubik, sans-serif;
        font-size: 1.1rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.32);
    }
    .giz-top-bar .giz-global-search-section__header__more {
        letter-spacing: 0.02em;
        text-transform: none;
        font-size: 1.25rem;
        color: var(--gg-accent);
        cursor: pointer;
        white-space: nowrap;
    }
    /* One result per row: the vendor's two columns assume its own 80.9rem panel, and
       in the 54rem one above the picture and the button ate the row - the name was
       left with about 40px and simply vanished. Three classes deep to outrank the
       bundle's own nesting. */
    .giz-top-bar .giz-global-search .giz-global-search-section__body {
        grid-template-columns: minmax(0, 1fr);
        row-gap: 0.4rem;
        padding: 0 0.8rem 0.8rem;
    }
    .giz-top-bar .giz-global-search-empty {
        padding: 3.6rem 2rem;
    }
    .giz-top-bar .giz-global-search-empty .giz-empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 0.4rem;
    }
    .giz-top-bar .giz-global-search-empty .giz-empty-state__title {
        font-size: 1.6rem !important;
        font-weight: 700;
        color: rgba(255,255,255,0.8) !important;
    }
    .giz-top-bar .giz-global-search-empty .giz-empty-state__text {
        font-size: 1.3rem !important;
        color: rgba(255,255,255,0.4) !important;
    }

    /* ── Top bar: ghost icon buttons ── */
    .giz-top-bar .giz-header__user-menu-item {
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
    }
    /* Icon buttons: bare glyphs, no persistent tile - a hover/open background is the
       only surface they ever get. */
    .giz-top-bar .user-menu-item-button--box {
        background: transparent !important;
        color: rgba(255,255,255,0.55) !important;
        border: none !important;
        border-radius: 1.2rem !important;
        width: 4rem !important;
        height: 4rem !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        cursor: pointer !important;
        box-shadow: none !important;
        transition: background 0.15s, color 0.15s, transform 0.12s !important;
        flex-shrink: 0 !important;
    }
    /* Hover brightens the glyph and nothing else: a tinted square behind the icon
       read as "a white rectangle appears" on the glass pill. The open state gets an
       accent tile of the button's own rounded-square shape - the same for every one of
       these buttons (the bell sits inside a Badge wrapper, so it is not a direct child
       of .open; the shared rule further down covers it, and this one must not give the
       others a different shape). */
    .giz-top-bar .user-menu-item-button--box:hover {
        color: rgba(255,255,255,0.95) !important;
    }
    .giz-top-bar .user-menu-item-button--box:active { transform: scale(0.94) !important; }
    .giz-top-bar .open > .user-menu-item-button--box {
        background: rgba(var(--gg-accent-rgb),0.15) !important;
        color: var(--gg-accent) !important;
    }
    .giz-top-bar .user-menu-item-button--box .giz-ph-icon {
        font-size: 2.1rem;
        color: inherit;
    }
    /* Top-up: the one action worth calling out - accent-tinted fill + border
       instead of the bare-glyph ghost treatment every other icon button
       gets. */
    /* Top-up: lives inside the HUD capsule now, right after balance - same
       same 4rem height as its ghost-icon siblings, but auto-width to fit a
       label and accent-tinted so it still reads as the one action worth
       calling out. */
    .giz-top-bar .giz-topup-pill {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        height: 4rem;
        padding: 0 1.4rem 0 1.1rem;
        border-radius: 1.2rem;
        background: rgba(var(--gg-accent-rgb),0.16);
        border: 1px solid rgba(var(--gg-accent-rgb),0.35);
        color: var(--gg-accent);
        font-size: 1.3rem;
        font-weight: 600;
        white-space: nowrap;
        cursor: pointer;
        transition: background 0.15s, border-color 0.15s, color 0.15s;
    }
    /* On a narrow bar the top-up pill keeps its icon and gives up its word, like the
       ghost icons next to it: the room goes to the session tile and to whatever the bar
       has to say (a deployment, a reservation). */
    @@media (max-width: 1440px) {
        .giz-top-bar .giz-topup-pill { padding: 0 1.1rem; }
        .giz-top-bar .giz-topup-pill > span { display: none; }
    }
    .giz-top-bar .giz-topup-pill:hover {
        background: rgba(var(--gg-accent-rgb),0.28);
        border-color: rgba(var(--gg-accent-rgb),0.55);
        color: #fff;
    }
    .giz-top-bar .giz-topup-pill .giz-ph-icon {
        font-size: 1.8rem;
        color: inherit;
    }

    /* ── Tooltips on top-bar icon buttons ── */
    .giz-top-bar .giz-header__user-menu-item[data-tooltip] { position: relative; }
    .giz-top-bar .giz-header__user-menu-item[data-tooltip]::after {
        content: attr(data-tooltip);
        position: absolute;
        top: calc(100% + 0.5rem);
        left: 50%;
        transform: translateX(-50%);
        background: rgba(8,11,18,0.97);
        color: #d0d8e4;
        font-size: 1.15rem;
        font-weight: 600;
        font-family: Rubik, sans-serif;
        white-space: nowrap;
        padding: 0.45rem 1rem;
        border-radius: 0.7rem;
        border: 1px solid rgba(255,255,255,0.1);
        box-shadow: 0 0.6rem 1.6rem rgba(0,0,0,0.6);
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.15s;
        z-index: 9500;
    }
    .giz-top-bar .giz-header__user-menu-item[data-tooltip]::before {
        content: '';
        position: absolute;
        top: 100%;
        left: 50%;
        transform: translateX(-50%);
        border: 0.45rem solid transparent;
        border-bottom-color: rgba(8,11,18,0.97);
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.15s;
        z-index: 9500;
    }
    .giz-top-bar .giz-header__user-menu-item[data-tooltip]:hover::after,
    .giz-top-bar .giz-header__user-menu-item[data-tooltip]:hover::before { opacity: 1; }
    /* Hide the tooltip while the dropdown is open */
    .giz-top-bar .giz-header__user-menu-item.open[data-tooltip]::after,
    .giz-top-bar .giz-header__user-menu-item.open[data-tooltip]::before { opacity: 0 !important; }
    /* Top-up already has a visible label - the tooltip would just repeat it */
    .giz-top-bar .giz-user-online-deposit-dropdown[data-tooltip]::after,
    .giz-top-bar .giz-user-online-deposit-dropdown[data-tooltip]::before { content: none !important; }

    /* Account chip: reduced to just a round avatar button - no name, no
       chevron. Own glass surface (background/border/blur/shadow from the
       shared glass-recipe selector list above) but round instead of the
       16px squircle the other pills use, sized snugly around the avatar. */
    .giz-top-bar .giz-user-menu-button {
        width: 5.6rem !important;
        height: 5.6rem !important;
        border-radius: 50% !important;
        box-sizing: border-box !important;
        padding: 0 !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        transition: filter 0.15s !important;
        flex-shrink: 0 !important;
    }
    .giz-top-bar .giz-user-menu-button:hover {
        filter: brightness(1.25);
    }
    .giz-top-bar .giz-user-dropdown.open .giz-user-menu-button {
        border-color: rgba(var(--gg-accent-rgb),0.4) !important;
    }
    /* The avatar fills the whole button rather than sitting inset inside it
       with a ring of glass around the edge. The Avatar component renders a
       fixed-size box by default (giz-avatar--medium = 4rem) and its img
       has no object-fit, so left alone the picture neither filled the
       circle nor kept its aspect ratio. Without a picture the button stays
       plain glass with a thin person glyph: no accent disc, nothing that
       reads as a badge or a call to action. */
    .giz-top-bar .giz-user-menu-button { overflow: hidden !important; }
    .giz-top-bar .giz-user-menu-button .giz-user-avatar {
        width: 100% !important;
        height: 100% !important;
        min-width: 0 !important;
        border-radius: 50% !important;
        background: transparent !important;
        color: rgba(var(--gg-ink-rgb), 0.78) !important;
        font-size: 2.3rem;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        flex-shrink: 0 !important;
        overflow: hidden !important;
    }
    .giz-top-bar .giz-user-menu-button:hover .giz-user-avatar {
        color: var(--gg-ink) !important;
    }
    .giz-top-bar .giz-user-menu-button .giz-user-avatar img {
        width: 100% !important;
        height: 100% !important;
        object-fit: cover !important;
        display: block !important;
    }
    /* ── Every stat in the bar: a small bare icon (no badge circle, no glow)
       plus text, all at the same modest size - minimal on purpose. Balance
       is green text with no icon at all, matching money's own convention. ── */
    .giz-topbar-tariff {
        display: flex;
        align-items: center;
    }
    .giz-topbar-tariff .giz-header-user-balance {
        background-color: transparent !important;
        border: none !important;
        border-radius: 0 !important;
        color: var(--gg-accent) !important;
        padding: 0 !important;
        height: auto !important;
        font-size: 1.5rem !important;
        font-weight: 600 !important;
        gap: 0.5rem !important;
    }
    .giz-topbar-tariff .giz-header-user-balance > .giz-ph-icon {
        color: var(--gg-accent) !important;
        font-size: 1.7rem;
    }
    /* The tariff tooltip itself is styled in _time-tooltip.scss; the wrapper only has
       to sit above the rest of the bar. */
    .giz-topbar-tariff .giz-user-balance-tooltip-wrapper {
        z-index: 9001 !important;
    }
    .giz-topbar-stat {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 1.5rem;
        font-weight: 600;
        color: rgba(255,255,255,0.85);
    }
    .giz-topbar-stat .giz-ph-icon {
        font-size: 1.7rem;
        color: rgba(255,255,255,0.4);
        flex-shrink: 0;
    }
    .giz-topbar-stat--pc {
        font-family: 'Space Grotesk', 'Manrope', sans-serif;
        font-weight: 700;
        letter-spacing: 0.02em;
    }
    /* Balance is the one segment allowed to stand out - bigger than the
       rest of the HUD, bold green. */
    .giz-topbar-stat--balance {
        font-family: 'Space Grotesk', 'Manrope', sans-serif;
        color: #3ddc72 !important;
        font-weight: 700 !important;
    }

    /* ══════════════════════════════════════════════
       DROPDOWN PANEL — frosted, effectively opaque
       ══════════════════════════════════════════════ */
    /* Every panel that opens from the bar (this list, the search dropdown, the
       profile popup, the tariff tooltip) is filled at 0.97-0.985 of the glass colour.
       They sit over the page, and the page must not show through them: a backdrop
       blur is not something a popup inside a blurred pill can count on, so the fill
       does the hiding and the blur only softens what little is left. */
    .giz-top-bar .giz-active-apps,
    .giz-top-bar .giz-menu-notifications,
    .giz-top-bar .giz-menu-assistance,
    .giz-top-bar .giz-user-online-deposit-menu {
        background: linear-gradient(180deg, rgba(var(--gg-glass-rgb), 0.97), rgba(var(--gg-glass-2-rgb), 0.985)) !important;
        backdrop-filter: blur(5rem) saturate(1.7) !important;
        -webkit-backdrop-filter: blur(5rem) saturate(1.7) !important;
        border: 1px solid rgba(255,255,255,0.14) !important;
        border-radius: 2.2rem !important;
        box-shadow:
            inset 0 1px 0 rgba(255,255,255,0.2),
            0 4rem 9rem -2.6rem rgba(0,0,0,0.85) !important;
        color: rgba(255,255,255,0.9) !important;
    }

    /* .giz-active-apps hosts position:fixed Popup components — backdrop-filter would make it
       a containing block for fixed descendants, trapping and clipping popups inside it.
       Same trick used for .giz-top-bar__icons: blur lives on ::before, not the element. */
    .giz-top-bar .giz-active-apps {
        position: relative;
        background: none !important;
        backdrop-filter: none !important;
        -webkit-backdrop-filter: none !important;
    }
    .giz-top-bar .giz-active-apps::before {
        content: '';
        position: absolute;
        inset: 0;
        z-index: -1;
        border-radius: inherit;
        background: linear-gradient(180deg, rgba(var(--gg-glass-rgb), 0.97), rgba(var(--gg-glass-2-rgb), 0.985));
        backdrop-filter: blur(5rem) saturate(1.7);
        -webkit-backdrop-filter: blur(5rem) saturate(1.7);
    }

    /* ── Shared panel chrome: header block with a title and a quiet hint
       line under it, generous padding, hairline rules. ── */
    .giz-top-bar .giz-active-apps__header,
    .giz-top-bar .giz-menu-notifications__header {
        padding: 1.8rem 2rem 1.4rem !important;
        border-bottom: 1px solid rgba(255,255,255,0.07) !important;
    }
    .giz-top-bar .giz-active-apps__header .giz-heading,
    .giz-top-bar .giz-menu-notifications__header .giz-heading {
        font-family: Rubik, sans-serif;
        font-size: 1.8rem !important;
        font-weight: 700 !important;
        color: #fff !important;
        letter-spacing: 0.01em;
    }
    .giz-top-bar .giz-active-apps__header__hint,
    .giz-top-bar .giz-menu-notifications__header__hint {
        margin-top: 0.3rem;
        font-size: 1.25rem;
        font-weight: 500;
        color: rgba(255,255,255,0.38);
    }

    /* ── Apps manager ── */
    .giz-top-bar .giz-active-apps {
        min-width: 46rem !important;
        border-radius: 2rem !important;
    }
    .giz-top-bar .giz-active-apps__body {
        padding: 0.8rem !important;
    }
    /* Rows are their own soft tiles now, not table stripes divided by
       hairlines - the panel reads as a list of things rather than a grid. */
    .giz-top-bar .giz-active-app-card {
        display: grid;
        grid-template-columns: min-content 1fr min-content;
        align-items: center;
        gap: 1.4rem;
        padding: 1rem 1.2rem !important;
        border: 1px solid transparent;
        border-bottom: none !important;
        border-radius: 1.4rem;
        transition: background 0.15s, border-color 0.15s;
    }
    .giz-top-bar .giz-active-app-card:hover {
        background: rgba(255,255,255,0.05);
        border-color: rgba(255,255,255,0.08);
    }
    /* The icon alone, no plate under it: most executables ship a square icon on
       a transparent ground, and a tile behind it read as a second, dimmer icon. */
    .giz-top-bar .giz-active-app-card__image {
        padding: 0 !important;
        width: 4.4rem;
        height: 4.4rem;
        border-radius: 1.1rem;
        overflow: hidden;
        background: none;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .giz-top-bar .giz-active-app-card__image img {
        width: 100% !important;
        height: 100% !important;
        object-fit: cover;
    }
    .giz-top-bar .giz-active-app-card__info {
        padding: 0 !important;
        min-width: 0;
    }
    .giz-top-bar .giz-active-app-card__info__title {
        font-size: 1.5rem !important;
        font-weight: 600;
        color: var(--gg-ink) !important;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .giz-top-bar .giz-active-app-card__actions {
        padding: 0 !important;
    }
    /* ── Empty states, shared shape ── */
    /* white-space: normal is not decoration: the dropdown inherits nowrap from the
       vendor's menu, and the hint line, wider than its 26rem box, overflowed to the right
       of it - a centred box with text hanging out of one side, which read as the line
       being shifted. Wrapped, it centres. */
    .giz-top-bar .giz-active-apps__empty,
    .giz-top-bar .giz-menu-notifications .giz-empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        white-space: normal;
        gap: 0.4rem;
        padding: 4rem 2rem;
    }
    .giz-top-bar .giz-active-apps__empty > .giz-ph-icon,
    .giz-top-bar .giz-menu-notifications .giz-empty-state > .giz-ph-icon {
        font-size: 3.6rem;
        color: rgba(255,255,255,0.16);
        margin-bottom: 0.6rem;
    }
    .giz-top-bar .giz-active-apps__empty__title,
    .giz-top-bar .giz-menu-notifications .giz-empty-state__title {
        font-size: 1.6rem !important;
        font-weight: 700;
        color: rgba(255,255,255,0.8) !important;
    }
    .giz-top-bar .giz-active-apps__empty__text,
    .giz-top-bar .giz-menu-notifications .giz-empty-state__text {
        font-size: 1.3rem !important;
        line-height: 1.45;
        color: rgba(255,255,255,0.4) !important;
        max-width: 30rem;
    }

    /* ── Notifications flyout ── */
    .giz-top-bar .giz-menu-notifications {
        min-width: 42rem !important;
        border-radius: 2rem !important;
    }
    .giz-top-bar .giz-menu-notifications__body {
        padding: 0.8rem !important;
    }
    .giz-top-bar .giz-menu-notifications__footer {
        border-top: 1px solid rgba(255,255,255,0.07) !important;
        padding: 1rem !important;
    }
    .giz-top-bar .giz-menu-notifications__footer__action {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 4.2rem;
        border-radius: 1.2rem;
        cursor: pointer;
        font-size: 1.35rem !important;
        font-weight: 600;
        color: rgba(255,255,255,0.6) !important;
        transition: background 0.15s, color 0.15s;
    }
    .giz-top-bar .giz-menu-notifications__footer__action:hover {
        background: rgba(255,255,255,0.07);
        color: #fff !important;
    }

    /* Online top-up flyout.
       The shared inner content (amount picker / QR step) is styled once, unscoped, in
       _user-online-deposit.scss - it is the same markup whether hosted here in the
       dropdown or in the top-up dialog. Only the dropdown's own panel chrome is here. */
    .giz-top-bar .giz-user-online-deposit-menu {
        min-width: 40rem !important;
        border-radius: 2rem !important;
    }
    .giz-top-bar .giz-user-online-deposit__body {
        padding: 2rem !important;
    }
    .giz-top-bar .giz-user-online-deposit__footer {
        padding: 0 2rem 2rem !important;
        border-top: none !important;
    }

    /* ── Tariff ──
       The hover state used to paint a box-shadow glow on an element the
       layout had already forced to border-radius:0 - a hard rectangular
       halo around the tariff name. There is no background or border left
       to highlight, so the hover treatment is just the text brightening. */
    .giz-topbar-tariff .giz-header-user-balance {
        cursor: default;
    }
    .giz-topbar-tariff .giz-header-user-balance:hover {
        background: transparent !important;
        box-shadow: none !important;
        filter: brightness(1.18);
    }

    /* ══════════════════════════════════════════════
       PROFILE POPUP — custom glass card (not a list-style
       dropdown): scattered icons around the avatar, name, then a
       change-password row and a lock+logout row.
       ══════════════════════════════════════════════ */
    .giz-top-bar .giz-profile-popup {
        margin-top: 1rem;
        height: auto !important;
    }
    .giz-top-bar .giz-profile-popup__content {
        position: relative;
        width: 32.8rem;
        box-sizing: border-box;
        padding: 2.2rem 2.2rem 2rem;
        border-radius: 2.8rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        background: linear-gradient(180deg, rgba(var(--gg-glass-rgb), 0.97), rgba(var(--gg-glass-2-rgb), 0.985));
        backdrop-filter: blur(5rem) saturate(1.7);
        -webkit-backdrop-filter: blur(5rem) saturate(1.7);
        border: 1px solid rgba(255,255,255,0.14);
        box-shadow:
            inset 0 1px 0 rgba(255,255,255,0.2),
            0 4rem 9rem -2.6rem rgba(0,0,0,0.85);
        color: rgba(255,255,255,0.9);
    }

    /* Avatar zone: fixed footprint for the scattered icons, avatar centred
       inside it. Trimmed from 23/22rem - shorter card overall, per brief. */
    .giz-profile-popup__avatar-zone {
        position: relative;
        width: 20rem;
        height: 19rem;
        flex-shrink: 0;
    }
    .giz-profile-popup__orbit {
        position: absolute;
        inset: 0;
    }
    /* Every ring icon is anchored at the zone's exact centre, then pushed
       out to its ring radius and around to its angle by the inline
       transform (rotate → translate → rotate back, the standard technique
       for evenly spacing points on a circle without hand-placing each
       one). Sizing/opacity per ring comes from the inline style Razor
       renders per icon (14px/.75 → 11px/.5 → 9px/.3, closest ring
       brightest, matching the brief: fades out with distance). */
    .giz-orbit-icon {
        position: absolute;
        top: 50%;
        left: 50%;
        line-height: 1;
        margin: -0.7em;
        width: 1.4em;
        height: 1.4em;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--gg-ink-3);
        pointer-events: none;
    }
    /* A plain disc of glass with a thin glyph - not a control, so no accent
       ring, no halo, nothing to invite a click. */
    .giz-profile-popup__avatar {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 9.6rem;
        height: 9.6rem;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, rgba(var(--gg-glass-rgb), 0.9), rgba(var(--gg-glass-2-rgb), 0.9));
        border: 1px solid rgba(255,255,255,0.14);
        box-shadow: inset 0 1px 0 rgba(255,255,255,0.12);
        overflow: hidden;
        z-index: 2;
    }
    .giz-profile-popup__avatar i {
        font-size: 4.2rem;
        color: rgba(var(--gg-ink-rgb), 0.8);
    }
    /* Same story as the top-bar one: the Avatar component renders a fixed
       4rem box, so inside this 9.6rem circle the picture used to float
       small in the middle. Force that box to fill its parent. */
    .giz-profile-popup__avatar .giz-avatar {
        width: 100% !important;
        height: 100% !important;
        display: block !important;
    }
    .giz-profile-popup__avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }
    /* The picture as a control, only where the club runs its own picture service
       (--gg-avatars). At rest it is exactly the avatar; the veil and the camera come
       in under the cursor, so nothing invites a click when nothing can be changed. */
    .giz-profile-popup__avatar-edit,
    .giz-user-avatar-edit {
        position: relative;
        display: block;
        padding: 0;
        border: none;
        background: transparent;
        border-radius: 50%;
        overflow: hidden;
        cursor: pointer;
        width: 100%;
        height: 100%;
        line-height: 0;
    }
    .giz-profile-popup__avatar-edit > i,
    .giz-user-avatar-edit > .giz-user-avatar--glyph {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
        font-size: 4.2rem;
        color: rgba(var(--gg-ink-rgb), 0.8);
    }
    .giz-profile-popup__avatar-veil,
    .giz-user-avatar-edit__veil {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: rgba(0,0,0,0.55);
        color: #fff;
        opacity: 0;
        transition: opacity 0.15s;
    }
    .giz-profile-popup__avatar-veil i,
    .giz-user-avatar-edit__veil i {
        font-size: 2.2rem;
    }
    .giz-profile-popup__avatar-edit:hover .giz-profile-popup__avatar-veil,
    .giz-profile-popup__avatar-edit:focus-visible .giz-profile-popup__avatar-veil,
    .giz-user-avatar-edit:hover .giz-user-avatar-edit__veil,
    .giz-user-avatar-edit:focus-visible .giz-user-avatar-edit__veil {
        opacity: 1;
    }

    .giz-profile-popup__name {
        margin-top: 0.2rem;
        font-weight: 800;
        font-size: 2rem;
        color: var(--gg-ink);
        text-align: center;
    }

    /* The standing, worn rather than listed. The ring sits just inside the avatar's
       rim (the picture steps back to make room), the level disc at the rim's lower
       right - the same two signs the top bar's small avatar carries - and one line
       under the name says where the customer stands. */
    .giz-profile-popup__avatar--ringed .giz-avatar,
    .giz-profile-popup__avatar--ringed > i {
        width: 7.8rem !important;
        height: 7.8rem !important;
        border-radius: 50%;
        overflow: hidden;
    }
    .giz-profile-popup__avatar--ringed > i {
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3.6rem;
    }
    .giz-profile-popup__ring {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        transform: rotate(-90deg);
        pointer-events: none;
    }
    .giz-profile-popup__ring circle {
        fill: none;
        stroke-width: 1.5;
    }
    .giz-profile-popup__ring .gg-ring__track { stroke: rgba(255,255,255,0.09); }
    .giz-profile-popup__ring .gg-ring__bar {
        stroke: var(--gg-accent);
        stroke-linecap: round;
        stroke-dasharray: 113.1;    /* 2 * pi * 18 - LoyaltyRing.Offset reckons with it */
        transition: stroke-dashoffset 0.6s ease;
    }
    .giz-profile-popup__level {
        position: absolute;
        left: calc(50% + 1.9rem);
        top: calc(50% + 1.9rem);
        width: 3rem;
        height: 3rem;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background: var(--gg-accent);
        color: var(--gg-on-accent);
        font-weight: 800;
        font-size: 1.35rem;
        line-height: 1;
        /* Cut out of the avatar's rim by a ring of the card's own glass. */
        box-shadow: 0 0 0 0.3rem rgba(var(--gg-glass-2-rgb), 0.98);
        z-index: 3;
    }
    .giz-profile-popup__level img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .giz-profile-popup__level--plain {
        background: rgba(var(--gg-accent-rgb), 0.22);
        color: var(--gg-accent-soft);
        font-size: 1.4rem;
    }
    .giz-profile-popup__standing {
        max-width: 100%;
        margin-top: 0.5rem;
        padding: 0.2rem 0.6rem;
        border: none;
        border-radius: 0.8rem;
        background: transparent;
        color: var(--gg-ink-2);
        font-size: 1.3rem;
        line-height: 1.35;
        text-align: center;
        white-space: normal;    /* the header item above says nowrap */
        cursor: pointer;
        transition: color 0.15s, background 0.15s;
    }
    .giz-profile-popup__standing:hover {
        color: var(--gg-ink);
        background: rgba(255,255,255,0.05);
    }
    .giz-profile-popup__standing b {
        color: var(--gg-ink);
        font-weight: 700;
    }
    /* A middle dot between the level and the line. */
    .giz-profile-popup__standing b::after {
        content: "\00a0\00b7\00a0";
        color: var(--gg-ink-3);
        font-weight: 400;
    }
    .giz-profile-popup__standing em {
        font-style: normal;
        color: var(--gg-accent);
    }

    /* Actions block: change-password + lock sharing a row, logout full
       width on its own below. */
    .giz-profile-popup__actions {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
        margin-top: 1.8rem;
    }
    .giz-profile-popup__actions-row {
        display: flex;
        gap: 0.8rem;
    }
    /* The way into the account page: the first and widest of the actions. */
    .giz-profile-popup__account-btn {
        width: 100%;
        height: 5.2rem;
        display: flex;
        align-items: center;
        gap: 0.9rem;
        padding: 0 1.6rem;
        border-radius: 1.6rem;
        background: rgba(var(--gg-accent-rgb), 0.14);
        border: 1px solid rgba(var(--gg-accent-rgb), 0.3);
        color: var(--gg-ink);
        font-size: 1.4rem;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.15s, border-color 0.15s;
    }
    .giz-profile-popup__account-btn:hover {
        background: rgba(var(--gg-accent-rgb), 0.24);
        border-color: rgba(var(--gg-accent-rgb), 0.5);
    }
    .giz-profile-popup__account-btn i {
        font-size: 1.7rem;
        color: var(--gg-accent-soft);
    }
    .giz-profile-popup__account-btn .giz-profile-popup__account-arrow {
        margin-left: auto;
        font-size: 1.4rem;
        color: var(--gg-ink-3);
    }
    .giz-profile-popup__change-password-btn {
        flex: 1 1 auto;
        min-width: 0;
        height: 5.2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.8rem;
        border-radius: 1.6rem;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        color: var(--gg-ink-2);
        font-size: 1.4rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.15s, color 0.15s;
    }
    .giz-profile-popup__change-password-btn:hover {
        background: rgba(var(--gg-accent-rgb), 0.16);
        color: var(--gg-ink);
    }
    .giz-profile-popup__change-password-btn i {
        font-size: 1.7rem;
        color: var(--gg-ink-3);
    }
    .giz-profile-popup__lock-btn {
        flex: 0 0 auto;
        width: 5.2rem;
        height: 5.2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 1.6rem;
        border: 1px solid rgba(255,255,255,0.1);
        background: rgba(255,255,255,0.05);
        color: var(--gg-ink-2);
        cursor: pointer;
        transition: background 0.15s, color 0.15s;
    }
    .giz-profile-popup__lock-btn:hover {
        background: rgba(var(--gg-accent-rgb), 0.3);
        color: var(--gg-ink);
    }
    .giz-profile-popup__lock-btn i {
        font-size: 1.8rem;
    }
    .giz-profile-popup__logout-btn {
        width: 100%;
        height: 5.2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.8rem;
        border-radius: 1.6rem;
        /* Neutral, not tinted: signing out is not the accent's business, and the
           warmer companion hue this used to borrow read as a foreign colour. */
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.12);
        color: var(--gg-ink);
        font-size: 1.4rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.15s;
    }
    .giz-profile-popup__logout-btn:hover {
        background: rgba(255,255,255,0.1);
    }
    .giz-profile-popup__logout-btn i {
        font-size: 1.8rem;
        color: var(--gg-ink-3);
    }

    /* Open-state teal for all icon buttons */
    .giz-top-bar .giz-active-apps-dropdown.open .user-menu-item-button--box,
    .giz-top-bar .giz-notifications-dropdown.open .user-menu-item-button--box,
    .giz-top-bar .giz-assistance-dropdown.open .user-menu-item-button--box,
    .giz-top-bar .giz-user-online-deposit-dropdown.open .user-menu-item-button--box {
        background: rgba(var(--gg-accent-rgb),0.15) !important;
        color: var(--gg-accent) !important;
    }

    /* ══════════════════════════════════════════════
       DIALOG / MODAL REDESIGN — dark glass
       ══════════════════════════════════════════════ */

    /* Overlay — soft dark blur instead of heavy gradient */
    [client-theme] .giz-dialog {
        background: rgba(0,0,0,0.55) !important;
        backdrop-filter: blur(0.6rem) !important;
        -webkit-backdrop-filter: blur(0.6rem) !important;
    }

    /* Card wrapper — was orange, now transparent pass-through */
    [client-theme] .giz-dialog > .giz-card {
        background: transparent !important;
        background-color: transparent !important;
        border: none !important;
        border-radius: 1.6rem !important;
        box-shadow: none !important;
        overflow: visible !important;
    }
    [client-theme] .giz-dialog > .giz-card::before {
        display: none !important;
    }

    /* Client dialog panel — same glass as every flyout (top-up, change
       photo, confirmations all go through this). Was a near-opaque dark
       slab, which next to the glass panels looked like a different app. */
    /* backdrop-filter deliberately NOT on .giz-client-dialog itself: several
       dialogs (checkout's payment-method Select, others using
       OpenDirection="Cursor") render a position:fixed popup positioned from
       JS-computed viewport coordinates. backdrop-filter on an ancestor makes
       IT the containing block for fixed descendants, so the popup was being
       placed relative to the dialog's own box instead of the viewport -
       reported live as the payment-method list opening in the bottom-right
       corner of the screen instead of under the dropdown. Same fix as
       .giz-login-card / .giz-active-apps / .giz-top-bar__icons earlier: the
       blur lives on a ::before layer, the dialog itself stays out of the
       containing-block chain. */
    [client-theme] .giz-client-dialog {
        position: relative;
        background: none !important;
        border: 1px solid rgba(255,255,255,0.14) !important;
        border-radius: 2.4rem !important;
        box-shadow:
            inset 0 1px 0 rgba(255,255,255,0.2),
            0 4rem 9rem -2.6rem rgba(0,0,0,0.9) !important;
        color: rgba(255,255,255,0.9) !important;
    }
    [client-theme] .giz-client-dialog::before {
        content: '';
        position: absolute;
        inset: 0;
        z-index: -1;
        border-radius: inherit;
        background: linear-gradient(180deg, rgba(var(--gg-glass-rgb), 0.97), rgba(var(--gg-glass-2-rgb), 0.985));
        backdrop-filter: blur(5rem) saturate(1.7);
        -webkit-backdrop-filter: blur(5rem) saturate(1.7);
    }

    /* Dialog header text */
    [client-theme] .giz-client-dialog__header__title {
        color: rgba(255,255,255,0.95) !important;
    }
    [client-theme] .giz-client-dialog__header__subtitle {
        color: rgba(255,255,255,0.5) !important;
    }

    /* Separator line between header and body */
    [client-theme] .giz-client-dialog__header {
        border-bottom: 1px solid rgba(255,255,255,0.07) !important;
        padding-bottom: 1.6rem !important;
        margin-bottom: 1.6rem !important;
    }

    /* Footer separator */
    [client-theme] .giz-client-dialog__footer {
        border-top: 1px solid rgba(255,255,255,0.07) !important;
        padding-top: 1.6rem !important;
        margin-top: 1.6rem !important;
    }
</style>

@if (!string.IsNullOrEmpty(ClientInterfaceOptions.CurrentValue.StyleSheet))
{
    <HeadContent>
        <link href="style.css" rel="stylesheet" />
    </HeadContent>
}

<main @onclick="OnMainClick" client-theme="true">
    <div class="giz-background @(HasClubWallpaper ? "giz-background--club" : null)">
        @if (!HasClubWallpaper)
        {
            @* The moving gradient over the atmosphere - see _flow.scss. A club picture is
               shown as it is. *@
            <div class="gg-flow" aria-hidden="true">
                <span class="gg-flow__sheet gg-flow__sheet--1"></span>
                <span class="gg-flow__sheet gg-flow__sheet--2"></span>
            </div>
        }
        <img src="@WallpaperViewState.Wallpaper" alt='loading' />
    </div>
    <div class="giz-root">
        <div class="giz-top-bar">
            @* Search and the reservation tile form one left group. The centre tile is
               absolutely positioned in the middle of the bar and so takes no room in the
               normal flow: following the search, the tile used to slide under it. The
               group is width-limited to end before the centre tile - see
               .giz-top-bar__left. *@
            <div class="giz-top-bar__left">
                <div class="giz-top-bar__search">
                    <HeaderGlobalSearch />
                </div>
                <TopBarReservation />
            </div>
            <div class="giz-top-bar__hud">
                <div class="giz-topbar-stat giz-topbar-stat--pc">
                    <HostNumber />
                </div>
                <span class="giz-top-bar__divider"></span>
                <div class="giz-topbar-tariff">
                    <HeaderUserBalanceCurrentTimeProduct />
                </div>
                <span class="giz-top-bar__divider"></span>
                <div class="giz-top-bar__time">
                    @if (UserBalanceViewState.Time.HasValue)
                    {
                        var t = UserBalanceViewState.Time.Value;
                        <i class="ph-bold ph-clock giz-ph-icon"></i>
                        <span class="giz-top-bar__time-value">@((int)t.TotalHours)@TimeUnitAbbreviation(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_PRODUCT_TIME_EXPIRATION_HOUR_ABBREVIATED)) @(t.Minutes.ToString("00"))@TimeUnitAbbreviation(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_PRODUCT_TIME_EXPIRATION_MINUTE_ABBREVIATED))</span>
                    }
                    else
                    {
                        <i class="ph-bold ph-clock giz-ph-icon"></i>
                        <i class="ph-bold ph-infinity giz-ph-icon" style="color:#FFC700"></i>
                    }
                </div>
                <span class="giz-top-bar__divider"></span>
                <div class="giz-topbar-stat giz-topbar-stat--points">
                    <i class="ph-fill ph-coins giz-ph-icon" style="color:#e8b84b"></i>
                    <span>@UserBalanceViewState.PointsBalance</span>
                </div>
                <span class="giz-top-bar__divider"></span>
                <div class="giz-topbar-stat giz-topbar-stat--balance">
                    <span>@UserBalanceViewState.Balance.ToString("C", CultureInfo.CurrentCulture)</span>
                </div>
            </div>
            <div class="giz-top-bar__right-group">
                <div class="giz-top-bar__icons">
                    <UserActionsBar />
                </div>
                <DeploymentBanner />
                <LoyaltyHint />
                <AvatarNudgeBanner />
                <div class="giz-top-bar__account">
                    <HeaderUserMenuUserLinks @onclick="UserMenuViewService.ToggleUserLinks" />
                </div>
            </div>
        </div>
        <div class="giz-container">
            <aside class="giz-left-panel">
                <Header />
                <div class="giz-left-panel__divider"></div>
                <div class="giz-left-panel__quicklaunch">
                    <QuickLauncher />
                </div>
            </aside>
            <div class="giz-app__body">
                @Body
            </div>
        </div>
    </div>

    <UserLock />
    <DialogHost />

    @if (System.Runtime.InteropServices.RuntimeInformation.IsOSPlatform(System.Runtime.InteropServices.OSPlatform.Create("browser")))
    {
        <div class="giz-web-notifications-host">
            <NotificationsHost />
        </div>
    }

    @if (HostOutOfOrderViewState.IsOutOfOrder)
    {
        <Layout_LoginOutOfOrder />
    }
    else
    {
        <Layout_LoginLock />
    }

    <GracePeriod />
    <UserBan />

    @* Renders nothing: reports whether anybody is looking at the shell. *@
    <ShellActivityWatcher />

</main>

@code {
    private bool _playTransition;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _playTransition = true;
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || _playTransition)
        {
            _playTransition = false;
            await JS.InvokeVoidAsync("eval", @"
                (function() {
                    var el = document.querySelector('.giz-app__body > *');
                    if (!el) return;
                    el.style.animation = 'none';
                    el.offsetWidth;
                    el.style.animation = '';
                })();
            ");
        }
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        this.UnsubscribeChange(UserBalanceViewState);
    }
}
