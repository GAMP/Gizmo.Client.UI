@inherits LayoutComponentBase
@using Microsoft.Extensions.Options
@using System.Globalization
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject Gizmo.UI.Services.ILocalizationService LocalizationService
@implements IDisposable

@if (!string.IsNullOrEmpty(ClientInterfaceOptions.CurrentValue.StyleSheet))
{
    <HeadContent>
        <link href="style.css" rel="stylesheet" />
    </HeadContent>
}

<main @onclick="OnMainClick" client-theme="true">
    <div class="giz-background @(HasClubWallpaper ? "giz-background--club" : null)">
        @if (!HasClubWallpaper)
        {
            @* The moving gradient over the atmosphere - see _flow.scss. A club picture is
               shown as it is. *@
            <div class="gg-flow" aria-hidden="true">
                <span class="gg-flow__sheet gg-flow__sheet--1"></span>
                <span class="gg-flow__sheet gg-flow__sheet--2"></span>
            </div>
        }
        <img src="@WallpaperViewState.Wallpaper" alt='loading' />
    </div>
    <div class="giz-root">
        <div class="giz-top-bar">
            @* Search and the reservation tile form one left group. The centre tile is
               absolutely positioned in the middle of the bar and so takes no room in the
               normal flow: following the search, the tile used to slide under it. The
               group is width-limited to end before the centre tile - see
               .giz-top-bar__left. *@
            <div class="giz-top-bar__left">
                <div class="giz-top-bar__search">
                    <HeaderGlobalSearch />
                </div>
                <TopBarReservation />
            </div>
            <div class="giz-top-bar__hud">
                <div class="giz-topbar-stat giz-topbar-stat--pc">
                    <HostNumber />
                </div>
                <span class="giz-top-bar__divider"></span>
                <div class="giz-topbar-tariff">
                    <HeaderUserBalanceCurrentTimeProduct />
                </div>
                <span class="giz-top-bar__divider"></span>
                <div class="giz-top-bar__time">
                    @if (UserBalanceViewState.Time.HasValue)
                    {
                        var t = UserBalanceViewState.Time.Value;
                        <i class="ph-bold ph-clock giz-ph-icon"></i>
                        <span class="giz-top-bar__time-value">@((int)t.TotalHours)@TimeUnitAbbreviation(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_PRODUCT_TIME_EXPIRATION_HOUR_ABBREVIATED)) @(t.Minutes.ToString("00"))@TimeUnitAbbreviation(nameof(Gizmo.Client.UI.Resources.Properties.Resources.GIZ_PRODUCT_TIME_EXPIRATION_MINUTE_ABBREVIATED))</span>
                    }
                    else
                    {
                        <i class="ph-bold ph-clock giz-ph-icon"></i>
                        <i class="ph-bold ph-infinity giz-ph-icon" style="color:#FFC700"></i>
                    }
                </div>
                <span class="giz-top-bar__divider"></span>
                <div class="giz-topbar-stat giz-topbar-stat--points">
                    <i class="ph-fill ph-coins giz-ph-icon" style="color:#e8b84b"></i>
                    <span>@UserBalanceViewState.PointsBalance</span>
                </div>
                <span class="giz-top-bar__divider"></span>
                <div class="giz-topbar-stat giz-topbar-stat--balance">
                    <span>@UserBalanceViewState.Balance.ToString("C", CultureInfo.CurrentCulture)</span>
                </div>
            </div>
            <div class="giz-top-bar__right-group">
                <div class="giz-top-bar__icons">
                    <UserActionsBar />
                </div>
                <DeploymentBanner />
                <div class="giz-top-bar__account">
                    <HeaderUserMenuUserLinks @onclick="UserMenuViewService.ToggleUserLinks" />
                </div>
            </div>
        </div>
        <div class="giz-container">
            <aside class="giz-left-panel">
                <Header />
                <div class="giz-left-panel__divider"></div>
                <div class="giz-left-panel__quicklaunch">
                    <QuickLauncher />
                </div>
            </aside>
            <div class="giz-app__body">
                @Body
            </div>
        </div>
    </div>

    <UserLock />
    <DialogHost />

    @if (System.Runtime.InteropServices.RuntimeInformation.IsOSPlatform(System.Runtime.InteropServices.OSPlatform.Create("browser")))
    {
        <div class="giz-web-notifications-host">
            <NotificationsHost />
        </div>
    }

    @if (HostOutOfOrderViewState.IsOutOfOrder)
    {
        <Layout_LoginOutOfOrder />
    }
    else
    {
        <Layout_LoginLock />
    }

    <GracePeriod />
    <UserBan />

    @* Renders nothing: reports whether anybody is looking at the shell. *@
    <ShellActivityWatcher />

</main>

@code {
    private bool _playTransition;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _playTransition = true;
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || _playTransition)
        {
            _playTransition = false;
            await JS.InvokeVoidAsync("eval", @"
                (function() {
                    var el = document.querySelector('.giz-app__body > *');
                    if (!el) return;
                    el.style.animation = 'none';
                    el.offsetWidth;
                    el.style.animation = '';
                })();
            ");
        }
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        this.UnsubscribeChange(UserBalanceViewState);
    }
}
