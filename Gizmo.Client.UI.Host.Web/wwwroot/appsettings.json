{
  "UIComposition": {
    "ApiEndpoint": "http://localhost",
    "RealTimeEndpoint": "http://localhost/rt",
    "AppAssembly": "Gizmo.Client.UI.dll",
    "AdditionalAssemblies": [ "Gizmo.Web.Components.dll" ],
    "RootComponentType": "Gizmo.Client.UI.App,Gizmo.Client.UI",
    "NotificationsComponentType": "Gizmo.Client.UI.Components.NotificationsHost,Gizmo.Client.UI"
  },

  "ClientInterface": {
    "DisableAppDetails": false,
    "DisableProductDetails": false,
    "HomePageMaxItemsPerRow": 8,
    "AppsPageMaxItemsPerRow": 8,
    "ProductsPageMaxItemsPerRow": 6,
    "QuickLaunchMaxItems": 16,
    "StyleSheet": "main.css"
  },
  "Logo": {},
  //https://learn.microsoft.com/en-us/dotnet/api/system.globalization.numberformatinfo?view=net-6.0
  "Currency": {
    "CurrencySymbol": "€",
    "CurrencyDecimalDigits": 2,
    "CurrencyDecimalSeparator": ".",
    "CurrencyGroupSeparator": ",",
    "CurrencyGroupSizes": [ 3 ],
    "CurrencyNegativePattern": 0,
    "CurrencyPositivePattern": 0
  },
  "Feeds": {
    "Disabled": false,
    "RotateEvery": 5
  },
  "HostQRCode": {
    "Enabled": true,
    "Title": null,
    "Description": null
  },
  "Reservations": {
    "EnableLoginBlock": false,
    "LoginBlockTime": 30,
    "EnableLoginUnblock": false,
    "LoginUnblockTime": 30
  },
  "LoginRotator": {
    "Enabled": false,
    "RotateEvery": 5
  },
  "PopularItems": {
    "MaxPopularProducts": 8,
    "MaxPopularApplications": 8
  },
  "UserLogin": {
    "Disabled": false
  },
  "UserOnlineDeposit": {
    "Disabled": false,
    "MaximumAmount": 1000.0
  },
  "Shop": {
    "Disabled": false
  },
  "Validation": {
    "Password": {
      "MaximumLength": 0,
      "LowerCaseCharactersRequired": true,
      "UpperCaseCharactersRequired": true,
      "NumbersRequired": true
    }
  },
  "Integration": {},
  "HostNumber": {
    "PrefixDisabled": false,
    "Prefix": "",
    "ShowOnWallpaper": true,
    "ShowOnRotator": true,
    "PositioningOnWallpaper": 5,
    "PositioningOnRotator": 9,
    "FixedPosition": 4,
    "TimeoutBetweenPosition": 2,
    "AnimationDuration": 2
  }
